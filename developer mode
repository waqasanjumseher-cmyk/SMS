document.getElementById('bm_saveBtn').addEventListener('click', ()=>{
  const title = document.getElementById('bm_title').value.trim();
  const subject = document.getElementById('bm_subject').value.trim();
  const totalMarks = Number(document.getElementById('bm_total').value || 0);
  if(!title || !subject || totalMarks<=0){ toast('Load the class roster first'); return; }

  let saved = 0, invalid = 0;
  document.querySelectorAll('.bmMark').forEach(input=>{
    input.classList.remove('invalid');
    const raw = input.value;
    if(raw===''){ return; } // blank = not attempted yet, skip rather than force a zero
    const obt = Number(raw);
    if(isNaN(obt) || obt<0 || obt>totalMarks){ invalid++; input.classList.add('invalid'); return; }
    upsertBulkMark(input.dataset.student, title, subject, obt, totalMarks);
    saved++;
  });

  if(invalid>0){ toast(`${invalid} mark(s) are invalid (must be 0–${totalMarks}) — fix and save again`); return; }
  if(saved===0){ toast('Enter at least one mark before saving'); return; }

  saveExams();
  renderExams();
  toast(`Saved marks for ${saved} student(s) — ${subject}, ${title}`);
});

