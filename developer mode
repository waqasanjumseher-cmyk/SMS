document.getElementById('bk_importFile').addEventListener('change', (e)=>{
  const file = e.target.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = async (ev)=>{
    let wb;
    try{
      wb = XLSX.read(new Uint8Array(ev.target.result), { type:'array' });
    }catch(err){
      toast('Could not read this file — make sure it is a valid .xlsx/.csv backup');
      e.target.value = '';
      return;
    }
    const result = parseBackupWorkbook(wb);
    if(!result.valid){
      toast('Invalid backup file — see details');
      alert('This backup could not be imported:\n\n' + result.error); // multi-line schema errors need more room than the toast strip
      e.target.value = '';
      return;
    }
    const summary = `${result.students.length} student(s), ${result.vouchers.length} fee record(s), `
      + `${result.expenses.length} expense(s), ${result.staff.length} staff record(s), `
      + `${result.payrollRuns.length} processed payroll payment(s) and ${result.appUsers.length} staff login(s)`;
    if(!confirm(`This backup contains ${summary}. Restoring will overwrite this school's current data — Phase 1 school/licensing configuration is untouched. Continue?`)){
      e.target.value = '';
      return;
    }

    students = result.students;
    vouchers = result.vouchers;
    expenses = result.expenses;
    staff = result.staff;
    payrollRuns = result.payrollRuns;
    if(result.appUsers.length) appUsers = result.appUsers;
    if(result.settings) settings = result.settings;

    await saveStudents(); await saveVouchers(); await saveExpenses(); await saveStaff(); await savePayrollRuns();
    await saveKey('erpUsers', appUsers);
    await saveSettings();

    applyBranding();
    renderAll();
    renderManageUsers();
    applyRBAC();
    toast('Database restored successfully from backup');
    e.target.value = '';
  };
  reader.onerror = ()=> toast('Could not read this file');
  reader.readAsArrayBuffer(file);
});

