<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Al-Noor School ERP</title>

<!-- ================= PWA / Offline Shell Metadata =================
     Single-file packaging: the manifest is embedded as a base64 data URI
     (no external manifest.json needed) so the whole app — icons included
     — still ships as one .html file. The service worker is generated the
     same way at runtime, see the registration script near the end of
     <body>. This gives installable "Add to Home Screen" / desktop PWA
     behavior and instant repeat-launch from cache without a second file
     on disk. ================================================== -->
<meta name="theme-color" content="#16324f">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="School ERP">
<meta name="description" content="Offline-ready school administration ERP — students, fees, exams, attendance, payroll and WhatsApp exports.">
<link id="pwaManifestLink" rel="manifest" href="">
<link id="pwaIconLink" rel="icon" href="">
<link id="pwaAppleIconLink" rel="apple-touch-icon" href="">
<script>
/* Built before anything else in <head> so the icon/manifest are wired up
   the instant the page starts parsing, and so PWA_ICON_SVG is available
   to the service-worker/manifest bootstrap script later in <body>. */
var PWA_ICON_SVG = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 192 192">'
  + '<rect width="192" height="192" rx="34" fill="#16324f"/>'
  + '<circle cx="96" cy="96" r="66" fill="#c98a2c"/>'
  + '<text x="96" y="112" font-family="Segoe UI, Arial, sans-serif" font-size="58" font-weight="800" fill="#0e2338" text-anchor="middle">SC</text>'
  + '</svg>';
(function(){
  var iconUrl = 'data:image/svg+xml;base64,' + btoa(PWA_ICON_SVG);
  document.getElementById('pwaIconLink').href = iconUrl;
  document.getElementById('pwaAppleIconLink').href = iconUrl;
  var manifest = {
    name: 'School ERP', short_name: 'School ERP',
    start_url: './', scope: './', display: 'standalone',
    background_color: '#f6f4ee', theme_color: '#16324f',
    icons: [
      { src: iconUrl, sizes: '192x192', type: 'image/svg+xml', purpose: 'any maskable' },
      { src: iconUrl, sizes: '512x512', type: 'image/svg+xml', purpose: 'any maskable' }
    ]
  };
  document.getElementById('pwaManifestLink').href =
    'data:application/manifest+json;base64,' + btoa(unescape(encodeURIComponent(JSON.stringify(manifest))));
})();

/* Apply any saved Hex-Code Customizer overrides (School Settings +
   Developer Console) before first paint, so a reload doesn't flash
   the default colours before snapping to the user's saved palette.
   Mirrors the variable list built later in the main app script. */
(function(){
  ['erp_custom_theme_school','erp_custom_theme_dev'].forEach(function(key){
    try{
      var store = JSON.parse(localStorage.getItem(key) || '{}');
      Object.keys(store).forEach(function(varName){
        document.documentElement.style.setProperty(varName, store[varName]);
      });
    }catch(e){ /* ignore malformed/absent saved palette */ }
  });
})();
</script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Nastaliq+Urdu:wght@400..700&display=swap" rel="stylesheet">
<!-- @page `size` can't be chosen with a CSS class/attribute selector, so
     the actual page geometry for A4 / A5 / Thermal is written into this
     tag at print time by setPrintFormat() further down the page. -->
<style id="dynamicPrintStyle">@page{size:A4;margin:12mm;}</style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
  :root{
    --ink:#1b2430;
    --navy:#16324f;
    --navy-2:#0e2338;
    --sidebar-bg:#0e2338;
    --teal:#1f7a6c;
    --teal-light:#e6f3f0;
    --gold:#c98a2c;
    --paper:#f6f4ee;
    --card:#ffffff;
    --line:#dcdfe3;
    --muted:#697180;
    --danger:#b5443a;
    --radius:10px;
    /* ---- Master Developer Dashboard palette (light by default) ----
       Kept separate from the school-facing --navy/--teal/--gold set
       above so the Developer Console can carry its own hex customizer
       without the two screens fighting over the same variables. */
    --dcc-bg:#f8fafc;
    --dcc-bg-alt:#eef2f7;
    --dcc-card:#ffffff;
    --dcc-border:#e2e8f0;
    --dcc-text:#0f172a;
    --dcc-text-dim:#475569;
    --dcc-text-muted:#64748b;
    --dcc-accent:#c98a2c;
    --dcc-hover:#0f5c52;
    font-family:'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, Helvetica, Arial, sans-serif;
  }
  *{box-sizing:border-box;}
  body{margin:0;background:var(--paper);color:var(--ink);}
  header.top{
    background:linear-gradient(120deg,var(--sidebar-bg),var(--navy));
    color:#f4f1ea;
    padding:14px 20px;
    display:flex;align-items:center;justify-content:space-between;gap:14px;
    box-shadow:0 2px 10px rgba(0,0,0,.15);
    position:sticky;top:0;z-index:500;
  }
  header.top .brand{display:flex;align-items:center;gap:12px;min-width:0;}
  header.top .crest{
    width:42px;height:42px;border-radius:50%;
    background:var(--gold);
    display:flex;align-items:center;justify-content:center;
    font-weight:700;color:var(--navy-2);font-size:18px;
    border:2px solid #f4f1ea55;flex-shrink:0;
  }
  header.top h1{font-size:19px;margin:0;font-weight:600;letter-spacing:.3px;}
  header.top .sub{font-size:12px;color:#cfd8e0;margin-top:2px;}
  header.top .session-badge{
    background:#ffffff17;border:1px solid #ffffff33;padding:6px 14px;border-radius:20px;font-size:13px;
  }

  /* ---- Hamburger (mobile-only sidebar trigger) ---- */
  .hamburger-btn{
    display:none;background:#ffffff17;border:1px solid #ffffff33;color:#f4f1ea;
    width:38px;height:38px;border-radius:8px;font-size:18px;cursor:pointer;flex-shrink:0;
    align-items:center;justify-content:center;
  }
  .hamburger-btn:hover{background:#ffffff2a;}

  /* ---- App shell: sidebar + main content ---- */
  .app-layout{display:flex;align-items:stretch;min-height:calc(100vh - 71px);}
  .sidebar{
    width:250px;flex-shrink:0;background:var(--sidebar-bg);color:#e7ecf1;
    padding:16px 0;position:sticky;top:71px;align-self:flex-start;
    height:calc(100vh - 71px);overflow-y:auto;
  }
  .sidebar-nav{display:flex;flex-direction:column;gap:2px;padding:0 10px;}
  .sidebar-nav .tab-btn{
    display:block;width:100%;text-align:left;background:transparent;border:none;
    color:#c9d2da;padding:12px 14px;font-size:13.5px;cursor:pointer;border-radius:8px;
    border-left:3px solid transparent;white-space:normal;font-weight:500;line-height:1.3;
  }
  .sidebar-nav .tab-btn:hover{color:#fff;background:#ffffff0d;}
  .sidebar-nav .tab-btn.active{color:#fff;border-left-color:var(--gold);background:#ffffff17;}
  .sidebar-backdrop{
    display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:499;
  }
  .sidebar-backdrop.show{display:block;}

  main{flex:1;min-width:0;max-width:1180px;margin:22px auto;padding:0 20px 60px;}
  .panel{display:none;}
  .panel.active{display:block;animation:fade .25s ease;}

  /* ---- Mobile: sidebar becomes an off-canvas drawer ---- */
  @media(max-width:900px){
    .hamburger-btn{display:flex;}
    header.top .brand .sub{display:none;}
    .sidebar{
      position:fixed;top:0;left:0;height:100vh;z-index:500;
      transform:translateX(-100%);transition:transform .25s ease;box-shadow:4px 0 24px rgba(0,0,0,.3);
    }
    .sidebar.open{transform:translateX(0);}
    main{margin:16px auto;padding:0 14px 50px;}
  }
  /* ---- Narrow phones: the header itself needs to shrink too, not
     just gain a hamburger — otherwise brand text and the session
     badge/user chip/logout cluster collide and overlap. ---- */
  @media(max-width:560px){
    header.top{flex-wrap:wrap;padding:12px 14px;row-gap:10px;}
    header.top h1{font-size:15.5px;}
    header.top .session-badge{display:none;}
    header.top .header-right{width:100%;justify-content:space-between;}
    header.top .user-chip{font-size:12px;}
  }
  @keyframes fade{from{opacity:0;transform:translateY(4px);}to{opacity:1;transform:translateY(0);}}
  .grid{display:grid;grid-template-columns:1fr 1fr;gap:22px;}
  @media(max-width:860px){.grid{grid-template-columns:1fr;}}
  .card{
    background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
    padding:20px 22px;box-shadow:0 1px 3px rgba(20,30,40,.05);
  }
  .card h2{margin:0 0 14px;font-size:16px;color:var(--navy-2);border-bottom:2px solid var(--teal-light);padding-bottom:10px;}
  .card h3{font-size:14px;color:var(--navy);margin:18px 0 8px;}
  label{display:block;font-size:12.5px;color:var(--muted);margin:10px 0 4px;font-weight:600;}
  input,select,textarea{
    width:100%;padding:9px 10px;border:1px solid var(--line);border-radius:6px;font-size:14px;background:#fcfcfa;color:var(--ink);
  }
  input:focus,select:focus,textarea:focus{outline:none;border-color:var(--teal);background:#fff;}
  .row{display:flex;gap:12px;}
  .row > div{flex:1;}
  .btn{
    display:inline-flex;align-items:center;gap:6px;
    background:var(--teal);color:#fff;border:none;padding:9px 16px;border-radius:6px;cursor:pointer;
    font-size:13.5px;font-weight:600;margin-top:14px;
  }
  .btn:hover{filter:brightness(.88);}
  .btn.secondary{background:var(--navy);}
  .btn.secondary:hover{background:var(--navy-2);filter:none;}
  .btn.gold{background:var(--gold);color:#2a1c00;}
  .btn.gold:hover{filter:brightness(.88);}
  .btn.whatsapp{background:#25D366;color:#04350f;}
  .btn.whatsapp:hover{background:#1ebe59;}
  .btn.ghost{background:transparent;color:var(--teal);border:1px solid var(--teal);}
  .btn.small{padding:5px 10px;font-size:12px;margin-top:0;}
  .btn.danger{background:var(--danger);}
  table{width:100%;border-collapse:collapse;margin-top:12px;font-size:13px;}
  th,td{text-align:left;padding:8px 9px;border-bottom:1px solid var(--line);}
  th{background:var(--teal-light);color:var(--navy-2);font-size:11.5px;text-transform:uppercase;letter-spacing:.4px;}
  tr:hover{background:#fafaf7;}
  .pill{padding:2px 9px;border-radius:20px;font-size:11px;font-weight:700;}
  .pill.paid{background:#e2f3e6;color:#217a3c;}
  .pill.due{background:#fbe7e5;color:var(--danger);}
  .muted{color:var(--muted);font-size:12.5px;}
  .toast{
    position:fixed;bottom:22px;right:22px;background:var(--navy-2);color:#fff;padding:12px 18px;border-radius:8px;
    font-size:13.5px;box-shadow:0 4px 16px rgba(0,0,0,.25);z-index:999;opacity:0;transform:translateY(10px);transition:.25s;
    max-width:320px;
  }
  .toast.show{opacity:1;transform:translateY(0);}
  .checkfee{display:flex;align-items:center;gap:8px;padding:7px 0;border-bottom:1px dashed var(--line);}
  .checkfee input[type=checkbox]{width:auto;}
  .checkfee input[type=number]{width:100px;}
  .checkfee span{flex:1;font-size:13.5px;}
  .total-line{display:flex;justify-content:space-between;padding:10px 0;font-size:15px;font-weight:700;border-top:2px solid var(--navy);margin-top:8px;}
  .modal-bg{
    display:none;position:fixed;inset:0;background:#0b1520cc;z-index:500;align-items:flex-start;justify-content:center;padding:30px 10px;overflow:auto;
  }
  .modal-bg.show{display:flex;}
  .modal-box{background:#fff;border-radius:10px;max-width:640px;width:100%;padding:0;overflow:hidden;}
  .modal-actions{padding:14px 20px;background:#f2f1eb;display:flex;gap:10px;flex-wrap:wrap;}
  .modal-actions button{margin-top:0;}
  .close-x{float:right;cursor:pointer;font-size:20px;color:var(--muted);}

  /* ---- Dashboard ---- */
  .metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;}
  @media(max-width:900px){.metrics{grid-template-columns:repeat(2,1fr);}}
  @media(max-width:520px){.metrics{grid-template-columns:1fr;}}
  .metric-card{
    background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
    padding:20px 20px 18px;box-shadow:0 1px 3px rgba(20,30,40,.05);border-top:4px solid var(--teal);
  }
  .metric-card.gold{border-top-color:var(--gold);}
  .metric-card.navy{border-top-color:var(--navy);}
  .metric-card.danger{border-top-color:var(--danger);}
  .metric-card .label{font-size:11.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;font-weight:700;}
  .metric-card .value{font-size:25px;font-weight:800;color:var(--navy-2);margin-top:10px;}

  /* ---- Searchable Combobox ---- */
  .combobox{position:relative;}
  .combo-list{
    display:none;position:absolute;top:100%;left:0;right:0;background:#fff;border:1px solid var(--line);
    border-radius:6px;max-height:230px;overflow-y:auto;z-index:60;box-shadow:0 8px 22px rgba(0,0,0,.14);margin-top:3px;
  }
  .combo-list.show{display:block;}
  .combo-item{padding:8px 10px;font-size:13.5px;cursor:pointer;border-bottom:1px solid var(--line);}
  .combo-item:last-child{border-bottom:none;}
  .combo-item:hover,.combo-item.hl{background:var(--teal-light);}
  .combo-item.empty{color:var(--muted);cursor:default;}
  .combo-item.empty:hover{background:transparent;}

  /* ---- Attendance ---- */
  .att-options{display:flex;gap:16px;flex-wrap:wrap;}
  .att-options label{display:flex;align-items:center;gap:5px;font-weight:500;color:var(--ink);margin:0;font-size:13px;}
  .att-options input{width:auto;}
  .att-badge{padding:2px 9px;border-radius:20px;font-size:11px;font-weight:700;}
  .att-badge.Present{background:#e2f3e6;color:#217a3c;}
  .att-badge.Absent{background:#fbe7e5;color:var(--danger);}
  .att-badge.Leave{background:#fbf1de;color:#9a6a14;}

  /* ---- Settings ---- */
  .settings-row{display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px dashed var(--line);}
  .settings-row .name{flex:1;font-size:13.5px;}
  .settings-row input[type=number]{width:120px;}

  /* ---- Printable Documents ---- */
  .doc{padding:26px 28px;font-family:'Segoe UI',Arial,sans-serif;color:#111;background:#fff;}
  .doc-head{display:flex;justify-content:space-between;align-items:center;border-bottom:3px solid var(--navy);padding-bottom:10px;margin-bottom:14px;}
  .doc-head .school{font-size:19px;font-weight:800;color:var(--navy-2);}
  .doc-head .school small{display:block;font-weight:400;font-size:11px;color:var(--muted);}
  .doc-head .doctitle{background:var(--gold);color:#2a1c00;padding:4px 12px;border-radius:5px;font-size:12px;font-weight:700;letter-spacing:.5px;}

  /* ID Card */
  .idcard{
    width:330px;border-radius:14px;overflow:hidden;border:1px solid var(--line);
    box-shadow:0 6px 18px rgba(0,0,0,.15);font-family:Arial,sans-serif;margin:auto;
  }
  .idcard .band{background:linear-gradient(120deg,var(--navy-2),var(--navy));color:#fff;padding:12px 14px;display:flex;align-items:center;gap:10px;}
  .idcard .band .crest{width:34px;height:34px;border-radius:50%;background:var(--gold);display:flex;align-items:center;justify-content:center;font-weight:800;color:var(--navy-2);}
  .idcard .band .name{font-size:13px;font-weight:700;line-height:1.2;}
  .idcard .band .name small{display:block;font-weight:400;font-size:10px;color:#cfd8e0;}
  .idcard .body{padding:16px 14px;display:flex;gap:14px;}
  .idcard .photo{width:78px;height:92px;border-radius:6px;background:#eef0ef;border:1px solid var(--line);display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:11px;flex-shrink:0;}
  .idcard .info div{font-size:12.5px;margin-bottom:5px;}
  .idcard .info b{color:var(--navy-2);}
  .idcard .foot{background:var(--teal-light);text-align:center;padding:7px;font-size:10.5px;color:var(--navy-2);letter-spacing:.4px;}

  /* ---- Phase 3: Modern Fee Voucher / Payment Receipt (restyled) ---- */
  .modern-voucher{
    max-width:560px;margin:auto;background:var(--card);border-radius:18px;overflow:hidden;
    border:1px solid var(--line);box-shadow:0 16px 44px rgba(15,35,55,.14);
    font-family:'Segoe UI',-apple-system,BlinkMacSystemFont,Arial,sans-serif;
    position:relative;isolation:isolate;
  }
  .mv-topbar{height:7px;background:linear-gradient(90deg,var(--navy-2) 0%,var(--teal) 55%,var(--gold) 100%);}
  .mv-watermark{
    position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
    pointer-events:none;z-index:0;overflow:hidden;
  }
  .mv-watermark span{
    font-size:82px;font-weight:900;letter-spacing:6px;text-transform:uppercase;
    color:var(--teal);opacity:.07;transform:rotate(-24deg);white-space:nowrap;
  }
  .mv-watermark.due span{color:var(--danger);}
  .mv-watermark.partial span{color:var(--gold);}

  .mv-header{
    display:flex;justify-content:space-between;align-items:flex-start;gap:14px;
    padding:22px 26px 16px;border-bottom:1px solid var(--line);position:relative;z-index:1;
  }
  .mv-brand{display:flex;gap:13px;align-items:center;}
  .mv-brand .crest{position:static;box-shadow:0 3px 10px rgba(0,0,0,.15);}
  .mv-school-name{font-size:17px;font-weight:800;color:var(--navy-2);letter-spacing:.3px;line-height:1.25;}
  .mv-school-sub{font-size:11px;color:var(--muted);margin-top:3px;max-width:260px;line-height:1.4;}
  .mv-doc-tag{text-align:right;flex-shrink:0;}
  .mv-doc-title{
    background:var(--navy-2);color:#fff;font-size:10.5px;font-weight:800;letter-spacing:.7px;
    padding:6px 14px;border-radius:20px;display:inline-block;white-space:nowrap;
    box-shadow:0 3px 8px rgba(0,0,0,.14);
  }
  .mv-doc-no{font-size:10px;color:var(--muted);margin-top:7px;letter-spacing:.2px;}
  .mv-doc-date{font-size:10px;color:var(--muted);margin-top:2px;}

  .mv-student-block{
    display:flex;gap:16px;align-items:flex-start;padding:20px 26px;position:relative;z-index:1;
  }
  .mv-photo{
    width:68px;height:82px;border-radius:9px;overflow:hidden;border:1px solid var(--line);
    background:var(--paper);flex-shrink:0;display:flex;align-items:center;justify-content:center;
    font-size:9.5px;color:var(--muted);text-align:center;box-shadow:0 2px 6px rgba(0,0,0,.06);
  }
  .mv-photo img{width:100%;height:100%;object-fit:cover;}
  .mv-student-name{font-size:15.5px;font-weight:800;color:var(--navy-2);margin-bottom:9px;letter-spacing:.1px;}
  .mv-meta-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px 22px;}
  .mv-meta-grid div{font-size:12px;color:var(--ink);display:flex;flex-direction:column;}
  .mv-meta-grid span{font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:2px;}
  .mv-meta-grid b{font-weight:700;}
  .mv-status-badge{
    position:absolute;top:20px;right:26px;padding:5px 14px;border-radius:20px;font-size:10px;font-weight:800;
    text-transform:uppercase;letter-spacing:.4px;box-shadow:0 2px 6px rgba(0,0,0,.08);
  }
  .mv-status-badge.paid{background:#e2f3e6;color:#217a3c;}
  .mv-status-badge.due{background:#fbe7e5;color:var(--danger);}
  .mv-status-badge.partial{background:#fbf1de;color:#9a6a14;}

  .mv-items-wrap{margin:2px 26px 0;position:relative;z-index:1;border:1px solid var(--line);border-radius:10px;overflow:hidden;}
  .mv-items-table{width:100%;border-collapse:collapse;}
  .mv-items-table thead th{
    background:var(--teal-light);color:var(--navy-2);font-size:9.5px;text-transform:uppercase;
    letter-spacing:.5px;padding:9px 12px;text-align:left;font-weight:800;
  }
  .mv-items-table th:last-child, .mv-items-table td:last-child{text-align:right;font-variant-numeric:tabular-nums;}
  .mv-items-table td{padding:9px 12px;font-size:12.5px;color:var(--ink);}
  .mv-items-table tbody tr:not(:last-child) td{border-bottom:1px solid var(--line);}
  .mv-items-table tbody tr:nth-child(even){background:color-mix(in srgb, var(--paper) 60%, transparent);}

  .mv-totals{margin:16px 26px 0;position:relative;z-index:1;background:var(--paper);border-radius:10px;padding:4px 16px;border:1px solid var(--line);}
  .mv-totals-row{display:flex;justify-content:space-between;font-size:12.5px;padding:8px 0;color:var(--muted);font-variant-numeric:tabular-nums;}
  .mv-totals-row:not(:last-child){border-bottom:1px dashed var(--line);}
  .mv-totals-row.mv-grand{
    border-top:none;margin-top:0;padding:11px 0;font-size:16.5px;font-weight:800;color:var(--navy-2);
  }
  .mv-words{font-size:10.5px;color:var(--muted);font-style:italic;margin:10px 26px 0;position:relative;z-index:1;}
