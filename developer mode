  /* ============================================================
     PRINT ENGINE — A4 / A5 / 80mm Thermal
     ------------------------------------------------------------
     #printArea carries a data-fmt attribute ("a4" | "a5" | "thermal")
     set by applyPrintFormat(). These sizing/layout rules are NOT
     scoped to @media print — they apply on screen too, so the modal
     preview (and the "Download as Image" capture, which snapshots the
     live DOM) match what actually comes out of the printer instead of
     surprising the user with a different layout at print time. The
     matching @page size/margins are injected separately into
     #dynamicPrintStyle by the same function, since @page's `size`
     cannot itself be selected by a class/attribute selector.
     ============================================================ */
  /* ---- A4 (default): full-width formal document ---- */
  #printArea[data-fmt="a4"]{width:100%;max-width:520px;margin:0 auto;}
  #printArea[data-fmt="a4"] .modern-voucher{max-width:100%;}

  /* ---- A5: same layout, scaled down so nothing overruns the
     smaller sheet — tighter type, tighter table padding. ---- */
  #printArea[data-fmt="a5"]{width:100%;max-width:400px;margin:0 auto;font-size:12px;}
  #printArea[data-fmt="a5"] .modern-voucher{max-width:100%;}
  #printArea[data-fmt="a5"] .mv-school-name{font-size:14px;}
  #printArea[data-fmt="a5"] .mv-items-table th,
  #printArea[data-fmt="a5"] .mv-items-table td{padding:5px 7px;font-size:10.5px;}
  /* Plain report/table documents (admission slip, payslip, defaulters
     list, paid-fees log, admission log) use .doc-head + a bare <table>
     rather than .modern-voucher — without this they kept full desktop
     font/padding and could overrun an A5 sheet on wide tables. */
  #printArea[data-fmt="a5"] .doc-head .school{font-size:15px;}
  #printArea[data-fmt="a5"] table th,
  #printArea[data-fmt="a5"] table td{padding:5px 7px;font-size:10.5px;}

  /* ---- 80mm Thermal receipt roll: single narrow column, no
     gradients/shadows/rounded corners (thermal heads render flat
     black only), tables collapse to a plain stacked list so nothing
     is sliced off the right edge of the 80mm head. ---- */
  #printArea[data-fmt="thermal"]{
    width:280px;max-width:280px;margin:0 auto;font-family:'Courier New',monospace;font-size:11px;color:#000;
  }
  #printArea[data-fmt="thermal"] .doc{padding:8px 6px;}
  #printArea[data-fmt="thermal"] .modern-voucher,
  #printArea[data-fmt="thermal"] .idcard{
    max-width:100%;box-shadow:none;border-radius:0;border:none;
  }
  #printArea[data-fmt="thermal"] .mv-topbar,
  #printArea[data-fmt="thermal"] .mv-watermark,
  #printArea[data-fmt="thermal"] .mv-status-badge{display:none;}
  #printArea[data-fmt="thermal"] .mv-header,
  #printArea[data-fmt="thermal"] .mv-student-block,
  #printArea[data-fmt="thermal"] .mv-totals,
  #printArea[data-fmt="thermal"] .doc-head{padding:6px 0;flex-direction:column;background:none;border-bottom:1px dashed #000;}
  #printArea[data-fmt="thermal"] .mv-photo{display:none;}
  #printArea[data-fmt="thermal"] .mv-doc-title{background:none;color:#000;border:1px solid #000;padding:2px 6px;}
  #printArea[data-fmt="thermal"] .mv-items-wrap{border:none;border-radius:0;margin:6px 0;}
  #printArea[data-fmt="thermal"] table, #printArea[data-fmt="thermal"] thead,
  #printArea[data-fmt="thermal"] tbody, #printArea[data-fmt="thermal"] tr,
  #printArea[data-fmt="thermal"] th, #printArea[data-fmt="thermal"] td{display:block;width:100%;text-align:left;background:none;}
  #printArea[data-fmt="thermal"] thead{display:none;}
  #printArea[data-fmt="thermal"] tr{border-bottom:1px dashed #000;padding:4px 0;}
  #printArea[data-fmt="thermal"] td{padding:1px 0;font-size:10.5px;}
  #printArea[data-fmt="thermal"] td:first-child{font-weight:700;}
  #printArea[data-fmt="thermal"] .mv-totals-row.mv-grand{font-size:13px;border-top:1px dashed #000;}

  @media print{
    body *{visibility:hidden;}
    #printArea, #printArea *{visibility:visible;}
    #printArea{position:absolute;top:0;left:0;width:100%;margin:0 auto;padding:0;}
    header.top,nav.tabs,.modal-actions,.close-x,.dev-float-banner,.login-overlay{display:none !important;}

    /* Never let a table row, totals block or voucher card split across
       a page break — this is the main cause of "clipped" printouts. */
    #printArea table, #printArea tr, #printArea .modern-voucher,
    #printArea .mv-totals, #printArea .idcard, #printArea .doc-head{
      page-break-inside:avoid;break-inside:avoid;
    }
    #printArea h3{page-break-after:avoid;break-after:avoid;}
    #printArea[data-fmt="a4"]{max-width:190mm;}
    #printArea[data-fmt="a5"]{max-width:138mm;}
    #printArea[data-fmt="thermal"]{max-width:72mm;width:72mm;}
  }

  /* ============================================================
     BULK FEE VOUCHER GENERATION — compact multi-up print layout
     ------------------------------------------------------------
     Deliberately its own lightweight card (NOT .modern-voucher) —
     no photos, gradients, watermark or shadows — so rendering
     500+ of them in one #printArea write stays cheap on memory and
     paint time. Cards are grouped into "sheet" divs of 2 or 3 (per
     bulkV_perPage) that each map 1:1 to a printed page, separated
     by a dashed cut line so a paper voucher can be scissor-cut from
     the next one on the same sheet. Screen-only, scoped under
     #printArea[data-fmt="bulk"] exactly like the a4/a5/thermal
     variants above, so nothing here touches those. ============= */
  #printArea[data-fmt="bulk"]{width:100%;max-width:100%;font-size:12px;}
  .bulk-voucher-sheet{
    display:grid;grid-template-rows:repeat(var(--bv-per-page,3),1fr);
    gap:0;page-break-after:always;break-after:page;
  }
  .bulk-voucher-sheet:last-child{page-break-after:auto;break-after:auto;}
  .bulk-voucher-card{
    border:1px solid #999;padding:10px 14px;position:relative;
    page-break-inside:avoid;break-inside:avoid;
  }
  .bulk-voucher-card + .bulk-voucher-card{border-top:1px dashed #666;}
  .bulk-voucher-card::before{
    content:"✂ cut here";font-size:8px;letter-spacing:.5px;color:#999;
    position:absolute;top:-7px;left:14px;background:#fff;padding:0 6px;
  }
  .bulk-voucher-card:first-child::before{content:none;}
  .bvc-head{display:flex;justify-content:space-between;align-items:flex-start;border-bottom:1px solid #333;padding-bottom:5px;margin-bottom:6px;}
  .bvc-school{font-weight:800;font-size:13px;}
  .bvc-school .sub{font-weight:400;font-size:9.5px;color:#555;}
  .bvc-doctitle{font-size:11px;font-weight:700;text-align:right;}
  .bvc-doctitle .no{font-weight:400;font-size:9px;color:#555;}
  .bvc-meta{display:grid;grid-template-columns:1fr 1fr;gap:1px 10px;font-size:10.5px;margin-bottom:6px;}
  .bvc-meta b{font-weight:600;}
  .bvc-items{width:100%;border-collapse:collapse;font-size:10.5px;margin-bottom:4px;}
  .bvc-items td{padding:1.5px 0;}
  .bvc-items td:last-child{text-align:right;}
  .bvc-totals{font-size:10.5px;border-top:1px solid #333;padding-top:3px;}
  .bvc-totals .row{display:flex;justify-content:space-between;}
  .bvc-totals .grand{font-weight:800;font-size:12px;}
  .bvc-status{font-size:9px;font-weight:700;padding:1px 6px;border:1px solid #333;border-radius:3px;}
  @media print{
    #printArea[data-fmt="bulk"]{max-width:190mm;}
  }

