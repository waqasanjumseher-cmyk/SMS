}

/* ============================================================
   AUTHENTICATION & ROLE-BASED ACCESS CONTROL
   ============================================================ */
async function initAuth(){
  await ensureStorageBackendDetected(); // resolve the race before any read/write happens
  schools = await loadGlobal('erp_schools', []);
  schools.forEach(ensureSchoolFeatures); // back-fill any newly-added feature keys on existing schools
  globalFeatureDefaults = await loadGlobal('erp_globalFeatureDefaults', {});
  const session = await loadGlobal('erp_session', null);

  if(session && session.mode === 'developer'){
    await startSession(MASTER_USER, null);
    // startSession() only restores the bare Developer Panel — if the
    // Developer had a specific school open (via openSchoolSettingsAsDev),
    // that choice was persisted separately as editingSchoolId. Re-enter
    // it now so a refresh doesn't strand the Developer on an empty panel
    // while their data sits, un-reloaded, in that school's scoped keys.
    if(session.editingSchoolId && schools.find(s=>s.id===session.editingSchoolId)){
      await openSchoolSettingsAsDev(session.editingSchoolId);
    }
    return;
  }
  if(session && session.mode === 'school' && session.schoolId){
    const school = schools.find(s=>s.id===session.schoolId);
    if(school){
      currentSchoolId = school.id;
      if(session.userId === 'owner'){
        await startSession(ownerAsUser(school), school);
        return;
      }
      appUsers = await loadKey('erpUsers', []);
      const u = appUsers.find(u=>u.id===session.userId);
      if(u){ await startSession(u, school); return; }
    }
    currentSchoolId = null;
  }
  showLogin();
}

function ownerAsUser(school){
  return { id:'owner', username:school.ownerUsername, name:school.name + ' — Super Admin', role:'Super Admin' };
}

