/* Approval: finalizes the sheet, locks in the attendance figure used, posts
   the net salary into General Expenses under "Staff Salaries" — this is the
   single instant it touches Operating Expenses / P&L / Dashboard. */
document.getElementById('payrollApproveBtn').addEventListener('click', ()=>{
  const m = staff.find(x=>x.id===payrollModalStaffId);
  if(!m) return;
  const month = payrollModalMonth;
  if(findPayrollRun(m.id, month)){ toast('Already paid for '+monthLabel(month)); closePayrollModal(); renderPayrollProcessing(); return; }

  const basic = Number(document.getElementById('pm_basic').value||0);
  const allowances = Number(document.getElementById('pm_allowances').value||0);
  const allowedLeaves = Number(document.getElementById('pm_allowedLeaves').value||0);
  const absentDays = Number(document.getElementById('pm_absentDays').value||0);
  const { excess, rate, deduction } = computeLeaveDeduction(basic, allowedLeaves, absentDays);
  const penalties = payrollModalPenalties
    .map(p=>({ description: (p.description||'').trim() || 'Manual penalty', amount: Number(p.amount||0) }))
    .filter(p=>p.amount>0);
  const penaltiesTotal = penalties.reduce((a,p)=>a+p.amount,0);
  const gross = basic + allowances;
  const net = gross - deduction - penaltiesTotal;

  if(net<=0){ toast('Net payable must be greater than zero — review the deductions'); return; }
  if(!confirm(`Approve and post ${money(net)} net salary for ${escapeHtml(m.name)} (${monthLabel(month)}) to Expenses?`)) return;

  setAbsentDays(m.id, month, absentDays); // lock in the attendance figure this sheet was approved against

  const expenseEntry = {
    id: uid('EXP'), date: month+'-01', category: 'Staff Salaries',
    title: `Salary — ${m.name} (${m.designation}) — ${monthLabel(month)}`,
    amount: net, payrollStaffId: m.id, payrollMonth: month
  };
  expenses.push(expenseEntry);

  payrollRuns.push({
    id: uid('PR'), staffId: m.id, month, basic, allowances,
    allowedLeaves, absentDays, excessAbsences: excess, perDayRate: rate, leaveDeduction: deduction,
    penalties, penaltiesTotal, gross, net,
    expenseId: expenseEntry.id, paidOn: new Date().toISOString().slice(0,10)
  });

  saveExpenses();
  savePayrollRuns();
  closePayrollModal();
  renderPayrollProcessing();
  renderExpenses();
  renderPL();
  renderDashboard();
  toast('Salary sheet approved & posted for '+m.name);
  showPayslip(m.id, month);
});

