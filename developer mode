});

document.getElementById('att_saveBtn').addEventListener('click', ()=>{
  if(!currentAttClass || !currentAttDate){ toast('Load a class and date first'); return; }
  const roster = students.filter(s=>s.class===currentAttClass && isActiveStudent(s));
  const records = roster.map(s=>{
    const checked = document.querySelector(`input[name="att_${s.id}"]:checked`);
    return { studentId: s.id, status: checked ? checked.value : 'Present' };
  });

  const idx = attendance.findIndex(a=>a.class===currentAttClass && a.date===currentAttDate);
  const entry = { id: idx>=0 ? attendance[idx].id : uid('ATT'), class: currentAttClass, date: currentAttDate, records };
  if(idx>=0) attendance[idx] = entry; else attendance.push(entry);

  saveAttendance();
  toast('Attendance saved');
  renderAttendanceSummary(currentAttClass, currentAttDate, entry);
});

function toggleAlertBtn(studentId){
  const checked = document.querySelector(`input[name="att_${studentId}"]:checked`);
  const btn = document.getElementById(`alertBtn_${studentId}`);
  if(btn) btn.style.display = (checked && checked.value==='Absent') ? 'inline-flex' : 'none';
}

function sendAbsentAlert(studentId){
  const s = students.find(x=>x.id===studentId);
  if(!s){ toast('Student not found'); return; }
  if(!s.phone){ toast('No WhatsApp number on file for this student'); return; }
  const message = `Dear Guardian, your child ${escapeHtml(s.name)} is Absent from school today. Please contact the administration.`;
  const text = encodeURIComponent(message);
  window.open(`https://wa.me/${escapeHtml(s.phone)}?text=${text}`, '_blank');
  toast(`Absentee alert opened for ${escapeHtml(s.name)}`);
}

function sendAllAbsentAlerts(cls, date){
  const entry = attendance.find(a=>a.class===cls && a.date===date);
  if(!entry){ toast('Save attendance first'); return; }
  const absentees = entry.records.filter(r=>r.status==='Absent').map(r=>students.find(s=>s.id===r.studentId)).filter(Boolean);
  if(absentees.length===0){ toast('No absentees to alert'); return; }
  let i = 0;
  function openNext(){
    if(i >= absentees.length) return;
    const s = absentees[i];
    i++;
    if(s.phone){
      const message = `Dear Guardian, your child ${escapeHtml(s.name)} is Absent from school today. Please contact the administration.`;
      window.open(`https://wa.me/${escapeHtml(s.phone)}?text=${encodeURIComponent(message)}`, '_blank');
    }
    setTimeout(openNext, 600);
  }
  toast(`Opening WhatsApp alerts for ${absentees.length} absentee(s)... allow pop-ups if prompted`);
  openNext();
}

function renderAttendanceSummary(cls, date, entry){
  const box = document.getElementById('att_summary');
  if(!entry){
    box.innerHTML = `<div class="muted">No attendance saved yet for ${cls} on ${date}.</div>`;
    return;
  }
  const present = entry.records.filter(r=>r.status==='Present').length;
  const absent = entry.records.filter(r=>r.status==='Absent').length;
  const leave = entry.records.filter(r=>r.status==='Leave').length;
  const absentees = entry.records.filter(r=>r.status==='Absent').map(r=>students.find(s=>s.id===r.studentId)).filter(Boolean);

  box.innerHTML = `
    <div class="muted" style="margin-bottom:8px;">${cls} — ${date}</div>
    <div class="total-line" style="border-top:none;font-size:13px;"><span><span class="att-badge Present">Present</span></span><span>${present}</span></div>
    <div class="total-line" style="border-top:none;font-size:13px;"><span><span class="att-badge Absent">Absent</span></span><span>${absent}</span></div>
    <div class="total-line" style="font-size:13px;"><span><span class="att-badge Leave">Leave</span></span><span>${leave}</span></div>
    ${absentees.length ? `
      <h3>Absentees Today</h3>
      <div class="absentee-list">
        ${absentees.map(s=>`
          <div class="absentee-row">
            <span class="absentee-name">${escapeHtml(s.name)} <span class="muted">(${escapeHtml(s.roll)})</span></span>
            <button class="btn small whatsapp" onclick="sendAbsentAlert('${s.id}')">💬 Alert</button>
          </div>`).join('')}
      </div>
      <button class="btn secondary small" style="margin-top:10px;" onclick="sendAllAbsentAlerts('${cls}','${date}')">💬 Send Alerts to All Absentees</button>
    ` : ''}
  `;
}

