document.getElementById('dev_schoolPackage').addEventListener('change', (e) => {
  const preset = PACKAGES[e.target.value];
  if(preset) renderNewSchoolModuleBox(preset); // Custom leaves current checks untouched
});

document.getElementById('devCreateSchoolBtn').addEventListener('click', async ()=>{
  const name = document.getElementById('dev_schoolName').value.trim();
  const ownerUsername = document.getElementById('dev_ownerUsername').value.trim();
  const ownerPassword = document.getElementById('dev_ownerPassword').value;
  const ownerEmail = document.getElementById('dev_ownerEmail').value.trim().toLowerCase();
  const pkg = document.getElementById('dev_schoolPackage').value; // Phase 1
  if(!name || !ownerUsername || !ownerPassword){ toast('Fill in all fields to provision a school'); return; }
  const taken = ownerUsername.toLowerCase()===MASTER_USERNAME.toLowerCase()
    || schools.some(s=>s.ownerUsername.toLowerCase()===ownerUsername.toLowerCase());
  if(taken){ toast('That Super Admin username is already taken'); return; }
  if(ownerEmail && schools.some(s=>(s.ownerEmail||'').toLowerCase()===ownerEmail)){
    toast('That Google account email is already linked to another school'); return;
  }

  // Phase 1: read module checkboxes as entered/auto-filled by the package preset
  const moduleFlags = {};
  document.querySelectorAll('.dev-new-module').forEach(cb => {
    moduleFlags[cb.dataset.module] = cb.checked;
  });

  const newSchool = {
    id: uid('sch_'),
    name, ownerUsername, ownerPassword, ownerEmail,
    features: effectiveGlobalFeatureDefaults(),
    package: pkg,               // Phase 1
    moduleFlags,                 // Phase 1
    upgradeRequests: [],         // Phase 3
    createdAt: new Date().toISOString()
  };
  schools.push(newSchool);
  await saveGlobal('erp_schools', schools);
  await saveSchoolModuleConfigToFirestore(newSchool); // Phase 1

  document.getElementById('dev_schoolName').value = '';
  document.getElementById('dev_ownerUsername').value = '';
  document.getElementById('dev_ownerPassword').value = '';
  document.getElementById('dev_ownerEmail').value = '';
  document.getElementById('dev_schoolPackage').value = 'Basic'; // Phase 1
  renderNewSchoolModuleBox(); // Phase 1 — reset checkboxes to Basic (all off)
  renderDevControl();
  toast('School provisioned — Super Admin can now log in');
});

async function deleteSchool(id){
  const school = schools.find(s=>s.id===id);
  if(!school) return;
  if(!confirm(`Delete "${escapeHtml(school.name)}"? This permanently removes the school and ALL of its data. This cannot be undone.`)) return;

  const dataKeys = ['students','vouchers','examRecords','staff','expenses','payrollRuns','staffAttendance','attendance','settings','erpUsers'];
  for(const k of dataKeys){
    await lsRemove(`sch_${id}_${k}`); // goes through the same window.storage/localStorage engine as everything else
  }
  schools = schools.filter(s=>s.id!==id);
  await saveGlobal('erp_schools', schools);
  renderDevControl();
  toast('School deleted');
}

