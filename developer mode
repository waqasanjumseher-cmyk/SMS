function initCombobox(inputId, hiddenId, listId, getItems, onSelect){
  const input = document.getElementById(inputId);
  const hidden = document.getElementById(hiddenId);
  const list = document.getElementById(listId);

  function renderList(filter){
    const f = (filter||'').toLowerCase().trim();
    const items = getItems().filter(it => it.label.toLowerCase().includes(f)).slice(0,60);
    if(items.length===0){
      list.innerHTML = `<div class="combo-item empty">No matching students</div>`;
    }else{
      list.innerHTML = items.map(it=>`<div class="combo-item" data-id="${it.id}">${escapeHtml(it.label)}</div>`).join('');
    }
    list.classList.add('show');
  }

  input.addEventListener('focus', ()=>renderList(input.value));
  input.addEventListener('input', ()=>{
    hidden.value = '';
    onSelect(null);
    renderList(input.value);
  });
  list.addEventListener('mousedown', e=>{
    const item = e.target.closest('.combo-item');
    if(!item || !item.dataset.id) return;
    hidden.value = item.dataset.id;
    input.value = item.textContent;
    list.classList.remove('show');
    onSelect(item.dataset.id);
  });
  document.addEventListener('click', e=>{
    if(e.target===input || list.contains(e.target)) return;
    list.classList.remove('show');
  });

  return { clear(){ input.value=''; hidden.value=''; list.classList.remove('show'); } };
}

