    </div>

    <div class="card" style="margin-bottom:14px;">
      <h3 style="margin:0 0 8px;font-size:14px;color:var(--navy-2);">📡 Heartbeat</h3>
      ${telemetry ? `
        <div class="dcc-card-stats" style="margin-bottom:0;">
          <div><div class="n" style="font-size:13px;">${telemetry.lastActiveAt ? new Date(telemetry.lastActiveAt.toDate ? telemetry.lastActiveAt.toDate() : telemetry.lastActiveAt).toLocaleString() : '—'}</div><div class="l">Last Online</div></div>
