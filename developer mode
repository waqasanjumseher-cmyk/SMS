function renderReminders(filter=''){
  const tbody = document.getElementById('reminderTable');
  if(!tbody) return;
  const f = filter.toLowerCase();

  const byStudent = {};
  vouchers.filter(v=>Number(v.balance||0) > 0).forEach(v=>{
    if(!byStudent[v.studentId]) byStudent[v.studentId] = [];
    byStudent[v.studentId].push(v);
  });

  const rows = Object.keys(byStudent).map(studentId=>{
    const s = students.find(x=>x.id===studentId);
    if(!s) return null;
    const dues = byStudent[studentId];
    const totalDue = dues.reduce((a,v)=>a+Number(v.balance||0),0);
    return { student: s, dues, totalDue };
  }).filter(Boolean)
    .filter(r => r.student.name.toLowerCase().includes(f) || r.student.roll.toLowerCase().includes(f) || r.student.class.toLowerCase().includes(f))
    .sort((a,b)=>b.totalDue-a.totalDue);

  tbody.innerHTML = rows.map(r=>`
    <tr>
      <td>${escapeHtml(r.student.name)}<br><span class="muted">${escapeHtml(r.student.roll)}</span></td>
      <td>${escapeHtml(r.student.class)}</td>
      <td>${r.dues.length}</td>
      <td>${money(r.totalDue)}</td>
      <td><button class="btn small whatsapp" onclick="sendFeeReminder('${r.student.id}')">💬 Remind</button></td>
    </tr>`).join('') || `<tr><td colspan="5" class="muted">No pending balances — everyone is up to date.</td></tr>`;
}
