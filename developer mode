   ============================================================ */
function fillClassSelect(sel, keepValue){
  const prev = keepValue ? sel.value : '';
  sel.innerHTML = '<option value="">Select class</option>' +
    settings.classes.map(c=>`<option value="${c}">${c}</option>`).join('');
  if(prev && settings.classes.includes(prev)) sel.value = prev;
}
/* ---- Phase 3A: Section dropdown, dependent on the selected class ---- */
function fillSectionSelect(sel, className, keepValue){
  if(!sel) return;
  const prev = keepValue ? sel.value : '';
  const sections = (settings.classSections && settings.classSections[className]) || [];
  sel.innerHTML = '<option value="">— None —</option>' +
    sections.map(sec=>`<option value="${sec}">${sec}</option>`).join('');
  if(prev && sections.includes(prev)) sel.value = prev;
}
