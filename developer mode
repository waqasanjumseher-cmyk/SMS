  // false-by-omission, mirrors the ensureSchoolFeatures() pattern above.
  if(typeof settings.enableBulkVoucherGeneration !== 'boolean') settings.enableBulkVoucherGeneration = true;
  document.documentElement.setAttribute('data-theme', settings.theme);
  applyBranding();
  renderAll();
  startLiveSync(currentSchoolId);
}

/* ---- BULLETPROOF STORAGE ENGINE -----------------------------------------
   THE ACTUAL ROOT CAUSE OF THE "DATA WIPES ON REFRESH" BUG:
   This file is viewed inside Claude's file preview / artifact sandbox,
   where browser storage (localStorage/sessionStorage) is explicitly NOT
   persisted across reloads — each reload can get a fresh, isolated
   storage partition, so every .setItem() "succeeds" but is gone by the
   next load. That sandbox instead exposes a dedicated persistence API,
   window.storage (.get/.set/.delete — all async), which IS durable
   across reloads there.

   A previous pass swapped everything to plain localStorage on the
   theory that window.storage "only exists in the sandbox" — true, but
   backwards: inside the sandbox it's the one API that actually
   persists, while localStorage is the one that silently resets. So
   that "fix" produced exactly the symptom being fixed now.

   The correct behavior covers BOTH places this file gets opened:
     - Inside Claude (this chat, a shared artifact, etc.) → window.storage
       is present and used — data survives refresh.
     - Downloaded and opened directly in a normal browser (double-clicked,
       or served from a real web/file origin) → window.storage is
       undefined, so this engine transparently falls back to
       localStorage, which persists normally there.
   Every call site below (loadKey/saveKey/loadGlobal/saveGlobal) is
   unchanged — only the engine underneath picks the right backend.

   Every business-data key (students, vouchers, settings, erpUsers, ...) is
   namespaced per school via scopedKey(), so two schools can never see or
   overwrite each other's records — even though every render/save function
   further down the file still just calls loadKey('students', ...) etc.
   Only the Developer's cross-tenant registry (schools[], session pointer)
   bypasses scoping and uses loadGlobal/saveGlobal below.

   ---- THE ACTUAL "WIPES ON REFRESH" BUG (root cause #2) --------------
   The detection above (`window.storage` present?) was being taken as a
   ONE-SHOT decision, read from a top-level `const` the instant this
   <script> tag started executing. In the sandbox that host page injects
   window.storage via its own bridge script/handshake, which does not
   always finish before THIS inline script begins running — so on some
   loads the check fired a few milliseconds too early, saw `undefined`,
   locked in `hasArtifactStorage = false` for the rest of the page's
   life, and every save silently went to localStorage instead — which
   is exactly the storage that gets reset in that host. Refresh, and
   the same race can resolve differently, making it look intermittent.
   Fix: give the bridge a generous grace period to attach (polled
   below, in fast 25ms steps, 3s max) and only THEN decide, once,
   before initAuth() ever reads or writes anything. Never re-decide
   mid-session — flapping between backends part-way through would
   itself look like data loss.
   NOTE: this window was previously shortened to 1s to cut down the
   "Restoring your session…" flash — that was wrong. The real bridge's
   attach time isn't reliably sub-second, so 1s could time out BEFORE
   it attached, silently choose localStorage for that load, and then
   choose window.storage again on the next load once timing worked out
   differently — two different storage namespaces, each missing what
   the other just wrote, which looks exactly like data vanishing on
   refresh. A slower spinner is a far smaller cost than that, so this
   is back to a wide 3s margin for the case where it's actually
   plausible window.storage will show up.
   That "3s margin" only applies when this page is running embedded
   inside a host capable of injecting window.storage in the first
   place (an iframe). The far more common real-world deployment of
   this file is standalone — self-hosted, or just opened from disk —
   where window.storage will NEVER exist, and a blind fixed timeout
   would stall the login screen for a full 3 seconds on every single
   load for no reason. isEmbeddedContext() lets a standalone load
   skip the wait entirely and go straight to the localStorage
   fallback, while an embedded load still gets the full grace period. */
function detectArtifactStorage(){
  return (typeof window !== 'undefined' && window.storage
    && typeof window.storage.get === 'function' && typeof window.storage.set === 'function');
}
function isEmbeddedContext(){
  try{ return window.self !== window.top; }
  catch(e){ return true; } // cross-origin access blocked => definitely embedded
}
let hasArtifactStorage = detectArtifactStorage();
async function ensureStorageBackendDetected(){
  if(hasArtifactStorage) return; // already confirmed present at parse time — nothing to wait for
  if(!isEmbeddedContext()) return; // standalone page — no host to ever inject window.storage, nothing to wait for
  for(let i=0;i<120;i++){
    await new Promise(r=>setTimeout(r,25));
    if(detectArtifactStorage()){ hasArtifactStorage = true; return; }
  }
  // Still absent after ~3s inside an embedded host: fall back to
  // localStorage — better than an indefinite stall.
}
/* ---- Master Developer Password Hashing -------------------------------
   SHA-256 via the browser's built-in SubtleCrypto — no external lib.
   loadGlobal/saveGlobal (not scoped to any school) hold the hash,
   mirroring how erp_schools itself is stored. Until the Developer
   saves a new password for the first time, erp_masterPasswordHash is
   absent and login falls back to the plain-text MASTER_PASSWORD
   constant — same behavior as before this feature existed. */
async function sha256Hex(text){
  const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
  return Array.from(new Uint8Array(buf)).map(b=>b.toString(16).padStart(2,'0')).join('');
}

/* ---- Staff Password Hashing v2: PBKDF2 (salted + iterated) -----------
   A bare SHA-256 hash is fast to brute-force on modern hardware (GPUs
   do billions/sec). PBKDF2 deliberately slows that down and adds a
   per-user random salt so two staff with the same password don't get
   the same stored value, and pre-computed "rainbow table" attacks don't
   work at all. Stored format is a single string so it still fits the
   existing `password` field with zero schema changes:

     pbkdf2$<iterations>$<saltHex>$<hashHex>

   150,000 iterations is a reasonable 2025-era default for SHA-256-based
   PBKDF2 (OWASP's current floor). Everything runs via the browser's
   built-in SubtleCrypto — no external crypto library needed. ---------- */
const PBKDF2_ITERATIONS = 150000;

function randomSaltHex(bytes = 16){
  const arr = new Uint8Array(bytes);
  crypto.getRandomValues(arr);
  return Array.from(arr).map(b => b.toString(16).padStart(2, '0')).join('');
}

function hexToBytes(hex){
  const out = new Uint8Array(hex.length / 2);
  for(let i = 0; i < out.length; i++) out[i] = parseInt(hex.substr(i*2, 2), 16);
  return out;
}

async function pbkdf2DeriveHex(password, saltHex, iterations){
  const keyMaterial = await crypto.subtle.importKey(
    'raw', new TextEncoder().encode(password), 'PBKDF2', false, ['deriveBits']
  );
  const bits = await crypto.subtle.deriveBits(
    { name: 'PBKDF2', salt: hexToBytes(saltHex), iterations, hash: 'SHA-256' },
    keyMaterial, 256 // 32 bytes, matches SHA-256's output size
  );
  return Array.from(new Uint8Array(bits)).map(b => b.toString(16).padStart(2, '0')).join('');
}

/* Use this everywhere a staff password is CREATED or RESET (addUserBtn,
   pwResetConfirmBtn). Returns the full "pbkdf2$iter$salt$hash" string —
   store it directly in the user's `password` field. */
async function hashStaffPassword(password){
  const saltHex = randomSaltHex();
  const hashHex = await pbkdf2DeriveHex(password, saltHex, PBKDF2_ITERATIONS);
  return `pbkdf2$${PBKDF2_ITERATIONS}$${saltHex}$${hashHex}`;
}

/* Use this to check a typed password against whatever is on file.
   Understands three formats so nobody gets locked out mid-upgrade:
     1. "pbkdf2$iter$salt$hash" — current format, checked directly.
     2. 64 hex chars           — legacy plain SHA-256 (sha256Hex output).
     3. anything else          — legacy plain-text (pre-hashing accounts).
   Returns { valid, needsUpgrade } — the caller re-saves the user with a
   fresh PBKDF2 hash whenever needsUpgrade is true, so every successful
   login silently migrates that account forward one step. */
async function verifyStaffPassword(password, stored){
  if(!stored) return { valid: false, needsUpgrade: false };

  if(stored.startsWith('pbkdf2$')){
    const [, iterStr, saltHex, hashHex] = stored.split('$');
    const iterations = parseInt(iterStr, 10);
    const computed = await pbkdf2DeriveHex(password, saltHex, iterations);
    return { valid: computed === hashHex, needsUpgrade: false };
  }

  if(/^[0-9a-f]{64}$/i.test(stored)){ // legacy SHA-256 hex
    const computed = await sha256Hex(password);
    return { valid: computed === stored, needsUpgrade: computed === stored };
  }

  // legacy plain-text password on file
  return { valid: password === stored, needsUpgrade: password === stored };
}

async function verifyMasterPassword(password){
  const storedHash = await loadGlobal('erp_masterPasswordHash', null);
  if(storedHash) return (await sha256Hex(password)) === storedHash;
  return (await sha256Hex(password)) === MASTER_PASSWORD_HASH_FALLBACK; // one-time fallback; plaintext password is no longer embedded
}

function scopedKey(key){
  return currentSchoolId ? `sch_${currentSchoolId}_${key}` : key;
}
/* Same scoping scheme as scopedKey(), but for an ARBITRARY school id —
   used by the Developer Dashboard's Quick Overview to read a snapshot
   of a school's data (e.g. active student count) without actually
   "opening" that school (i.e. without touching currentSchoolId/loadAll()). */
function scopedKeyFor(schoolId, key){
  return schoolId ? `sch_${schoolId}_${key}` : key;
}
/* Strict-check read: existing data always wins. A missing key, a parse
   error, or storage being blocked all fall back to whatever the caller
   already has in memory (or [] on a genuine first run) — never silently
   to something worse. Always async now (window.storage is promise-based),
   so every call site awaits it — see loadKey/saveKey/loadGlobal/saveGlobal. */
/* Small retry helper: window.storage occasionally returns a transient
   "Internal server error" from the sandbox bridge itself (not a data
   problem — the value on disk is untouched). Retrying a couple of times
   with a short backoff absorbs that blip; only a read/write that fails
   on every attempt falls through to the caller's fallback/error path.
   This matters most for keys like erp_schools/erp_session, where a
   single failed read otherwise falls back to [] / null and LOOKS like
   data loss even though nothing was actually lost in storage. */
async function withStorageRetry(fn, attempts = 3){
  let lastErr;
  for(let i=0;i<attempts;i++){
    try{ return await fn(); }
    catch(e){
      lastErr = e;
      if(i < attempts-1) await new Promise(r=>setTimeout(r, 150 * (i+1)));
    }
  }
  throw lastErr;
}
async function lsRead(fullKey, fallback){
  try{
    if(hasArtifactStorage){
      const res = await withStorageRetry(()=>window.storage.get(fullKey, false));
      return res ? JSON.parse(res.value) : fallback;
    }
    const raw = localStorage.getItem(fullKey);
    if(raw === null || raw === undefined) return fallback;
    return JSON.parse(raw);
  }catch(e){
    console.error('storage read failed for "'+fullKey+'" after retries:', e);
    return fallback;
  }
}
async function lsWrite(fullKey, value){
  try{
    if(hasArtifactStorage){
      const res = await withStorageRetry(()=>window.storage.set(fullKey, JSON.stringify(value), false));
      if(res) mirrorToFirebase(fullKey, value); // fire-and-forget; never blocks or affects this return value
      return !!res;
    }
    localStorage.setItem(fullKey, JSON.stringify(value));
    mirrorToFirebase(fullKey, value); // fire-and-forget; never blocks or affects this return value
    return true;
  }catch(e){
    console.error('storage write failed for "'+fullKey+'" after retries:', e);
    if(typeof toast === 'function') toast('⚠ Could not save — device storage may be full or blocked');
    return false;
  }
}
async function lsWriteLocalOnly(fullKey, value){
  try{
    if(hasArtifactStorage){
      await withStorageRetry(()=>window.storage.set(fullKey, JSON.stringify(value), false));
    } else {
      localStorage.setItem(fullKey, JSON.stringify(value));
    }
  }catch(e){
    console.error('local-only storage write failed for "'+fullKey+'":', e);
  }
}
async function lsRemove(fullKey){
  try{
    if(hasArtifactStorage){
      await window.storage.delete(fullKey, false);
    } else {
      localStorage.removeItem(fullKey);
    }
    mirrorDeleteToFirebase(fullKey); // fire-and-forget
    return true;
  }catch(e){
    console.error('storage delete failed for "'+fullKey+'":', e);
    return false;
  }
}

/* ============================================================
   CLOUD CONSOLE INTEGRATION (Firebase Sync + Google Drive Backup)
   ------------------------------------------------------------
   Entirely separate from the app's own local persistence engine
   above — this is additive/best-effort only. Local storage
   (window.storage or localStorage, per hasArtifactStorage) always
   stays the source of truth; nothing here can block a save or
   replace it. Credentials + on/off state live in real browser
   localStorage (not the scoped app engine) under CLOUD_CONFIG_KEY,
   since they're developer-machine settings, not per-school data.
   ============================================================ */
const CLOUD_CONFIG_KEY = 'erp_cloudConfig';

function defaultCloudConfig(){
  return {
    firebaseEnabled: false,
    firebase: { apiKey:'', authDomain:'', projectId:'', storageBucket:'', messagingSenderId:'', appId:'' },
    driveEnabled: false,
    drive: { apiKey:'', clientId:'' }
  };
}
function loadCloudConfig(){
  try{
    const raw = localStorage.getItem(CLOUD_CONFIG_KEY);
    if(!raw) return defaultCloudConfig();
    const parsed = JSON.parse(raw);
    // merge over defaults so a config saved before a new field existed
    // doesn't leave that field undefined
    const d = defaultCloudConfig();
    return {
      firebaseEnabled: !!parsed.firebaseEnabled,
      firebase: Object.assign({}, d.firebase, parsed.firebase),
      driveEnabled: !!parsed.driveEnabled,
      drive: Object.assign({}, d.drive, parsed.drive)
    };
  }catch(e){
    console.error('Failed to parse cloud config, using defaults:', e);
    return defaultCloudConfig();
  }
}
function saveCloudConfigToStorage(cfg){
  localStorage.setItem(CLOUD_CONFIG_KEY, JSON.stringify(cfg));
}
let cloudConfig = loadCloudConfig();

/* Loads an external <script> exactly once, resolving immediately on
   repeat calls if it's already on the page. Used for both the
   Firebase SDK and Google Identity Services, and only ever invoked
   when the relevant toggle is actually on — a school that never
   enables cloud sync never fetches either script. */
const _loadedScripts = {};
function loadScriptOnce(src){
  if(_loadedScripts[src]) return _loadedScripts[src];
  _loadedScripts[src] = new Promise((resolve, reject)=>{
    if(document.querySelector('script[src="'+src+'"]')){ resolve(); return; }
    const s = document.createElement('script');
    s.src = src;
    s.onload = ()=>resolve();
    s.onerror = ()=>{ delete _loadedScripts[src]; reject(new Error('Failed to load '+src)); };
    document.head.appendChild(s);
  });
  return _loadedScripts[src];
}

/* ---- Firebase: lazy-init + background mirror on every local save ---- */
let firebaseApp = null, firebaseDb = null, firebaseInitPromise = null, firebaseLastFailureAt = 0;
let firebaseAuth = null, firebaseAuthInitPromise = null;
const FIREBASE_RETRY_COOLDOWN_MS = 60000; // don't hammer the network every save if credentials are bad
function firebaseConfigLooksComplete(cfg){
  return !!(cfg.apiKey && cfg.projectId && cfg.appId);
}
async function ensureFirebaseReady(){
  if(!cloudConfig.firebaseEnabled) return false;
  if(!firebaseConfigLooksComplete(cloudConfig.firebase)) return false;
  if(firebaseDb) return true;
  if(firebaseInitPromise) return firebaseInitPromise;
  if(firebaseLastFailureAt && (Date.now() - firebaseLastFailureAt) < FIREBASE_RETRY_COOLDOWN_MS) return false;
  firebaseInitPromise = (async ()=>{
    try{
      await loadScriptOnce('https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js');
      await loadScriptOnce('https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js');
      firebaseApp = firebase.apps && firebase.apps.length ? firebase.app() : firebase.initializeApp(cloudConfig.firebase);
      firebaseDb = firebase.firestore();
      firebaseLastFailureAt = 0;
      return true;
    }catch(e){
      console.error('Firebase initialization failed:', e);
      firebaseApp = null; firebaseDb = null;
      firebaseLastFailureAt = Date.now();
      return false;
    }finally{
      firebaseInitPromise = null;
    }
  })();
  return firebaseInitPromise;
}
/* Loads the Auth SDK (separately from Firestore, only when actually
   needed — most sessions never touch Google Sign-In) and gets a
   firebase.auth() instance ready. Requires ensureFirebaseReady() to
   have initialised the app first, since Auth attaches to it. */
async function ensureFirebaseAuthReady(){
  const dbReady = await ensureFirebaseReady();
  if(!dbReady) return false;
  if(firebaseAuth) return true;
  if(firebaseAuthInitPromise) return firebaseAuthInitPromise;
  firebaseAuthInitPromise = (async ()=>{
    try{
      await loadScriptOnce('https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js');
      firebaseAuth = firebase.auth();
      return true;
    }catch(e){
      console.error('Firebase Auth initialization failed:', e);
      firebaseAuth = null;
      return false;
    }finally{
      firebaseAuthInitPromise = null;
    }
  })();
  return firebaseAuthInitPromise;
}
/* Fire-and-forget: called from lsWrite/removal after every LOCAL
   write succeeds. Never awaited by the caller, never throws outward
   — a Firebase outage or bad credentials must never affect the local
   save that already completed. */
async function mirrorToFirebase(fullKey, value){
  if(!cloudConfig.firebaseEnabled) return;
  try{
    const ready = await ensureFirebaseReady();
    if(!ready || !firebaseDb) return;
    await firebaseDb.collection('erp_sync').doc(fullKey).set({
      value: value === undefined ? null : value,
      updatedAt: new Date().toISOString()
    });
  }catch(e){
    console.error('Firebase mirror failed for "'+fullKey+'":', e);
  }
}
async function mirrorDeleteToFirebase(fullKey){
  if(!cloudConfig.firebaseEnabled) return;
  try{
    const ready = await ensureFirebaseReady();
    if(!ready || !firebaseDb) return;
    await firebaseDb.collection('erp_sync').doc(fullKey).delete();
  }catch(e){
    console.error('Firebase mirror-delete failed for "'+fullKey+'":', e);
  }
}

/* ============================================================
   LIVE SYNC — real-time cross-device updates
   ------------------------------------------------------------
   mirrorToFirebase() above is write-only: it pushes local saves
   up to Firestore but nothing ever reads them back down, so two
   devices open on the same school never actually see each
   other's changes. This section adds the missing half: one
   onSnapshot listener per data-key (students, vouchers, ...),
   active only while a school is loaded, that applies an incoming
   remote change to the in-memory arrays and local storage, then
   re-renders just the affected screens.

   GRANULARITY: sync happens at the whole-array level (same unit
   mirrorToFirebase already uses), not per-record. If two devices
   edit DIFFERENT students within the same few seconds, the later
   whole-array save wins and can silently drop the earlier edit.
   Fine for "one active device at a time, others watching/rare
   concurrent edits" — not a substitute for real per-record
   conflict resolution. The dormant SyncManager/ERPDatabase code
   elsewhere in this file was built for that; wiring it in would
   mean rearchitecting how every screen stores its data.
   ============================================================ */
const LIVE_SYNC_KEYS = ['students','vouchers','examRecords','staff','expenses','payrollRuns','staffAttendance','attendance','settings'];
const LIVE_SYNC_RENDER = {
  students: ()=>{ renderStudents(); renderDashboard(); },
  vouchers: ()=>{ renderVouchers(); renderFeeHeads(); renderBiFeeHeads(); renderDashboard(); renderPL(); },
  examRecords: ()=>{ renderExams(); },
