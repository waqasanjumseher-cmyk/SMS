  function ensureStylesInjected() {
    if (document.getElementById(OVERLAY_STYLE_ID)) return;
    const style = document.createElement('style');
    style.id = OVERLAY_STYLE_ID;
    style.textContent = OVERLAY_CSS;
    document.head.appendChild(style);
  }

  function escapeHtml(str) {
    return String(str == null ? '' : str).replace(/[&<>"']/g, c => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[c]));
  }

  /**
   * showLockOverlay(config)
   * Mounts a full-screen, non-dismissible-by-default modal that blocks
   * the rest of the UI. Two built-in kinds:
   *   kind: 'expired' — shows a renewal-key input + submit button, wired
   *                      to config.onRenewalSubmit(keyString) -> Promise<{success, error}>
   *   kind: 'tamper'  — shows a clock-tampering explanation with no
   *                      renewal input (a new key doesn't fix a clock
   *                      problem); optionally a "Recheck" button wired to
   *                      config.onRecheck() -> Promise<{success, error}>
   *
   * @param {{
   *   kind: 'expired'|'tamper',
   *   title?: string,
   *   message?: string,
   *   onRenewalSubmit?: (key:string) => Promise<{success:boolean, error?:string}>,
   *   onRecheck?: () => Promise<{success:boolean, error?:string}>
   * }} config
   */
  function showLockOverlay(config) {
    ensureStylesInjected();
    dismissOverlay(); // avoid stacking multiple overlays if called twice

    const isExpired = config.kind === 'expired';
    const icon = isExpired ? '⏱' : '⚠';
    const iconClass = isExpired ? 'expired' : 'tamper';
    const title = config.title || (isExpired ? 'License Expired' : 'Clock Tampering Detected');
    const message = config.message || (isExpired
      ? 'Your license has expired. Enter a renewal key to continue using the system.'
      : 'This device\'s clock appears to have moved backwards since the app last ran. Please make sure your system clock is set correctly, then try again.');

    const root = document.createElement('div');
    root.id = OVERLAY_ROOT_ID;
    root.innerHTML = `
      <div class="erp-lock-card" role="dialog" aria-modal="true" aria-labelledby="erp-lock-title">
        <div class="erp-lock-icon ${iconClass}">${icon}</div>
        <h2 class="erp-lock-title" id="erp-lock-title">${escapeHtml(title)}</h2>
        <p class="erp-lock-message">${escapeHtml(message)}</p>
        ${isExpired ? `
          <input type="text" class="erp-lock-input" id="erp-lock-key-input" placeholder="Enter renewal license key" autocomplete="off" />
          <div class="erp-lock-error" id="erp-lock-error"></div>
          <button class="erp-lock-btn" id="erp-lock-submit-btn">Activate</button>
        ` : `
          <div class="erp-lock-error" id="erp-lock-error"></div>
          <button class="erp-lock-btn" id="erp-lock-recheck-btn">I've fixed my clock — Recheck</button>
        `}
        <div class="erp-lock-meta">Need help? Contact your system administrator.</div>
      </div>
    `;
    document.body.appendChild(root);

    // Block page scroll while locked.
    document.body.style.overflow = 'hidden';

    const errorEl = root.querySelector('#erp-lock-error');

    if (isExpired && typeof config.onRenewalSubmit === 'function') {
      const btn = root.querySelector('#erp-lock-submit-btn');
      const input = root.querySelector('#erp-lock-key-input');
      const submit = async () => {
        const key = input.value.trim();
        errorEl.textContent = '';
        if (!key) { errorEl.textContent = 'Please enter a license key.'; return; }
        btn.disabled = true;
        btn.textContent = 'Verifying…';
        try {
          const result = await config.onRenewalSubmit(key);
          if (result && result.success) {
            dismissOverlay();
          } else {
            errorEl.textContent = (result && result.error) || 'Invalid or expired renewal key.';
            btn.disabled = false;
            btn.textContent = 'Activate';
          }
        } catch (e) {
          errorEl.textContent = 'Something went wrong verifying that key. Please try again.';
          btn.disabled = false;
          btn.textContent = 'Activate';
        }
      };
      btn.addEventListener('click', submit);
      input.addEventListener('keydown', e => { if (e.key === 'Enter') submit(); });
    }

    if (!isExpired && typeof config.onRecheck === 'function') {
      const btn = root.querySelector('#erp-lock-recheck-btn');
      btn.addEventListener('click', async () => {
        errorEl.textContent = '';
        btn.disabled = true;
        btn.textContent = 'Checking…';
        try {
          const result = await config.onRecheck();
          if (result && result.success) {
            dismissOverlay();
          } else {
            errorEl.textContent = (result && result.error) || 'Clock still looks incorrect.';
            btn.disabled = false;
            btn.textContent = "I've fixed my clock — Recheck";
          }
        } catch (e) {
          errorEl.textContent = 'Something went wrong rechecking. Please try again.';
          btn.disabled = false;
          btn.textContent = "I've fixed my clock — Recheck";
        }
      });
    }
  }

  /**
   * dismissOverlay()
   * Removes the lock overlay if present and restores page scroll.
   */
  function dismissOverlay() {
    const existing = document.getElementById(OVERLAY_ROOT_ID);
    if (existing) existing.remove();
    document.body.style.overflow = '';
  }

  /* =======================================================================
     4. GRACE-PERIOD DAILY WARNING TOAST
     ======================================================================= */

  function ensureToastContainer() {
    ensureStylesInjected();
    let container = document.getElementById(`${TOAST_ROOT_ID}-container`);
    if (!container) {
      container = document.createElement('div');
      container.id = `${TOAST_ROOT_ID}-container`;
      document.body.appendChild(container);
    }
    return container;
  }

  function todayKey() {
    return new Date().toISOString().slice(0, 10); // YYYY-MM-DD
  }

  /**
   * showGraceWarningToast(graceDaysRemaining, options)
   * Shows a dismissible, non-blocking warning toast. Only shows once per
   * calendar day by default (tracked in localStorage) so the user isn't
   * nagged on every page interaction during the grace window — pass
   * force:true to bypass that (e.g. for a manual "check license" action).
   * @param {number} graceDaysRemaining
   * @param {{ force?: boolean }} [options]
   */
  function showGraceWarningToast(graceDaysRemaining, options = {}) {
    if (!options.force) {
      const lastShown = localStorage.getItem(TOAST_LAST_SHOWN_KEY);
      if (lastShown === todayKey()) return; // already shown today
    }

    const container = ensureToastContainer();
    const toast = document.createElement('div');
    toast.className = 'erp-toast';
    const dayWord = graceDaysRemaining === 1 ? 'day' : 'days';
    toast.innerHTML = `
      <div class="erp-toast-icon">⚠</div>
      <div class="erp-toast-body">
        <p class="erp-toast-title">License Renewal Needed</p>
        <p class="erp-toast-text">Your license expired and is running on a grace period. ${graceDaysRemaining} ${dayWord} remaining before the system locks.</p>
      </div>
      <button class="erp-toast-close" aria-label="Dismiss">✕</button>
    `;
    toast.querySelector('.erp-toast-close').addEventListener('click', () => toast.remove());
    container.appendChild(toast);

    localStorage.setItem(TOAST_LAST_SHOWN_KEY, todayKey());

    // Auto-dismiss after 12s so it doesn't linger forever if ignored.
    setTimeout(() => { if (toast.parentNode) toast.remove(); }, 12000);
  }

  /* =======================================================================
     5. ORCHESTRATOR — call once on app launch
     ======================================================================= */

  /**
   * runProtectionChecks(licenseRecord, options)
   * Convenience all-in-one entry point: runs the clock-tamper check,
   * then the expiry check (using the tamper-resistant trusted time), and
   * shows the appropriate UI (lock overlay or grace toast) automatically.
   * Call this once at app launch, after loading the license record via
   * ERPLicenseEngine.
   *
   * @param {object} licenseRecord
   * @param {{
   *   graceDays?: number,
   *   onRenewalSubmit?: (key:string) => Promise<{success:boolean, error?:string}>
   * }} [options]
   * @returns {Promise<{ blocked: boolean, reason: 'tamper'|'expired'|null, status: object }>}
   */
  async function runProtectionChecks(licenseRecord, options = {}) {
    const tamperResult = await checkClockTampering();
    if (tamperResult.tampered) {
      showLockOverlay({
        kind: 'tamper',
        message: tamperResult.reason,
        onRecheck: async () => {
          const recheck = await checkClockTampering();
          return recheck.tampered
            ? { success: false, error: recheck.reason }
            : { success: true };
        }
      });
      return { blocked: true, reason: 'tamper', status: tamperResult };
    }

    const trustedNow = await getTrustedNow();
    const expiryStatus = await checkExpiryStatus(licenseRecord, { graceDays: options.graceDays, trustedNow });

    if (expiryStatus.status === 'expired') {
      showLockOverlay({
        kind: 'expired',
        onRenewalSubmit: options.onRenewalSubmit
      });
      return { blocked: true, reason: 'expired', status: expiryStatus };
    }

    if (expiryStatus.status === 'grace') {
      showGraceWarningToast(expiryStatus.graceDaysRemaining);
      return { blocked: false, reason: null, status: expiryStatus };
    }

    return { blocked: false, reason: null, status: expiryStatus };
  }

  /* =======================================================================
     PUBLIC API
     ======================================================================= */
  return {
    // Clock tampering
    recordCurrentTimestamp,
    checkClockTampering,
    getTrustedNow,

    // Expiry
    checkExpiryStatus,

    // UI
    showLockOverlay,
    dismissOverlay,
    showGraceWarningToast,

    // Orchestrator
    runProtectionChecks
  };
})();

if (typeof module !== 'undefined' && module.exports) {
  module.exports = ERPExpiryGuard;
}

