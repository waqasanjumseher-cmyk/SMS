function computeLedgerEntries(studentId){
  const rows = vouchers.filter(v=>v.studentId===studentId).slice()
    .sort((a,b)=> a.date < b.date ? -1 : (a.date > b.date ? 1 : 0));
  let running = 0;
  const entries = [];
  rows.forEach(v=>{
    running += Number(v.total||0);
    const desc = `${v.month} — ${(v.items||[]).map(i=>i.name).join(', ') || 'Fee Charge'}`;
    entries.push({ date: v.date, desc, charged: Number(v.total||0), paid: 0, balance: running, type:'charge' });
    if(Number(v.paid||0) > 0){
      running -= Number(v.paid||0);
      entries.push({ date: v.date, desc: `Payment Received — ${v.month}`, charged: 0, paid: Number(v.paid||0), balance: running, type:'payment' });
    }
  });
  const totalCharged = rows.reduce((a,v)=>a+Number(v.total||0), 0);
  const totalPaid = rows.reduce((a,v)=>a+Number(v.paid||0), 0);
  return { entries, totalCharged, totalPaid, balanceDue: totalCharged - totalPaid, voucherCount: rows.length };
}

/* ---- Phase 3B: per-student attendance history, drawn from the same
   `attendance` array the Daily Attendance module writes to (one entry
   per class+date, each holding a records[] of {studentId,status}). ---- */
function computeStudentAttendanceHistory(studentId){
  const rows = [];
  attendance.forEach(entry=>{
    const rec = entry.records.find(r=>r.studentId===studentId);
    if(rec) rows.push({ date: entry.date, class: entry.class, status: rec.status });
  });
  rows.sort((a,b)=> b.date.localeCompare(a.date));
  const presentCount = rows.filter(r=>r.status==='Present').length;
  const absentCount = rows.filter(r=>r.status==='Absent').length;
  const leaveCount = rows.filter(r=>r.status==='Leave').length;
  return { rows, presentCount, absentCount, leaveCount, total: rows.length };
}

