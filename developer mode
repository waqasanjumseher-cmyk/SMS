document.getElementById('bi_generateBtn').addEventListener('click', ()=>{
  const cls = document.getElementById('bi_class').value;
  const month = document.getElementById('bi_month').value;
  if(!cls){ toast('Select a class'); return; }
  if(!month){ toast('Select the installment month'); return; }

  // Extra one-off charges selected for this run, applied on top of each
  // student's own auto-fetched fee profile.
  const extraItems = [];
  document.querySelectorAll('.biChk').forEach(chk=>{
    if(chk.checked){
      const idx = chk.dataset.idx;
      const amt = Number(document.querySelector(`.biAmt[data-idx="${idx}"]`).value||0);
      extraItems.push({name: settings.feeHeads[idx].name, amount: amt});
    }
  });

  // Active Fee Billing configuration — Struck Off / Left / Graduated
  // students are excluded from bulk installment generation.
  const roster = students.filter(s=>s.class===cls && isActiveStudent(s));
  if(roster.length===0){ document.getElementById('bi_hint').textContent = `No active students found in ${cls}.`; return; }

  let created = 0, skipped = 0, admissionsCharged = 0;
  roster.forEach(s=>{
    const already = vouchers.some(v=>v.studentId===s.id && v.month===month);
    if(already){ skipped++; return; }

    const items = buildAutoFeeItems(s).concat(extraItems.map(i=>({...i})));
    const admissionApplied = items.some(it=>it.oneTime);
    const total = items.reduce((a,b)=>a+Number(b.amount||0),0);

    vouchers.push({
      id: uid('FV'), studentId: s.id, month,
      items: items.map(i=>({name:i.name, amount:i.amount})), total, paid:0,
      balance: total, status:'Unpaid', date: new Date().toISOString().slice(0,10)
    });
    if(admissionApplied && !s.admissionFeeCharged){ s.admissionFeeCharged = true; admissionsCharged++; }
    created++;
  });
  saveVouchers();
  if(admissionsCharged>0) saveStudents();
  renderVouchers();
  renderDashboard();
  renderReminders();
  document.getElementById('bi_hint').textContent =
    `Generated ${created} installment voucher(s) for ${cls} — ${month}, each using that student's own fee profile.`
    + (admissionsCharged ? ` ${admissionsCharged} included a one-time Admission Fee (first voucher).` : '')
    + (skipped ? ` Skipped ${skipped} student(s) who already had a voucher for this month.` : '');
  toast(`${created} voucher(s) generated for ${cls}`);
});

/* ============================================================
   2b-2) BULK FEE VOUCHER GENERATION MODULE (with feature toggle)
   ------------------------------------------------------------
   Separate from the "Bulk Monthly Installments" generator above:
   that one silently creates voucher records with no printable
   output. This module is print-first — it produces one combined,
   multi-page printable document (2–3 vouchers per A4 sheet, with
   cut lines) for a whole class or the whole school in one action,
   automatically rolling each student's unpaid balance from prior
   periods into the sheet. Entirely gated by
   settings.enableBulkVoucherGeneration (System Settings): when off,
   the "Bulk Vouchers" button stays hidden and nothing here runs.

   Performance note: every card is built as a plain string and the
   whole batch is written to #printArea in ONE innerHTML assignment
   — no per-student DOM node creation, no photos, no html2canvas —
   so 500+ vouchers stays cheap on memory/paint even on a modest
   laptop or Chromebook.
   ============================================================ */
