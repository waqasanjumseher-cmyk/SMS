}

async function removeUser(id){
  if(currentUser && currentUser.id===id){ toast("You can't remove your own account while logged in"); return; }
  if(!confirm('Remove this user account? They will no longer be able to log in.')) return;
  appUsers = appUsers.filter(u=>u.id!==id);
  await saveKey('erpUsers', appUsers);
  if(editingStaffId===id) resetStaffForm();
  renderManageUsers();
  toast('User removed');
}

