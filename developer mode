async function startSession(user, school){
  currentUser = user;
  currentSchool = school || null;
  currentSchoolId = school ? school.id : null;

  if(user.role === 'AnjumWebsDeveloper'){
    await saveGlobal('erp_session', { mode:'developer' });
  } else {
    await saveGlobal('erp_session', { mode:'school', schoolId: currentSchoolId, userId: user.id });
  }

  document.getElementById('loginOverlay').classList.remove('show');
  document.body.classList.add('authed');
  const form = document.getElementById('loginForm');
  if(form) form.reset();
  document.getElementById('loginError').textContent = '';
  document.getElementById('headerUserName').textContent = user.name;
  document.getElementById('headerUserRole').textContent = user.role === 'AnjumWebsDeveloper' ? 'Master Developer' : user.role;
  document.getElementById('sessionBadge').textContent = school ? school.name : 'Anjum Webs POS Engine';

  if(user.role === 'AnjumWebsDeveloper'){
    applyRBAC();
    // The Developer Control Panel is the primary landing view for the
    // Master Developer — every login (and every refresh-restored
    // session, via initAuth()) lands here directly, never on a blank
    // school Dashboard. openSchoolSettingsAsDev(), if it runs right
    // after this in initAuth(), will correctly override this with the
    // specific school's Dashboard — that's the intended Quick-Inspect flow.
    // Phase 1: bare landing = Command Center only. No per-school sidebar,
    // header, or module should render until a school is explicitly opened.
    setDevHomeMode(true);
    activateSidebarTab('devcontrol');
    renderDevControl();
    return;
  }

  setDevHomeMode(false);
  appUsers = await loadKey('erpUsers', []);
  applyRBAC();
  /* Reset in-memory business data to a clean slate before loading
     this school's scoped keys. loadAll()'s fallback is "whatever is
     already in memory" (to survive transient read errors) — but
     that must never be a DIFFERENT school's leftover data, so we
     zero it out first. This never touches localStorage itself,
     only the in-memory variables, so nothing gets erased on disk. */
  students = []; vouchers = []; examRecords = []; staff = []; expenses = []; attendance = [];
  await loadAll();
  if(user.role==='Super Admin') renderManageUsers();
}

