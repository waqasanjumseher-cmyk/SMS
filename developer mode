function applyRBAC(){
  // Dynamic Feature Masking: a tab only ever shows if (a) the role/checklist
  // grants it AND (b) the Developer has licensed that module for this school.
  // Tier 1 (Developer) always resolves to every tab — see computeAllowedTabs().
  const allowed = computeAllowedTabs(currentUser, currentSchool);
  document.querySelectorAll('.tab-btn').forEach(btn=>{
    btn.style.display = allowed.includes(btn.dataset.tab) ? '' : 'none';
  });
  const activeBtn = document.querySelector('.tab-btn.active');
  const activeAllowed = activeBtn && allowed.includes(activeBtn.dataset.tab);
  if(!activeAllowed && allowed.length){
    document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
    document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
    const firstBtn = document.querySelector(`.tab-btn[data-tab="${allowed[0]}"]`);
    const firstPanel = document.getElementById('panel-'+allowed[0]);
    if(firstBtn) firstBtn.classList.add('active');
    if(firstPanel) firstPanel.classList.add('active');
  }
  // Defensive UX: a Super Admin/staff account with literally nothing
  // licensed yet shouldn't just see a blank app — tell them why.
  if(!allowed.length && currentUser && currentUser.role !== 'AnjumWebsDeveloper'){
    toast('No modules are licensed for your account yet — contact your Developer/Super Admin.');
  }
}

