/* ---- Phase 4: Live "obtained cannot exceed total" validation ---- */
function validateSubjectRow(row){
  const obtInput = row.querySelector('.subjObt');
  const totInput = row.querySelector('.subjTot');
  const obt = Number(obtInput.value||0);
  const tot = Number(totInput.value||0);
  const invalid = tot > 0 && obt > tot;
  obtInput.classList.toggle('invalid', invalid);
  totInput.classList.toggle('invalid', invalid);
  obtInput.title = invalid ? `Obtained marks cannot exceed total marks (${tot})` : '';
  return !invalid;
}
function validateAllSubjectRows(){
  const rows = document.querySelectorAll('#subjectRows .subj-row');
  let allValid = true;
  rows.forEach(row=>{ if(!validateSubjectRow(row)) allValid = false; });
  const saveBtn = document.getElementById('saveExamBtn');
  if(saveBtn){
    saveBtn.disabled = !allValid;
    saveBtn.style.opacity = allValid ? '1' : '.55';
    saveBtn.style.cursor = allValid ? 'pointer' : 'not-allowed';
  }
  return allValid;
}

function gradeFor(pct){
  if(pct>=90) return 'A+';
  if(pct>=80) return 'A';
  if(pct>=70) return 'B';
  if(pct>=60) return 'C';
  if(pct>=50) return 'D';
  if(pct>=40) return 'E';
  return 'Fail';
}

document.getElementById('saveExamBtn').addEventListener('click', ()=>{
  const studentId = document.getElementById('e_student').value;
  const student = students.find(s=>s.id===studentId);
  if(!student){ toast('Select a student first'); return; }
  const title = document.getElementById('e_title').value.trim();
  if(!title){ toast('Enter exam title'); return; }
  if(!validateAllSubjectRows()){ toast('Fix subjects where obtained marks exceed total marks'); return; }

  const subjects = [];
  let marksError = null;
  document.querySelectorAll('.subj-row').forEach(row=>{
    const name = row.querySelector('.subjName').value.trim();
    const obt = Number(row.querySelector('.subjObt').value||0);
    const tot = Number(row.querySelector('.subjTot').value||0);
    if(!name || tot<=0) return;
    if(obt > tot && !marksError){
      marksError = `Obtained marks (${obt}) cannot exceed Total marks (${tot}) for "${name}"`;
    }
    subjects.push({name, obt, tot});
  });
  if(marksError){ toast(marksError); return; }
  if(subjects.length===0){ toast('Add at least one subject with marks'); return; }

  const obtSum = subjects.reduce((a,b)=>a+b.obt,0);
  const totSum = subjects.reduce((a,b)=>a+b.tot,0);
  const pct = totSum>0 ? Math.round((obtSum/totSum)*10000)/100 : 0;

  const record = { id: uid('EX'), studentId, title, subjects, obtSum, totSum, pct, grade: gradeFor(pct), date:new Date().toISOString().slice(0,10) };
  examRecords.push(record);
  saveExams();
  renderExams();
  toast('Result saved');
  showResultCard(record.id);
});

/* ============================================================
   3b) BULK MARKS ENTRY (Teacher Utility)
   One subject, one exam term, whole class at once. Upserts into
   the SAME examRecords array as individual entry: if a record for
   this student+exam term already exists (started via individual
   entry, or by another teacher entering a different subject for
   this same exam), the subject is added/updated within it and the
   totals are recomputed — it does not create a duplicate record.
   ============================================================ */
function upsertBulkMark(studentId, title, subjectName, obt, tot){
  let record = examRecords.find(r=>r.studentId===studentId && r.title===title);
  if(!record){
    record = { id: uid('EX'), studentId, title, subjects: [], obtSum:0, totSum:0, pct:0, grade:'', date:new Date().toISOString().slice(0,10) };
    examRecords.push(record);
  }
  const existingSubj = record.subjects.find(sub=>sub.name.toLowerCase()===subjectName.toLowerCase());
  if(existingSubj){ existingSubj.obt = obt; existingSubj.tot = tot; }
  else record.subjects.push({ name: subjectName, obt, tot });
  record.obtSum = record.subjects.reduce((a,b)=>a+b.obt,0);
  record.totSum = record.subjects.reduce((a,b)=>a+b.tot,0);
  record.pct = record.totSum>0 ? Math.round((record.obtSum/record.totSum)*10000)/100 : 0;
  record.grade = gradeFor(record.pct);
}

