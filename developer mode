function computeAllowedTabs(user, school){
  if(!user) return [];
  /* TIER 1 — ULTIMATE DEVELOPER POWER: unconditional, unlimited
     access to every tab in the entire system, plus the Developer
     Control Panel itself. This NEVER checks any school's feature
     licensing — the Developer is the one who sets those limits for
     everyone else, so nothing can ever cap the Developer. This is
     also the ONLY role that ever sees the 'settings' tab — School
     Settings is Developer-mode only. */
  if(user.role === 'AnjumWebsDeveloper') return [...ALL_TABS, 'devcontrol'];
  /* TIER 2 — Super Admin's access is capped entirely by what the
     Developer has licensed for this specific school, and additionally
     never includes 'settings' — see licensedTabsForSchool(). */
  if(user.role === 'Super Admin') return licensedTabsForSchool(school);
  /* Staff: further capped by whatever the Super Admin personally
     assigned them, itself already bounded by the school's license.
     STAFF_ASSIGNABLE_TABS never contained 'settings' to begin with. */
  const perms = Array.isArray(user.permissions) ? user.permissions : [];
  return perms.filter(t => licensedAssignableTabs(school).includes(t));
}

