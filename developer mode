/* Uploads one File into the given Drive subfolder and returns its new file id. */
async function uploadFileToDrive(file, folderId){
  const token = await getDriveAccessToken(false);
  const boundary = 'erpmedia' + Date.now();
  const metadata = { name: file.name || ('upload-' + Date.now()) };
  if(folderId) metadata.parents = [folderId];
  const fileBuf = await file.arrayBuffer();
  let binary = '';
  const bytes = new Uint8Array(fileBuf);
  for(let i=0;i<bytes.length;i++) binary += String.fromCharCode(bytes[i]);
  const base64Data = btoa(binary);
  const body =
    '--' + boundary + '\r\n' +
    'Content-Type: application/json; charset=UTF-8\r\n\r\n' +
    JSON.stringify(metadata) + '\r\n' +
    '--' + boundary + '\r\n' +
    'Content-Type: ' + (file.type || 'application/octet-stream') + '\r\n' +
    'Content-Transfer-Encoding: base64\r\n\r\n' +
    base64Data + '\r\n' +
    '--' + boundary + '--';
  const res = await driveApiFetch('https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart', token, {
    method: 'POST',
    headers: { 'Content-Type': 'multipart/related; boundary=' + boundary },
    body
  });
  const created = await res.json();
  return created.id;
}

/* Fetches a Drive-archived image with the connecting account's own
   token (files stay private — never made public) and hands back a
   blob: URL for <img src>. Cached per session so the same photo isn't
   re-downloaded on every re-render. */
async function fetchDriveImage(fileId){
  if(driveImageCache.has(fileId)) return driveImageCache.get(fileId);
  const token = await getDriveAccessToken(false);
  const res = await driveApiFetch(`https://www.googleapis.com/drive/v3/files/${fileId}?alt=media`, token);
  const blob = await res.blob();
  const url = URL.createObjectURL(blob);
  driveImageCache.set(fileId, url);
  return url;
}

/* Background pass: for every student whose photo lives only in Drive
   (photoDriveId set, no live local preview yet), fetch it and drop the
   resulting blob: URL straight into s.photo — every existing template
   (student table, ID cards, admission slip, ledger) already renders
   whatever is in s.photo, so nothing else needs to change for display.
   Blob URLs are session-local and are stripped again before
   saveStudents() writes to storage — see saveStudents() below. */
let hydratingDrivePhotos = false;
async function hydrateDrivePhotos(){
  if(!driveMediaReady() || hydratingDrivePhotos) return;
  const pending = students.filter(s => s.photoDriveId && !(s.photo && s.photo.startsWith('blob:')));
  if(!pending.length) return;
  hydratingDrivePhotos = true;
  try{
    await Promise.all(pending.map(async s=>{
      try{ s.photo = await fetchDriveImage(s.photoDriveId); }
      catch(e){ console.error('Could not load Drive photo for', s.name, e); }
    }));
    renderStudents();
  } finally {
    hydratingDrivePhotos = false;
  }
}

