   source of truth even if Firebase is offline/disabled. Note: this is a
   DIFFERENT collection than the 'clients/{schoolId}' doc Remote Control
   uses below — worth reconciling into one tenant document later. */
async function saveSchoolModuleConfigToFirestore(school){
  const ready = await ensureFirebaseReady();
  if(!ready || !firebaseDb) return;
  const tenantId = school.id;
  try{
    await firebaseDb.collection('users').doc(tenantId)
      .collection('config').doc('modules')
      .set({
        package: school.package,
        moduleFlags: school.moduleFlags,
        upgradeRequests: school.upgradeRequests || [],
        updatedAt: new Date().toISOString()
      }, { merge:true });
  }catch(e){
    console.error('Firestore module-config save failed:', e);
    toast('Saved locally — cloud sync for module config failed, will retry next edit');
  }
}

/* ============================================================
   REMOTE CONTROL MODAL (Enterprise Feature)
   ------------------------------------------------------------
   Everything here reads/writes ONE document: clients/{schoolId} —
   the same doc RemoteControlListener already watches client-side
   for status/message, now extended with lockedFeatures/branding/
   pendingCommand. One doc, one listener per client, one modal here
   to edit all of it — deliberately not a separate collection per
   concern, to keep this reviewable as a single access-control
   surface rather than five scattered ones.
   ============================================================ */
async function openRemoteControlModal(schoolId){
  const school = schools.find(s => s.id === schoolId);
  if(!school){ toast('School not found'); return; }

  document.getElementById('printArea').innerHTML = `
    <div style="padding:22px 24px;max-height:78vh;overflow-y:auto;">
      <span class="close-x" onclick="closeModal()">&times;</span>
      <h2 style="margin:0 0 4px;color:var(--navy-2);">🎛 Remote Control — ${escapeHtml(school.name)}</h2>
      <p class="muted" style="margin:0 0 16px;">Live controls for this installation. Changes apply on any device this school is signed into, next time it's online.</p>
      <p class="muted" id="rc_loading">Loading current state...</p>
      <div id="rc_body" style="display:none;"></div>
    </div>`;
  openModal(false, true);

  const ready = await ensureFirebaseReady();
  if(!ready || !firebaseDb){
    document.getElementById('rc_loading').textContent = 'Cloud connection is not configured — Remote Control requires Firebase to be enabled first (see Cloud Config).';
    return;
  }

  let data = {}, telemetry = null;
  try{
    const [snap, telSnap] = await Promise.all([
      firebaseDb.collection('clients').doc(schoolId).get(),
      firebaseDb.collection('clients').doc(schoolId).collection('telemetry').doc('latest').get()
    ]);
    data = snap.exists ? snap.data() : {};
    telemetry = telSnap.exists ? telSnap.data() : null;
  }catch(e){
    console.error('Remote Control load failed:', e);
    document.getElementById('rc_loading').textContent = 'Could not load current state — check your connection and try again.';
    return;
  }

  const status = data.status || 'Active';
  const message = data.message || '';
  const lf = data.lockedFeatures || {};
  const br = data.branding || {};
  const lastCmd = data.lastCommandResult || null;

  const LOCK_LABELS = {
    enableIDCardGenerator: 'ID Card Generator',
    enableThermalPrint: 'Thermal Printing',
    enableWhatsApp: 'WhatsApp Reminders',
    enablePayroll: 'Payroll Module',
    enableDataExport: 'Data Export (Excel/JSON)',
    enableSettingsTab: 'Settings Tab (already Developer-only by default — see note)',
  };

  document.getElementById('rc_loading').style.display = 'none';
  const body = document.getElementById('rc_body');
  body.style.display = '';
  body.innerHTML = `
    <div class="card" style="margin-bottom:14px;">
      <h3 style="margin:0 0 8px;font-size:14px;color:var(--navy-2);">🔒 Kill-Switch</h3>
      <label>Status</label>
