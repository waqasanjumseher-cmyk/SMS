/* ============================================================
   PHASE 2 — EXCEL-BASED BACKUP & RESTORE ENGINE (Super Admin only)
   Ditches JSON entirely: aggregates this school's scoped storage
   arrays into a genuine multi-sheet .xlsx workbook (Students, Fees
   History, Expenses, Staff Payroll, Staff Logins, Settings) using
   SheetJS, then reverses the process on import with header-mapped
   validation before anything touches localStorage.
   ============================================================ */

/* ---- Chunked Row Builder --------------------------------------------
   Maps a large array into export rows WITHOUT freezing the UI thread.
   Instead of one long synchronous .map() over (potentially) thousands
   of records, this walks the array 500 records at a time and yields
   back to the browser between batches (setTimeout(0) — lets paint /
   input events run), then resumes. Small arrays finish in a single
   batch with no perceptible delay; large ones stay responsive and can
   report progress via the optional onProgress callback. ------------- */
const EXPORT_CHUNK_SIZE = 500;
function chunkedMapRows(array, mapFn, onProgress){
  return new Promise((resolve, reject)=>{
    const total = array.length;
    const out = new Array(total);
    let i = 0;
    function step(){
      try{
        const end = Math.min(i + EXPORT_CHUNK_SIZE, total);
        for(; i<end; i++) out[i] = mapFn(array[i], i);
        if(onProgress) onProgress(i, total);
        if(i < total){
          setTimeout(step, 0); // yield to the UI thread before the next batch
        } else {
          resolve(out);
        }
      }catch(err){ reject(err); }
    }
    if(total === 0){ resolve(out); return; }
    step();
  });
}

/* ---- Export: aggregate scoped arrays into workbook sheets ----------
   Async + chunked: the two sheets most likely to be large in a real
   school (Students, FeesHistory) are built via chunkedMapRows so a
   multi-thousand-record export never locks up the tab. The smaller
   arrays (expenses, staff, payroll runs, logins, settings) are cheap
   enough to map directly. --------------------------------------------- */
async function buildBackupWorkbook(onProgress){
  const wb = XLSX.utils.book_new();

  const studentRows = await chunkedMapRows(students, s => ({
    ID: s.id, AdmissionNo: s.admissionNo, Roll: s.roll, Name: s.name, Father: s.father,
    Class: s.class, Section: s.section || '', Session: s.session, Phone: s.phone, DOB: s.dob, FormB: s.formb,
    Status: s.status || 'Active', AdmissionDate: s.admissionDate, LeftDate: s.leftDate || '',
    TuitionFee: s.tuitionFee != null ? s.tuitionFee : '',
    AdmissionFee: s.admissionFee != null ? s.admissionFee : '',
    AdmissionFeeCharged: s.admissionFeeCharged ? 'Yes' : 'No',
    CustomFeesJSON: JSON.stringify(s.customFees || {})
  }), (done,total)=>onProgress && onProgress(`Students: ${done}/${total}`));
  XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(studentRows), 'Students');

  const studentById = new Map(students.map(s=>[s.id, s]));
  const feeRows = await chunkedMapRows(vouchers, v => {
    const student = studentById.get(v.studentId);
    return {
      ID: v.id, StudentID: v.studentId, StudentName: student ? student.name : '',
      Month: v.month, Total: v.total, Paid: v.paid,
      Balance: (v.balance != null ? v.balance : v.total - v.paid),
      Status: v.status, Date: v.date, ItemsJSON: JSON.stringify(v.items || [])
    };
  }, (done,total)=>onProgress && onProgress(`Fees history: ${done}/${total}`));
  XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(feeRows), 'FeesHistory');

  const expenseRows = expenses.map(x => ({
    ID: x.id, Date: x.date, Category: x.category, Title: x.title, Amount: x.amount
  }));
  XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(expenseRows), 'Expenses');

  const payrollRows = staff.map(m => ({
    ID: m.id, Name: m.name, Designation: m.designation, Joining: m.joining,
    Basic: m.basic, Phone: m.phone
  }));
  XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(payrollRows), 'StaffPayroll');

  const payrollRunRows = payrollRuns.map(r => {
    const m = staff.find(x=>x.id===r.staffId);
    return {
      ID: r.id, StaffID: r.staffId, StaffName: m ? m.name : '', Month: r.month,
      Basic: r.basic, Allowances: r.allowances, Deductions: r.deductions, Net: r.net,
      ExpenseID: r.expenseId, PaidOn: r.paidOn
    };
  });
  XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(payrollRunRows), 'PayrollRuns');

  const loginRows = appUsers.map(u => ({
    ID: u.id, Username: u.username, Password: u.password, Name: u.name,
    Role: u.role, PermissionsJSON: JSON.stringify(u.permissions || [])
  }));
  XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(loginRows), 'StaffLogins');

  const settingsRows = [{
    ClassesJSON: JSON.stringify(settings.classes || []),
    FeeHeadsJSON: JSON.stringify(settings.feeHeads || []),
    SchoolJSON: JSON.stringify(settings.school || {}),
    Theme: settings.theme || 'navy'
  }];
  XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(settingsRows), 'Settings');

  return wb;
}

