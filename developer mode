/* ---- Translates a stored status string (Paid/Unpaid/Partial/Active/Left)
   for display, without changing the underlying data value. ---- */
function statusLabel(status){
  const map = { Paid:'status_paid', Unpaid:'status_unpaid', Partial:'status_partial', Active:'status_active', Left:'status_left' };
  return map[status] ? t(map[status]) : status;
}

