/* ---- 2) Attendance Integration + Monthly Payroll Generator ---- */
const MONTH_NAMES = ['January','February','March','April','May','June','July','August','September','October','November','December'];
const SALARY_EXPENSE_CATEGORIES = ['Staff Salaries','Staff Payroll']; // 'Staff Payroll' kept for backward compatibility with Phase 8 data

function payrollMonthValue(){
  return document.getElementById('pr_month').value || new Date().toISOString().slice(0,7);
}
function monthLabel(month){
  if(!month) return '';
  const [y,m] = month.split('-');
  return `${MONTH_NAMES[Number(m)-1] || m} ${y}`;
}
function findPayrollRun(staffId, month){
  return payrollRuns.find(r=>r.staffId===staffId && r.month===month);
}
function perDayRate(basic){
  return Number(basic||0) / 30;
}
function computeLeaveDeduction(basic, allowedLeaves, absentDays){
  const rate = perDayRate(basic);
  const excess = Math.max(0, Number(absentDays||0) - Number(allowedLeaves||0));
  return { rate, excess, deduction: Math.round(rate * excess) };
}
function getAbsentDays(staffId, month){
  const rec = staffAttendance.find(a=>a.staffId===staffId && a.month===month);
  return rec ? Number(rec.absentDays||0) : 0;
}
function setAbsentDays(staffId, month, days){
  let rec = staffAttendance.find(a=>a.staffId===staffId && a.month===month);
  if(rec){ rec.absentDays = Math.max(0, Number(days||0)); }
  else { staffAttendance.push({ id: uid('ATT'), staffId, month, absentDays: Math.max(0, Number(days||0)) }); }
  saveStaffAttendance();
}

function renderPayrollProcessing(){
  const month = payrollMonthValue();
  const tbody = document.getElementById('staffTable');
  tbody.innerHTML = staff.map(m=>{
    const run = findPayrollRun(m.id, month);
    const paid = !!run;
    const absentDays = paid ? run.absentDays : getAbsentDays(m.id, month);
    const { excess, deduction } = computeLeaveDeduction(m.basic, m.allowedLeaves, absentDays);
    return `<tr>
      <td>${escapeHtml(m.name)}<br><span class="muted">${escapeHtml(m.designation)}</span></td>
      <td>${money(m.basic)}</td>
      <td>${Number(m.allowedLeaves||0)}</td>
      <td>${paid
          ? absentDays
          : `<input type="number" id="att_absent_${m.id}" value="${absentDays}" min="0" style="width:70px;" onchange="updateStaffAbsent('${m.id}')">`
        }</td>
      <td>${excess} day(s) — ${money(deduction)}</td>
      <td><span class="pill ${paid?'paid':'due'}">${paid?'Paid':'Unpaid'}</span></td>
      <td>
        ${paid
          ? `<button class="btn small secondary" onclick="showPayslip('${m.id}','${month}')">View Slip</button>
             <button class="btn small danger" onclick="reversePayroll('${m.id}','${month}')">Undo</button>`
          : `<button class="btn small" onclick="openPayrollModal('${m.id}')">Process Payroll</button>`
        }
      </td>
    </tr>`;
  }).join('') || `<tr><td colspan="7" class="muted">No staff added yet — add staff in the Staff Directory above.</td></tr>`;

  const totalPaid = payrollRuns.filter(r=>r.month===month).reduce((a,r)=>a+Number(r.net||0),0);
  document.getElementById('payrollTotal').textContent = money(totalPaid);
}

function updateStaffAbsent(staffId){
  const el = document.getElementById('att_absent_'+staffId);
  if(!el) return;
  setAbsentDays(staffId, payrollMonthValue(), Number(el.value||0));
  renderPayrollProcessing();
}

document.getElementById('pr_month').addEventListener('input', renderPayrollProcessing);

/* ---- 3) Salary Slip Generation — approval modal ---- */
let payrollModalStaffId = null;
let payrollModalMonth = null;
let payrollModalPenalties = [];

function openPayrollModal(staffId){
  const m = staff.find(x=>x.id===staffId);
  if(!m) return;
  const month = payrollMonthValue();
  if(findPayrollRun(staffId, month)){ toast(m.name+' is already paid for '+monthLabel(month)); return; }

  payrollModalStaffId = staffId;
  payrollModalMonth = month;
  payrollModalPenalties = [];

  document.getElementById('payrollModalTitle').textContent = 'Process Payroll — ' + m.name;
  document.getElementById('payrollModalSub').textContent = `${escapeHtml(m.designation)} • ${monthLabel(month)}`;
  document.getElementById('pm_basic').value = m.basic;
  document.getElementById('pm_allowances').value = 0;
  document.getElementById('pm_allowedLeaves').value = Number(m.allowedLeaves||0);
  document.getElementById('pm_absentDays').value = getAbsentDays(staffId, month);
  renderPenaltyRows();
  recomputePayrollModal();
  document.getElementById('payrollModalBg').classList.add('show');
}
function closePayrollModal(){
  document.getElementById('payrollModalBg').classList.remove('show');
  payrollModalStaffId = null;
}
document.getElementById('payrollModalBg').addEventListener('click', e=>{
  if(e.target.id==='payrollModalBg') closePayrollModal();
});
document.getElementById('pm_allowances').addEventListener('input', recomputePayrollModal);
document.getElementById('pm_absentDays').addEventListener('input', recomputePayrollModal);

function addPenaltyRow(){
  payrollModalPenalties.push({ description:'', amount:0 });
  renderPenaltyRows();
  recomputePayrollModal();
}
function removePenaltyRow(idx){
  payrollModalPenalties.splice(idx,1);
  renderPenaltyRows();
  recomputePayrollModal();
}
function updatePenaltyField(idx, field, value){
  if(!payrollModalPenalties[idx]) return;
  payrollModalPenalties[idx][field] = field==='amount' ? Number(value||0) : value;
  recomputePayrollModal();
}
function renderPenaltyRows(){
  const box = document.getElementById('pm_penaltyRows');
  box.innerHTML = payrollModalPenalties.map((p,idx)=>`
    <div class="row" style="align-items:flex-end;margin-bottom:8px;">
      <div><label style="font-size:11px;">Description</label><input type="text" placeholder="e.g. Late arrival fine" value="${escapeHtml(p.description||'')}" oninput="updatePenaltyField(${idx},'description',this.value)"></div>
      <div style="flex:0 0 120px;"><label style="font-size:11px;">Amount (Rs.)</label><input type="number" value="${p.amount}" oninput="updatePenaltyField(${idx},'amount',this.value)"></div>
      <div style="flex:0 0 auto;"><button class="btn small danger" type="button" onclick="removePenaltyRow(${idx})">✕</button></div>
    </div>`).join('') || `<p class="muted" style="margin:4px 0;">No manual penalties added.</p>`;
}
function recomputePayrollModal(){
  const basic = Number(document.getElementById('pm_basic').value||0);
  const allowances = Number(document.getElementById('pm_allowances').value||0);
  const allowedLeaves = Number(document.getElementById('pm_allowedLeaves').value||0);
  const absentDays = Number(document.getElementById('pm_absentDays').value||0);
  const { rate, excess, deduction } = computeLeaveDeduction(basic, allowedLeaves, absentDays);
  const penaltiesTotal = payrollModalPenalties.reduce((a,p)=>a+Number(p.amount||0),0);
  const gross = basic + allowances;
  const totalDeductions = deduction + penaltiesTotal;
  const net = gross - totalDeductions;

  document.getElementById('pm_perDayRate').textContent = money(rate);
  document.getElementById('pm_excessDays').textContent = excess;
