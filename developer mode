    if(students.some(s=>s.id===prev)) sel.value = prev;
  }

  function cert_fieldHtml(f, type){
    const inputId = 'cf_' + type + '_' + f.id;
    let control;
    if(f.type === 'select'){
      control = `<select id="${inputId}"><option value="">— Select —</option>` +
        f.options.map(o=>`<option value="${o}">${o}</option>`).join('') + '</select>';
    } else if(f.type === 'textarea'){
      control = `<textarea id="${inputId}"></textarea>`;
    } else {
      control = `<input type="${f.type}" id="${inputId}">`;
    }
    return `<div class="field"><label for="${inputId}">${f.label}</label>${control}</div>`;
  }

  function cert_renderForm(prefill){
    const type = cert_currentType();
    const formArea = document.getElementById('cert_formArea');
    if(!formArea) return;
    if(!type){
      formArea.innerHTML = '<p class="muted">Select a certificate type above to begin.</p>';
      cert_renderSheet();
      return;
    }
    const fields = CERT_FIELD_SETS[type];
    formArea.innerHTML = `<div class="row">${fields.map(f=>cert_fieldHtml(f, type)).join('')}</div>`;
    formArea.querySelectorAll('input,select,textarea').forEach(el=>{
      el.addEventListener('input', cert_renderSheet);
      el.addEventListener('change', cert_renderSheet);
    });
    if(prefill){
      const set = (id, val) => { const el = document.getElementById('cf_'+type+'_'+id); if(el && val!=null) el.value = val; };
      set('studentName', prefill.name);
      set('fatherName', prefill.father);
      set('admissionNo', prefill.admissionNo);
      set('className', prefill.class);
      set('section', prefill.section);
      set('rollNo', prefill.roll);
      set('dob', prefill.dob);
      set('dateOfAdmission', prefill.admissionDate);
      set('periodFrom', prefill.admissionDate);
      if(prefill.status === 'Left' && prefill.leftDate){
        set('dateOfLeaving', prefill.leftDate);
        set('periodTo', prefill.leftDate);
      }
    }
    cert_renderSheet();
  }

  function cert_val(type, id){
    const el = document.getElementById('cf_'+type+'_'+id);
    return el ? (el.value || '').trim() : '';
  }
  function cert_blank(v, width){
    return v ? escapeHtml(v) : '&nbsp;'.repeat(width || 10);
  }
  function cert_fmtDate(v){
    if(!v) return '';
    const d = new Date(v + 'T00:00:00');
    if(isNaN(d)) return v;
    return d.toLocaleDateString('en-GB', {day:'2-digit', month:'long', year:'numeric'});
  }

  function cert_headerHtml(){
    const sch = (typeof settings !== 'undefined' && settings.school) || {};
    return `<div style="text-align:center;border-bottom:2px solid var(--navy,#16324f);padding-bottom:12px;margin-bottom:16px;">
      <div style="font-size:20px;font-weight:800;color:var(--navy,#16324f);">${escapeHtml((sch.name||'SCHOOL').toUpperCase())}</div>
      <div style="font-size:12px;color:var(--muted,#697180);margin-top:4px;">${escapeHtml(sch.address || sch.slogan || '')}</div>
    </div>`;
  }
  function cert_footerHtml(){
    return `<div style="display:flex;justify-content:space-between;margin-top:60px;">
      <div style="text-align:center;"><div style="border-top:1px solid #000;padding-top:6px;width:180px;">Class Teacher</div></div>
      <div style="text-align:center;"><div style="border-top:1px solid #000;padding-top:6px;width:180px;">Principal / Head of School</div></div>
    </div>`;
  }

  function cert_slcTemplate(today){
    const t = 'slc';
    const certNo = cert_val(t,'certNo') || 'SLC-____';
    const issueDate = cert_val(t,'issueDate') || today;
    return cert_headerHtml() +
      `<div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:10px;">
        <span>Certificate No: ${escapeHtml(certNo)}</span><span>Date: ${cert_fmtDate(issueDate)}</span></div>
      <div style="text-align:center;font-size:17px;font-weight:700;text-decoration:underline;margin-bottom:16px;">School Leaving Certificate</div>
      <div style="line-height:2;font-size:14px;">
        This is to certify that ${cert_blank(cert_val(t,'studentName'),18)}, son/daughter of ${cert_blank(cert_val(t,'fatherName'),16)},
        bearing Admission No. ${cert_blank(cert_val(t,'admissionNo'),10)}, was a bona fide student of this institution in Class
        ${cert_blank(cert_val(t,'className'),6)}, Section ${cert_blank(cert_val(t,'section'),4)} (Roll No. ${cert_blank(cert_val(t,'rollNo'),6)}).<br><br>
        Date of Birth: ${cert_blank(cert_fmtDate(cert_val(t,'dob')),14)}. Date of Admission: ${cert_blank(cert_fmtDate(cert_val(t,'dateOfAdmission')),14)}.
        Date of Leaving: ${cert_blank(cert_fmtDate(cert_val(t,'dateOfLeaving')),14)}.<br><br>
        Reason for Leaving: ${cert_blank(cert_val(t,'reasonForLeaving'),22)}.<br><br>
        During his/her stay at this institution, the conduct of the student was ${cert_blank(cert_val(t,'conduct'),12)}.
        ${cert_val(t,'remarks') ? '<br><br>Remarks: ' + escapeHtml(cert_val(t,'remarks')) : ''}
        <br><br>This certificate is issued on the request of the concerned for record and future reference.
      </div>` + cert_footerHtml();
  }

  function cert_characterTemplate(today){
    const t = 'character';
    const certNo = cert_val(t,'certNo') || 'CC-____';
    const issueDate = cert_val(t,'issueDate') || today;
    return cert_headerHtml() +
      `<div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:10px;">
        <span>Certificate No: ${escapeHtml(certNo)}</span><span>Date: ${cert_fmtDate(issueDate)}</span></div>
      <div style="text-align:center;font-size:17px;font-weight:700;text-decoration:underline;margin-bottom:16px;">Character Certificate</div>
      <div style="line-height:2;font-size:14px;">
        This is to certify that ${cert_blank(cert_val(t,'studentName'),18)}, son/daughter of ${cert_blank(cert_val(t,'fatherName'),16)},
        Admission No. ${cert_blank(cert_val(t,'admissionNo'),10)}, was enrolled as a student of Class ${cert_blank(cert_val(t,'className'),6)},
        Section ${cert_blank(cert_val(t,'section'),4)} at this institution, from ${cert_blank(cert_fmtDate(cert_val(t,'periodFrom')),14)}
        to ${cert_blank(cert_fmtDate(cert_val(t,'periodTo')),14)}.<br><br>
        Date of Birth: ${cert_blank(cert_fmtDate(cert_val(t,'dob')),14)}.<br><br>
        During this period, his/her character and conduct were found to be ${cert_blank(cert_val(t,'conduct'),12)}. To the best of our
        knowledge, he/she was not involved in any disciplinary action during his/her association with this institution.
        ${cert_val(t,'remarks') ? '<br><br>Remarks: ' + escapeHtml(cert_val(t,'remarks')) : ''}
        <br><br>This certificate is issued on request for whatever purpose it may serve.
      </div>` + cert_footerHtml();
  }

  function cert_renderSheet(){
    const type = cert_currentType();
    const sheet = document.getElementById('cert_sheet');
    if(!sheet) return;
    if(!type){ sheet.innerHTML = '<p class="muted">No certificate type selected.</p>'; return; }
    const today = new Date().toISOString().slice(0,10);
    sheet.innerHTML = type === 'slc' ? cert_slcTemplate(today) : cert_characterTemplate(today);
  }

  document.addEventListener('DOMContentLoaded', function(){
    const panel = document.getElementById('panel-certificates');
    if(!panel) return;

    panel.addEventListener('change', function(e){
      if(e.target.name === 'certType') cert_renderForm();
    });

    const studentSelect = document.getElementById('cert_studentSelect');
    if(studentSelect){
      studentSelect.addEventListener('change', function(){
        const s = students.find(x=>x.id===studentSelect.value);
        cert_renderForm(s || null);
      });
    }

    const printBtn = document.getElementById('cert_printBtn');
    if(printBtn){
      printBtn.addEventListener('click', function(){
        const type = cert_currentType();
        if(!type){ toast('Select a certificate type first'); return; }
        document.getElementById('printArea').innerHTML = `<div class="doc" data-fmt="a4">${document.getElementById('cert_sheet').innerHTML}</div>`;
        currentWA = null;
        openModal(false, true);
      });
    }

    const resetBtn = document.getElementById('cert_resetBtn');
    if(resetBtn){
      resetBtn.addEventListener('click', function(){ cert_renderForm(); });
    }

    // Repopulate the student dropdown every time this tab is actually
    // opened, so newly-registered students show up without a page reload.
    document.querySelectorAll('.tab-btn[data-tab="certificates"]').forEach(btn=>{
      btn.addEventListener('click', cert_populateStudentSelect);
    });
  });
})();

/* ==========================================================================
   SIBLING FEE CONCESSION (Fee Collection tab)
   New — nothing like this existed before. Groups currently-enrolled
   students by guardian phone number (the closest existing equivalent to
   a family id, since the student record has no separate familyId field)
   and shows a live discount suggestion when generating a fee voucher for
   a student who has enrolled siblings. Entirely read-only/advisory: it
   does not touch the voucher schema or auto-apply anything — staff still
   decide whether to type the suggested discount into the voucher's
   existing item list themselves.
   ========================================================================== */
(function(){
  'use strict';

  // Tier by sibling count (2nd child onward). Adjust freely — this is a
  // sensible default, not a business rule pulled from anywhere specific.
  const FX_CONCESSION_TIERS = [
    { minSiblings: 1, discountPct: 10 }, // 2nd enrolled sibling
    { minSiblings: 2, discountPct: 15 }, // 3rd enrolled sibling
    { minSiblings: 3, discountPct: 20 }, // 4th+ enrolled sibling
  ];

  function fx_siblingGroups(){
    const groups = {};
    students.filter(s=>s.status !== 'Left' && s.phone).forEach(s=>{
      const key = s.phone.replace(/\D/g,'');
      if(!key) return;
      (groups[key] = groups[key] || []).push(s);
    });
    return groups;
  }

  function fx_concessionFor(student){
    if(!student || !student.phone) return null;
    const groups = fx_siblingGroups();
    const key = student.phone.replace(/\D/g,'');
    const siblings = (groups[key] || []).filter(s=>s.id !== student.id);
    if(siblings.length === 0) return null;
    let tier = null;
    FX_CONCESSION_TIERS.forEach(t=>{ if(siblings.length >= t.minSiblings) tier = t; });
    if(!tier) return null;
    return { siblingCount: siblings.length, siblingNames: siblings.map(s=>s.name), discountPct: tier.discountPct };
  }

  function fx_renderHint(studentId){
    const host = document.getElementById('fx_siblingHint');
    if(!host) return;
    const student = students.find(s=>s.id===studentId);
    const info = fx_concessionFor(student);
    if(!info){ host.style.display = 'none'; host.innerHTML=''; return; }
    const tuition = Number(student.tuitionFee||0);
    const suggested = Math.round(tuition * info.discountPct / 100);
    host.style.display = '';
    host.innerHTML = `<div class="muted" style="background:var(--teal-light,#e6f3f0);border-radius:6px;padding:8px 10px;margin:8px 0;font-size:12.5px;">
      🏷️ Sibling Concession available: ${escapeHtml(student.name)} has ${info.siblingCount} enrolled sibling(s)
      (${info.siblingNames.map(escapeHtml).join(', ')}) — suggested ${info.discountPct}% discount on tuition
      (≈ Rs. ${suggested.toLocaleString()}). Add this as a line item on the voucher below if you'd like to apply it.
    </div>`;
  }

  window.fx_renderHint = fx_renderHint; // called from the feeCombo select callback above

  document.addEventListener('DOMContentLoaded', function(){
    const studentInfo = document.getElementById('f_studentInfo');
    if(!studentInfo) return; // Fee Collection form markup not found — nothing to hook into

    // Insert the hint container right after the "student info" line that
    // already appears under the combobox once a student is picked.
    const hint = document.createElement('div');
    hint.id = 'fx_siblingHint';
    hint.style.display = 'none';
    studentInfo.insertAdjacentElement('afterend', hint);
  });
})();

</script>

<script>
/* ============================================================
   AL-NOOR ERP V2 MANAGEMENT HUB
   Additive module: uses the existing ERP data model and storage engine.
