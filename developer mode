/* ============================== PHASE 5 ==============================
   High-Capacity IndexedDB Local Storage Engine — source: erp_indexeddb_engine.js (unmodified)
   ======================================================================= */
/* =========================================================================
   ERP INDEXEDDB ENGINE — Phase 5
   =========================================================================
   Self-contained. No external libraries. Replaces localStorage for
   high-volume ERP data (students, ledgers, attendance, transactions) —
   localStorage is capped around 5-10MB and is synchronous (blocks the
   main thread on every read/write), which doesn't scale to years of
   attendance/fee records. IndexedDB has a much higher storage ceiling
   (browser-dependent, but typically hundreds of MB to GB+) and is async
   by design.

   Note on relationship to earlier phases: Phase 1's secure storage
   wrapper (ERPCrypto.secureSetItem/secureGetItem) and this module solve
   different problems and are meant to coexist, not replace one another —
   Phase 1 is for small, sensitive, encrypted blobs (license records,
   auth tokens) where window.storage/localStorage's size is plenty. This
   module is for bulk structured records (thousands of student/ledger
   rows) that need indexed lookup, which is exactly what localStorage
   (even via Phase 1's wrapper) is the wrong tool for. The
   'licensing_config' store below is for lightweight app CONFIG that
   benefits from being queryable alongside other ERP data (e.g. "list
   every module's config in one place") — it is NOT a replacement for
   Phase 3's encrypted license record storage; keep the actual license
   payload/device slots in ERPCrypto's encrypted storage as before.
   ========================================================================= */

const ERPDatabase = (function () {
  'use strict';

  if (typeof window === 'undefined' || !window.indexedDB) {
    throw new Error('ERPDatabase requires a browser with IndexedDB support.');
  }

  const DB_NAME = 'erp_database';
  const DB_VERSION = 1;

  /* =======================================================================
     1. SCHEMA — object stores and their indexes
     ------------------------------------------------------------------------
     Every store uses keyPath: 'id' with autoIncrement, so callers never
     have to generate their own primary keys — dbInsert() hands back
     whatever id IndexedDB assigned. Indexes below are what make
     dbGetByIndex()/dbQueryRange() fast instead of falling back to a full
     getAll()+filter() scan.
     ======================================================================= */

  const SCHEMA = {
    students_customers: {
      keyPath: 'id',
      autoIncrement: true,
      indexes: [
        { name: 'rollNo', keyPath: 'rollNo', options: { unique: true } },
        { name: 'name', keyPath: 'name', options: { unique: false } },
        { name: 'className', keyPath: 'className', options: { unique: false } },
        { name: 'phone', keyPath: 'phone', options: { unique: false } },
        { name: 'status', keyPath: 'status', options: { unique: false } } // e.g. active/inactive/alumni
      ]
    },
    fee_sales_ledger: {
      keyPath: 'id',
      autoIncrement: true,
      indexes: [
        { name: 'studentId', keyPath: 'studentId', options: { unique: false } },
        { name: 'date', keyPath: 'date', options: { unique: false } },
        { name: 'paymentStatus', keyPath: 'paymentStatus', options: { unique: false } }, // paid/partial/unpaid
        { name: 'invoiceNo', keyPath: 'invoiceNo', options: { unique: true } }
      ]
    },
    attendance: {
      keyPath: 'id',
      autoIncrement: true,
      indexes: [
        { name: 'studentId', keyPath: 'studentId', options: { unique: false } },
        { name: 'date', keyPath: 'date', options: { unique: false } },
        { name: 'status', keyPath: 'status', options: { unique: false } }, // present/absent/late
        // Compound index: fetch one student's attendance for one day in
        // a single lookup instead of filtering a per-student scan by date.
        { name: 'studentId_date', keyPath: ['studentId', 'date'], options: { unique: true } }
      ]
    },
    transactions: {
      keyPath: 'id',
      autoIncrement: true,
      indexes: [
        { name: 'date', keyPath: 'date', options: { unique: false } },
        { name: 'type', keyPath: 'type', options: { unique: false } }, // income/expense/payroll/refund...
        { name: 'referenceId', keyPath: 'referenceId', options: { unique: false } } // links back to a ledger/invoice row
      ]
    },
    licensing_config: {
      keyPath: 'id',
      autoIncrement: true,
      indexes: [
        { name: 'moduleKey', keyPath: 'moduleKey', options: { unique: true } },
        { name: 'updatedAt', keyPath: 'updatedAt', options: { unique: false } }
      ]
    }
  };

  /* =======================================================================
     2. DATABASE OPEN / UPGRADE
     ======================================================================= */

  let dbPromise = null;

  function openDatabase() {
    if (dbPromise) return dbPromise;

    dbPromise = new Promise((resolve, reject) => {
      const request = indexedDB.open(DB_NAME, DB_VERSION);

      request.onupgradeneeded = (event) => {
        const db = event.target.result;
        for (const storeName of Object.keys(SCHEMA)) {
          const config = SCHEMA[storeName];
          let store;
          if (!db.objectStoreNames.contains(storeName)) {
            store = db.createObjectStore(storeName, {
              keyPath: config.keyPath,
              autoIncrement: config.autoIncrement
            });
          } else {
            // Upgrading an existing store (future schema versions land
            // here) — reuse the store from the versionchange transaction.
            store = event.target.transaction.objectStore(storeName);
          }
          for (const idx of config.indexes) {
            if (!store.indexNames.contains(idx.name)) {
              store.createIndex(idx.name, idx.keyPath, idx.options || {});
            }
          }
        }
      };

      request.onsuccess = (event) => {
        const db = event.target.result;
        // If another tab upgrades the DB version later, this connection
        // becomes stale — close it so a fresh openDatabase() call next
        // time gets a valid connection instead of silently failing writes.
        db.onversionchange = () => { db.close(); dbPromise = null; };
        resolve(db);
      };

      request.onerror = () => {
        dbPromise = null;
        reject(new Error(`ERPDatabase: failed to open database — ${request.error && request.error.message}`));
      };

      request.onblocked = () => {
        console.warn('ERPDatabase: upgrade blocked — another tab has this database open. Close other tabs and reload.');
      };
    });

    return dbPromise;
  }

  /** Runs `work(store)` inside a transaction and wraps it in a Promise. */
  async function runTransaction(storeName, mode, work) {
    if (!SCHEMA[storeName]) {
      throw new Error(`ERPDatabase: unknown store "${storeName}". Known stores: ${Object.keys(SCHEMA).join(', ')}`);
    }
    const db = await openDatabase();

    return new Promise((resolve, reject) => {
      const tx = db.transaction(storeName, mode);
      const store = tx.objectStore(storeName);
      let result;

      tx.oncomplete = () => resolve(result);
      tx.onerror = () => reject(new Error(`ERPDatabase: transaction failed on "${storeName}" — ${tx.error && tx.error.message}`));
      tx.onabort = () => reject(new Error(`ERPDatabase: transaction aborted on "${storeName}" — ${tx.error && tx.error.message}`));

      try {
        const maybeRequest = work(store);
        // work() either returns an IDBRequest (typical single-op case)
        // whose .result we capture, or resolves `result` itself via a
        // closure (used by the multi-step helpers further down).
        if (maybeRequest && typeof maybeRequest.onsuccess !== 'undefined') {
          maybeRequest.onsuccess = () => { result = maybeRequest.result; };
          maybeRequest.onerror = () => { /* surfaced via tx.onerror */ };
        } else {
          result = maybeRequest;
        }
      } catch (e) {
        reject(e);
      }
    });
  }

  /* =======================================================================
     3. CRUD OPERATIONS
     ======================================================================= */

  /**
   * dbInsert(store, data)
   * Adds a new record. Do not include an `id` field — it's assigned by
   * IndexedDB's autoIncrement and returned to you.
   * @param {string} store
   * @param {object} data
   * @returns {Promise<object>} the inserted record, including its new `id`
   */
  async function dbInsert(store, data) {
    if (data && data.id !== undefined) {
      throw new Error('dbInsert: do not pass an `id` — it is auto-assigned. Use dbUpdate() to modify an existing record.');
    }
    const newId = await runTransaction(store, 'readwrite', (objectStore) => objectStore.add(data));
    return { ...data, id: newId };
  }

  /**
   * dbGet(store, id)
   * @param {string} store
   * @param {number} id
   * @returns {Promise<object|undefined>} the record, or undefined if no such id
   */
  async function dbGet(store, id) {
    return runTransaction(store, 'readonly', (objectStore) => objectStore.get(id));
  }

  /**
   * dbGetAll(store, options)
   * @param {string} store
   * @param {{ limit?: number }} [options]
   * @returns {Promise<object[]>}
   */
  async function dbGetAll(store, options = {}) {
    return runTransaction(store, 'readonly', (objectStore) =>
      options.limit ? objectStore.getAll(null, options.limit) : objectStore.getAll()
    ) || [];
  }

  /**
   * dbUpdate(store, data)
   * Replaces the existing record with the same `id` (IndexedDB `put`
   * semantics: creates it if it doesn't already exist, so this also
   * works for upserts if you already know the id you want).
   * @param {string} store
   * @param {object} data  must include `id`
   * @returns {Promise<object>} the updated record
   */
  async function dbUpdate(store, data) {
    if (data == null || data.id === undefined) {
      throw new Error('dbUpdate: `data.id` is required to know which record to replace.');
    }
    await runTransaction(store, 'readwrite', (objectStore) => objectStore.put(data));
    return data;
  }

  /**
   * dbDelete(store, id)
   * @param {string} store
   * @param {number} id
   * @returns {Promise<void>}
   */
  async function dbDelete(store, id) {
    await runTransaction(store, 'readwrite', (objectStore) => objectStore.delete(id));
  }

  /* =======================================================================
     4. INDEXED SEARCH HELPERS
     ------------------------------------------------------------------------
     These are what make "search by Roll No, Date, Payment Status" fast —
     each hits the matching index directly instead of scanning every row.
     ======================================================================= */

  /**
   * dbGetByIndex(store, indexName, value)
   * Exact-match lookup on an index — e.g.
   *   dbGetByIndex('students_customers', 'rollNo', 'R-2026-014')
   *   dbGetByIndex('fee_sales_ledger', 'paymentStatus', 'unpaid')
   * @returns {Promise<object[]>} all matching records (empty array if none)
   */
  async function dbGetByIndex(store, indexName, value) {
    return runTransaction(store, 'readonly', (objectStore) => {
      const index = objectStore.index(indexName);
      return index.getAll(value);
    }) || [];
  }

  /**
   * dbQueryRange(store, indexName, { from, to })
   * Range lookup on an index — e.g. all attendance rows or transactions
   * between two dates:
   *   dbQueryRange('attendance', 'date', { from: '2026-08-01', to: '2026-08-15' })
   * Either bound may be omitted for an open-ended range.
   * @returns {Promise<object[]>}
   */
  async function dbQueryRange(store, indexName, { from, to } = {}) {
    let range;
    if (from !== undefined && to !== undefined) range = IDBKeyRange.bound(from, to);
    else if (from !== undefined) range = IDBKeyRange.lowerBound(from);
    else if (to !== undefined) range = IDBKeyRange.upperBound(to);
    else range = null;

    return runTransaction(store, 'readonly', (objectStore) => {
      const index = objectStore.index(indexName);
      return index.getAll(range);
    }) || [];
  }

  /**
   * dbCount(store, indexName, value)
   * Count of matching records without loading them all into memory —
   * e.g. "how many students have paymentStatus = 'unpaid'".
   * Omit indexName/value to count every record in the store.
   * @returns {Promise<number>}
   */
  async function dbCount(store, indexName, value) {
    return runTransaction(store, 'readonly', (objectStore) => {
      if (indexName === undefined) return objectStore.count();
      return objectStore.index(indexName).count(value);
    });
  }

  /* =======================================================================
     5. BULK HELPERS
     ------------------------------------------------------------------------
     Bulk operations use ONE transaction for the whole batch rather than
     one per record — far faster for imports (e.g. bulk-loading a class
     roster from a spreadsheet) and keeps the batch atomic: if one record
     fails, the whole transaction aborts rather than leaving a half-
     imported store.
     ======================================================================= */

  /**
   * dbBulkInsert(store, dataArray)
   * @param {string} store
   * @param {object[]} dataArray
   * @returns {Promise<object[]>} inserted records including their new ids
   */
  async function dbBulkInsert(store, dataArray) {
    if (!SCHEMA[store]) throw new Error(`ERPDatabase: unknown store "${store}".`);
    const db = await openDatabase();

    return new Promise((resolve, reject) => {
      const tx = db.transaction(store, 'readwrite');
      const objectStore = tx.objectStore(store);
      const inserted = [];

      dataArray.forEach((data) => {
        const request = objectStore.add(data);
        request.onsuccess = () => inserted.push({ ...data, id: request.result });
      });

      tx.oncomplete = () => resolve(inserted);
      tx.onerror = () => reject(new Error(`ERPDatabase: bulk insert failed on "${store}" — ${tx.error && tx.error.message}`));
      tx.onabort = () => reject(new Error(`ERPDatabase: bulk insert aborted on "${store}" — ${tx.error && tx.error.message}`));
    });
  }

  /**
   * dbClearStore(store)
   * Wipes every record in a store. Use with care — mainly useful for
   * "reset demo data" / dev tooling, not everyday app flow.
   * @returns {Promise<void>}
   */
  async function dbClearStore(store) {
    await runTransaction(store, 'readwrite', (objectStore) => objectStore.clear());
  }

  /* =======================================================================
     PUBLIC API
     ======================================================================= */
  return {
    // Lifecycle
    openDatabase,

    // Core CRUD (as requested)
    dbInsert,
    dbGet,
    dbGetAll,
    dbUpdate,
    dbDelete,

    // Indexed search
    dbGetByIndex,
    dbQueryRange,
    dbCount,

    // Bulk
    dbBulkInsert,
    dbClearStore,

    // Exposed for reference/debugging (e.g. an admin "inspect schema" screen)
    SCHEMA
  };
})();

if (typeof module !== 'undefined' && module.exports) {
  module.exports = ERPDatabase;
}

