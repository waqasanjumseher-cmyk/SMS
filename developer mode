    }catch(e){ console.error(e); toast('Failed to save — check connection'); }
  });

  document.getElementById('rc_saveBrandingBtn').addEventListener('click', async ()=>{
    const branding = {
      footerText: document.getElementById('rc_footerText').value.trim(),
      developerCredit: document.getElementById('rc_devCredit').value.trim(),
      watermarkText: document.getElementById('rc_watermark').value.trim(),
    };
    try{
      await firebaseDb.collection('clients').doc(schoolId).set({ branding }, {merge:true});
      toast('Branding saved — applies to new vouchers/ID cards immediately');
    }catch(e){ console.error(e); toast('Failed to save — check connection'); }
  });

  document.getElementById('rc_saveExpiryBtn').addEventListener('click', async ()=>{
    school.expiryDate = document.getElementById('rc_expiryDate').value || null;
    await saveGlobal('erp_schools', schools);
    toast('Expiry date saved');
    renderDevControl();
  });

  function issueCommand(action, label){
    if(!confirm(`Send "${label}" to ${school.name}? This takes effect next time their app is open.`)) return;
    firebaseDb.collection('clients').doc(schoolId).set({
      pendingCommand: { action, issuedAt: new Date().toISOString(), nonce: uid('cmd_') }
    }, {merge:true}).then(()=>{
      toast(`Command sent: ${label}`);
    }).catch(e=>{
      console.error(e);
      toast('Failed to send command — check connection');
    });
  }
  document.getElementById('rc_cmdPurge').addEventListener('click', ()=>issueCommand('PURGE_CACHE','Purge Cache'));
  document.getElementById('rc_cmdLogout').addEventListener('click', ()=>issueCommand('FORCE_LOGOUT','Force Logout'));
  document.getElementById('rc_cmdBackup').addEventListener('click', ()=>issueCommand('TRIGGER_BACKUP','Trigger Backup'));
