/* ---- Profit & Loss ---- */
function computePL(month){
  const revenue = vouchers.filter(v=>v.month===month).reduce((a,v)=>a+Number(v.paid||0),0);
  const monthExpenses = expenses.filter(x=>x.date && x.date.slice(0,7)===month);
  const salary = monthExpenses.filter(x=>SALARY_EXPENSE_CATEGORIES.includes(x.category)).reduce((a,x)=>a+Number(x.amount||0),0);
  const otherExpenses = monthExpenses.filter(x=>!SALARY_EXPENSE_CATEGORIES.includes(x.category)).reduce((a,x)=>a+Number(x.amount||0),0);
  const expenseTotal = salary + otherExpenses;
  const net = revenue - expenseTotal;
  return { revenue, salary, expenseTotal, net };
}
function renderPL(){
  const month = document.getElementById('pl_month').value || new Date().toISOString().slice(0,7);
  const { revenue, salary, expenseTotal, net } = computePL(month);
  document.getElementById('pl_revenue').textContent = money(revenue);
  document.getElementById('pl_salary').textContent = money(salary);
  document.getElementById('pl_expenses').textContent = money(expenseTotal);
  const netEl = document.getElementById('pl_net');
  netEl.textContent = (net<0 ? '-' : '') + money(Math.abs(net));
  netEl.style.color = net < 0 ? 'var(--danger)' : '#217a3c';
}
document.getElementById('pl_month').addEventListener('input', renderPL);

