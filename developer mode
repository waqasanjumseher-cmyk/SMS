/* ============================================================
   PHASE 5A: GOOGLE DRIVE OAUTH2 — MEDIA ARCHIVING
   ------------------------------------------------------------
   Reuses the Master Developer Client ID configured just above
   (Developer Panel → Cloud Credentials → Google Drive Config).
   Each school authorizes with a single click via Google's own
   consent screen, and every file this app creates lives inside
   THAT SAME Google account's own Drive — under a dedicated
   "Anjum_Webs_POS_Data" root folder — never anywhere else.
   Scope is drive.file, so this app can only see/manage files it
   itself created; nothing already in the school's Drive is
   touched, and nothing is shared back to Anjum Webs or any other
   client school.
   ============================================================ */
const DRIVE_ROOT_FOLDER_NAME = 'Anjum_Webs_POS_Data';
const DRIVE_MEDIA_SCOPE = 'https://www.googleapis.com/auth/drive.file';

// In-memory only — an access token is never persisted to storage. A
// fresh one is requested (silently, where Google allows it) whenever
// the cached one is missing or close to expiry.
let driveMedia = { accessToken:'', expiresAt:0, tokenClient:null };
const driveImageCache = new Map(); // driveFileId -> blob: URL, for this session only

function driveMediaReady(){
  return !!(settings.drive && settings.drive.connected && settings.drive.folderId);
}
function driveTokenValid(){
  return driveMedia.accessToken && Date.now() < driveMedia.expiresAt - 30000;
}

/* Resolves with a live access token — reusing the cached one, or
   silently refreshing via Google Identity Services if this browser
   already has consent for this account. Falls back to an interactive
   popup only when explicitly asked for (the initial Connect click). */
function getDriveAccessToken(interactive){
  return new Promise(async (resolve, reject)=>{
    if(driveTokenValid()){ resolve(driveMedia.accessToken); return; }
    if(!cloudConfig.drive.clientId){ reject(new Error('No Master Developer Client ID configured')); return; }
    try{
      await loadScriptOnce('https://accounts.google.com/gsi/client');
      if(!driveMedia.tokenClient){
        driveMedia.tokenClient = google.accounts.oauth2.initTokenClient({
          client_id: cloudConfig.drive.clientId,
          scope: DRIVE_MEDIA_SCOPE,
          callback: ()=>{} // overridden per-request just below
        });
      }
      driveMedia.tokenClient.callback = (resp)=>{
        if(resp.error){ reject(new Error(resp.error)); return; }
        driveMedia.accessToken = resp.access_token;
        driveMedia.expiresAt = Date.now() + (Number(resp.expires_in||3600) * 1000);
        resolve(driveMedia.accessToken);
      };
      driveMedia.tokenClient.requestAccessToken({ prompt: interactive ? 'consent' : '' });
    }catch(e){ reject(e); }
  });
}

async function driveApiFetch(url, token, options={}){
  const res = await fetch(url, { ...options, headers: { ...(options.headers||{}), Authorization: 'Bearer ' + token } });
  if(!res.ok){ const errText = await res.text().catch(()=> ''); throw new Error('Drive API error ' + res.status + ': ' + errText); }
  return res;
}

async function driveFindOrCreateFolder(token, name, parentId){
  const parentClause = parentId ? `'${parentId}' in parents and ` : `'root' in parents and `;
  const q = encodeURIComponent(`${parentClause}mimeType='application/vnd.google-apps.folder' and name='${name.replace(/'/g,"\\'")}' and trashed=false`);
  const listRes = await driveApiFetch(`https://www.googleapis.com/drive/v3/files?q=${q}&fields=files(id,name)`, token);
  const listData = await listRes.json();
  if(listData.files && listData.files.length) return listData.files[0].id;

  const metadata = { name, mimeType: 'application/vnd.google-apps.folder' };
  if(parentId) metadata.parents = [parentId];
  const createRes = await driveApiFetch('https://www.googleapis.com/drive/v3/files', token, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(metadata)
  });
  const created = await createRes.json();
  return created.id;
}

/* Single-click connect flow: authorize this school's OWN Google
