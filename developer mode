document.getElementById('bulkVoucherGenerateBtn').addEventListener('click', ()=>{
  const month = document.getElementById('bulkV_month').value;
  const scope = document.getElementById('bulkV_scope').value;
  const cls = document.getElementById('bulkV_class').value;
  const perPage = Number(document.getElementById('bulkV_perPage').value || 3);
  const hint = document.getElementById('bulkV_hint');

  if(!month){ toast('Select the voucher month/period'); return; }
  if(scope==='class' && !cls){ toast('Select a class'); return; }

  let roster = students.filter(isActiveStudent);
  if(scope==='class') roster = roster.filter(s=>s.class===cls);
  if(roster.length===0){ hint.textContent = 'No active students found for this scope.'; return; }

  const genBtn = document.getElementById('bulkVoucherGenerateBtn');
  genBtn.disabled = true;
  hint.textContent = `Building ${roster.length} voucher(s)... this may take a moment for large batches.`;

  // Deferred one tick so the "Building..." hint actually paints before
  // the (synchronous) batch work below runs on the main thread.
  setTimeout(()=>{
    let createdCount = 0;
    const cards = [];
    roster.forEach(student=>{
      const { voucher, created } = bv_getOrCreateMonthVoucher(student, month);
      if(created) createdCount++;
      const priorBalance = bv_priorBalance(student, voucher.id);
      cards.push(bv_cardHtml(student, voucher, priorBalance));
    });

    if(createdCount>0){ saveVouchers(); saveStudents(); }

    // Group cards into fixed-size "sheets" — each sheet is one printed
    // page via CSS page-break-after, set below through --bv-per-page.
    const sheets = [];
    for(let i=0;i<cards.length;i+=perPage){
      sheets.push(`<div class="bulk-voucher-sheet" style="--bv-per-page:${perPage};">${cards.slice(i,i+perPage).join('')}</div>`);
    }

    document.getElementById('printArea').innerHTML = sheets.join('');
    closeBulkVoucherModal();
    currentWA = null; // bulk output has no single WhatsApp target
    openModal(false, true, 'bulk');

    genBtn.disabled = false;
    toast(`${cards.length} voucher(s) ready to print (${createdCount} newly generated).`);
    renderVouchers();
    renderDashboard();
    renderReminders();
  }, 30);
});

