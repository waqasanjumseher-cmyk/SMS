/* ---- Phase 6: Dynamic Date-Range Period Report ---- */
function dateInRange(dateStr, from, to){
  if(!dateStr) return false;
  if(from && dateStr < from) return false;
  if(to && dateStr > to) return false;
  return true;
}

function computePeriodReport(from, to){
  const inflow  = vouchers.filter(v=>dateInRange(v.date, from, to)).reduce((a,v)=>a+Number(v.paid||0), 0);
  const outflow = expenses.filter(x=>dateInRange(x.date, from, to)).reduce((a,x)=>a+Number(x.amount||0), 0);
  const enrolments = students.filter(s=>dateInRange(s.admissionDate, from, to)).length;
  const leftCount = students.filter(s=>s.status==='Left' && dateInRange(s.leftDate, from, to)).length;
  const net = inflow - outflow;
  return { inflow, outflow, enrolments, leftCount, net };
}

function renderPeriodReport(){
  const fromEl = document.getElementById('rpt_from');
  const toEl = document.getElementById('rpt_to');
  if(!fromEl || !toEl) return;
  const from = fromEl.value;
  const to = toEl.value;
  const { inflow, outflow, enrolments, leftCount, net } = computePeriodReport(from, to);

  document.getElementById('rpt_revenue').textContent = money(inflow);
  document.getElementById('rpt_enrolments').textContent = enrolments;
  document.getElementById('rpt_leftCount').textContent = leftCount;
  document.getElementById('rpt_inflow').textContent = money(inflow);
  document.getElementById('rpt_outflow').textContent = money(outflow);

  const netEl = document.getElementById('rpt_netPL');
  netEl.textContent = (net<0 ? '-' : '') + money(Math.abs(net));
  netEl.style.color = net < 0 ? 'var(--danger)' : '#217a3c';
}

function setPeriodRange(from, to){
  document.getElementById('rpt_from').value = from;
  document.getElementById('rpt_to').value = to;
  renderPeriodReport();
}

