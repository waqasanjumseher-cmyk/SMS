(function(){
'use strict';
let v2={timetable:[],accounting:[],sessions:[],audit:[],messages:[],cashClosings:[]};
const V2KEYS=['v2_timetable','v2_accounting','v2_sessions','v2_audit','v2_messages','v2_cashClosings'];
function v2Money(n){return 'Rs. '+Number(n||0).toLocaleString();}
function v2Esc(x){return typeof escapeHtml==='function'?escapeHtml(x):String(x??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
async function v2Load(){
  try{v2.timetable=await loadKey(V2KEYS[0],[])||[];v2.accounting=await loadKey(V2KEYS[1],[])||[];v2.sessions=await loadKey(V2KEYS[2],[])||[];v2.audit=await loadKey(V2KEYS[3],[])||[];v2.messages=await loadKey(V2KEYS[4],[])||[];v2.cashClosings=await loadKey(V2KEYS[5],[])||[];}catch(e){console.warn('V2 load',e)}
  if(!v2.sessions.length){v2.sessions=[{id:'S'+Date.now(),name:(document.getElementById('sessionBadge')?.textContent||'2026-27'),active:true,createdAt:new Date().toISOString()}];await saveKey(V2KEYS[2],v2.sessions)}
  v2RenderAll();
}
async function v2Save(key,val){v2[key]=val;await saveKey('v2_'+key,val);}
async function v2Audit(action,detail){v2.audit.unshift({id:'A'+Date.now(),at:new Date().toISOString(),user:(typeof currentUser!=='undefined'&&currentUser?.username)||'User',action,detail});v2.audit=v2.audit.slice(0,250);await v2Save('audit',v2.audit);v2RenderAudit();}
function v2StudentOptions(){return (typeof students==='undefined'?[]:students).filter(s=>!s.status||s.status==='Active');}
function v2RenderStudents(){const sel=document.getElementById('v2StudentSelect');if(!sel)return;const q=(document.getElementById('v2StudentSearch')?.value||'').toLowerCase();const arr=(typeof students==='undefined'?[]:students).filter(s=>[s.name,s.admissionNo,s.fatherName,s.phone,s.class].some(x=>String(x||'').toLowerCase().includes(q))).slice(0,200);const old=sel.value;sel.innerHTML='<option value="">Select student</option>'+arr.map(s=>`<option value="${v2Esc(s.id)}">${v2Esc(s.name)} — ${v2Esc(s.class||'')}</option>`).join('');if(arr.some(s=>s.id===old))sel.value=old;v2RenderMessageStudents();}
function v2ShowStudent(){const id=document.getElementById('v2StudentSelect')?.value;const box=document.getElementById('v2StudentProfile');if(!id){box.innerHTML='<div class="v2-empty">Select a student to view the complete profile.</div>';v2RenderParent();return}const s=students.find(x=>x.id===id);if(!s)return;const att=(attendance||[]).flatMap(a=>a.records||[]).filter(r=>r.studentId===id);const present=att.filter(r=>r.status==='Present').length, absent=att.filter(r=>r.status==='Absent').length;const sv=(vouchers||[]).filter(v=>v.studentId===id);const billed=sv.reduce((a,v)=>a+Number(v.total||0),0),paid=sv.reduce((a,v)=>a+Number(v.paid||0),0);const marks=(typeof examRecords!=='undefined'&&Array.isArray(examRecords)?examRecords:[]).filter(e=>e.studentId===id);const photo=s.photo&&/^https?:|^data:/.test(s.photo)?s.photo:'';box.innerHTML=`<div class="v2-profile-head"><img class="v2-avatar" src="${photo||''}" onerror="this.style.display='none'" alt=""><div><h3 style="margin:0 0 5px">${v2Esc(s.name)}</h3><div class="muted">${v2Esc(s.class||'')} ${s.section?'— '+v2Esc(s.section):''} · Admission ${v2Esc(s.admissionNo||'—')}</div><div class="v2-info-grid"><div><small>Father/Guardian</small><b>${v2Esc(s.fatherName||s.guardianName||'—')}</b></div><div><small>Phone</small><b>${v2Esc(s.phone||'—')}</b></div><div><small>Attendance</small><b>${att.length?Math.round(present/att.length*100):0}%</b></div><div><small>Fee Due</small><b class="v2-danger">${v2Money(billed-paid)}</b></div></div></div></div><div class="v2-info-grid"><div><small>Present</small><b>${present}</b></div><div><small>Absent</small><b>${absent}</b></div><div><small>Vouchers</small><b>${sv.length}</b></div><div><small>Exam Records</small><b>${marks.length}</b></div></div>`;v2RenderParent();}
function v2RenderMessageStudents(){const sel=document.getElementById('v2MsgStudent');if(!sel)return;const old=sel.value;sel.innerHTML='<option value="">Select recipient</option>'+v2StudentOptions().map(s=>`<option value="${v2Esc(s.id)}">${v2Esc(s.name)} — ${v2Esc(s.phone||'No phone')}</option>`).join('');if(old)sel.value=old;}
function v2BuildMessage(){const type=document.getElementById('v2MsgType')?.value;const s=students?.find(x=>x.id===document.getElementById('v2MsgStudent')?.value);const due=s?((vouchers||[]).filter(v=>v.studentId===s.id).reduce((a,v)=>a+Number(v.balance||0),0)):0;const templates={fee:`Dear Parent, the outstanding school fee for ${s?.name||'{student_name}'} is ${v2Money(due)}. Please clear the dues at your earliest convenience.`,absence:`Dear Parent, your child ${s?.name||'{student_name}'} is absent from school today. Please contact the administration if required.`,result:`Dear Parent, the result of ${s?.name||'{student_name}'} is now available. Please contact the school for details.`,general:`Dear Parent, this is an important notice from the school regarding ${s?.name||'{student_name}'}.`};document.getElementById('v2MsgText').value=templates[type]||templates.general;}
async function v2OpenWhatsApp(){if(!requireFeature||!requireFeature('whatsappAlerts','WhatsApp Alerts'))return;const id=document.getElementById('v2MsgStudent').value,s=students.find(x=>x.id===id);if(!s||!s.phone){toast('Select a student with a WhatsApp number');return}const msg=document.getElementById('v2MsgText').value.trim();if(!msg)return;v2.messages.unshift({at:new Date().toISOString(),studentId:id,type:document.getElementById('v2MsgType').value,message:msg});await v2Save('messages',v2.messages.slice(0,100));await v2Audit('WhatsApp message prepared',`${s.name}: ${document.getElementById('v2MsgType').value}`);window.open('https://wa.me/'+String(s.phone).replace(/\D/g,'')+'?text='+encodeURIComponent(msg),'_blank');v2RenderMessages();}
async function v2AddTimetable(){const cls=document.getElementById('v2ttClass').value,day=document.getElementById('v2ttDay').value,period=document.getElementById('v2ttPeriod').value.trim(),subject=document.getElementById('v2ttSubject').value.trim(),teacher=document.getElementById('v2ttTeacher').value.trim(),room=document.getElementById('v2ttRoom').value.trim();if(!cls||!period||!subject){toast('Class, period and subject are required');return}v2.timetable.push({id:'TT'+Date.now(),cls,day,period,subject,teacher,room});await v2Save('timetable',v2.timetable);await v2Audit('Timetable entry added',`${cls} ${day} Period ${period} — ${subject}`);v2RenderTimetable();}
async function v2DeleteTT(id){v2.timetable=v2.timetable.filter(x=>x.id!==id);await v2Save('timetable',v2.timetable);v2RenderTimetable();}
function v2RenderTimetable(){const sel=document.getElementById('v2ttClass');if(!sel)return;const old=sel.value;sel.innerHTML=(settings?.classes||[]).map(c=>`<option>${v2Esc(c)}</option>`).join('');if(old)sel.value=old;const cls=sel.value,day=document.getElementById('v2ttDay').value;const rows=v2.timetable.filter(x=>x.cls===cls&&x.day===day).sort((a,b)=>String(a.period).localeCompare(String(b.period),undefined,{numeric:true}));document.getElementById('v2TimetableList').innerHTML=rows.length?'<div class="v2-list">'+rows.map(x=>`<div class="v2-row"><span><b>P${v2Esc(x.period)} — ${v2Esc(x.subject)}</b><br><span class="muted">${v2Esc(x.teacher||'')} ${x.room?'· Room '+v2Esc(x.room):''}</span></span><button class="btn small danger" onclick="v2DeleteTT('${v2Esc(x.id)}')">×</button></div>`).join('')+'</div>':'<div class="v2-empty">No timetable entries.</div>';}
async function v2AddAccounting(){const type=document.getElementById('v2AcctType').value,category=document.getElementById('v2AcctCategory').value.trim()||'Other',title=document.getElementById('v2AcctTitle').value.trim(),amount=Number(document.getElementById('v2AcctAmount').value||0);if(amount<=0||!title){toast('Description and positive amount are required');return}v2.accounting.unshift({id:'AC'+Date.now(),date:new Date().toISOString().slice(0,10),type,category,title,amount});await v2Save('accounting',v2.accounting);await v2Audit('Accounting entry posted',`${type}: ${title} — ${v2Money(amount)}`);document.getElementById('v2AcctTitle').value='';document.getElementById('v2AcctAmount').value='';v2RenderAccounting();v2RenderKpis();}
async function v2DeleteAccounting(id){v2.accounting=v2.accounting.filter(x=>x.id!==id);await v2Save('accounting',v2.accounting);v2RenderAccounting();v2RenderKpis();}
function v2RenderAccounting(){const box=document.getElementById('v2AccountingList');if(!box)return;box.innerHTML=v2.accounting.slice(0,20).map(x=>`<div class="v2-row"><span><b>${v2Esc(x.title)}</b><br><span class="muted">${v2Esc(x.date)} · ${v2Esc(x.category)}</span></span><span class="${x.type==='income'?'v2-success':'v2-danger'}">${x.type==='income'?'+':'-'}${v2Money(x.amount)} <button class="btn small ghost" onclick="v2DeleteAccounting('${v2Esc(x.id)}')">×</button></span></div>`).join('')||'<div class="v2-empty">No manual accounting entries.</div>';}
function v2RenderFinance(){const income=(v2.accounting.filter(x=>x.type==='income').reduce((a,x)=>a+x.amount,0))+(vouchers||[]).reduce((a,x)=>a+Number(x.paid||0),0);const expense=v2.accounting.filter(x=>x.type==='expense').reduce((a,x)=>a+x.amount,0)+(expenses||[]).reduce((a,x)=>a+Number(x.amount||0),0);document.getElementById('v2FinanceKpis').innerHTML=`<div class="v2-mini"><small>Income</small><b>${v2Money(income)}</b></div><div class="v2-mini"><small>Expenses</small><b>${v2Money(expense)}</b></div><div class="v2-mini"><small>Net</small><b>${v2Money(income-expense)}</b></div>`;}
async function v2AddSession(){const name=document.getElementById('v2SessionName').value.trim();if(!name){toast('Enter a session name');return}v2.sessions.forEach(x=>x.active=false);v2.sessions.unshift({id:'S'+Date.now(),name,active:true,createdAt:new Date().toISOString()});await v2Save('sessions',v2.sessions);await v2Audit('Academic session created',name);document.getElementById('v2SessionName').value='';v2RenderSessions();}
function v2RenderSessions(){document.getElementById('v2Sessions').innerHTML=v2.sessions.map(x=>`<div class="v2-row"><span><b>${v2Esc(x.name)}</b> ${x.active?'<span class="v2-badge">ACTIVE</span>':''}<br><span class="muted">Created ${v2Esc(x.createdAt.slice(0,10))}</span></span></div>`).join('');}
async function v2PromoteSession(){if(!students?.length){toast('No students found');return}const classes=settings?.classes||[];const active=students.filter(s=>!s.status||s.status==='Active');const eligible=active.filter(s=>classes.indexOf(s.class)>=0&&classes.indexOf(s.class)<classes.length-1);if(!eligible.length){toast('No eligible students for promotion');return}if(!confirm(`Promote ${eligible.length} active student(s) to the next configured class?`))return;let count=0;const targetSession=v2.sessions.find(x=>x.active)?.name||'';students.forEach(s=>{if(!s.status||s.status==='Active'){const i=classes.indexOf(s.class);if(i>=0&&i<classes.length-1){s.previousClass=s.class;s.class=classes[i+1];if(targetSession)s.session=targetSession;count++;}}});await saveStudents();await v2Audit('Bulk promotion executed',`${count} active students moved to next configured class/session ${targetSession}`);renderAll();v2RenderStudents();toast(`Promoted ${count} student(s)`);}
function v2RenderNotifications(){const due=(vouchers||[]).reduce((a,v)=>a+Number(v.balance||0),0),abs=(attendance||[]).filter(a=>a.date===new Date().toISOString().slice(0,10)).reduce((a,e)=>a+(e.records||[]).filter(r=>r.status==='Absent').length,0),low=(students||[]).filter(s=>s.status==='Active').filter(s=>{const rs=(attendance||[]).flatMap(a=>a.records||[]).filter(r=>r.studentId===s.id);return rs.length&&rs.filter(r=>r.status==='Present').length/rs.length<.75}).length;const box=document.getElementById('v2Notifications');box.innerHTML=`<div class="v2-notice ${due?'warn':''}">💰 Outstanding fee balance: <b>${v2Money(due)}</b></div><div class="v2-notice ${abs?'warn':''}">🗓 Today's recorded absences: <b>${abs}</b></div><div class="v2-notice ${low?'warn':''}">⚠️ Students below 75% recorded attendance: <b>${low}</b></div><div class="v2-notice">💾 Backup: use Settings → Database Backup & Export for an immediate verified workbook backup.</div>`;}
function v2RenderParent(){const id=document.getElementById('v2StudentSelect')?.value,s=students?.find(x=>x.id===id)||students?.[0];const box=document.getElementById('v2ParentPortal');if(!s){box.innerHTML='<div class="v2-empty">No students available.</div>';return}const vs=(vouchers||[]).filter(v=>v.studentId===s.id),due=vs.reduce((a,v)=>a+Number(v.balance||0),0);box.innerHTML=`<div class="parent-top"><div><b>${v2Esc(s.name)}</b><div class="muted">${v2Esc(s.class||'')} · Guardian: ${v2Esc(s.fatherName||s.guardianName||'—')}</div></div><span class="v2-badge">PARENT VIEW</span></div><div><span class="parent-stat">Fee Due<br><b>${v2Money(due)}</b></span><span class="parent-stat">Vouchers<br><b>${vs.length}</b></span><span class="parent-stat">Status<br><b>${v2Esc(s.status||'Active')}</b></span></div>`;}
function v2RenderAudit(){const box=document.getElementById('v2Audit');if(!box)return;box.innerHTML=v2.audit.slice(0,30).map(x=>`<div class="v2-row"><span><b>${v2Esc(x.action)}</b><br><span class="muted">${v2Esc(x.user)} · ${v2Esc(x.at.replace('T',' ').slice(0,19))}</span></span><span>${v2Esc(x.detail)}</span></div>`).join('')||'<div class="v2-empty">No V2 audit entries yet.</div>';}
function v2RenderMessages(){const box=document.getElementById('v2MsgHistory');if(!box)return;box.innerHTML=v2.messages.slice(0,5).map(x=>{const s=students?.find(y=>y.id===x.studentId);return `<div class="v2-row"><span>${v2Esc(s?.name||'Unknown')} · ${v2Esc(x.type)}</span><span class="muted">${v2Esc(x.at.slice(0,16).replace('T',' '))}</span></div>`}).join('')||'';}
async function v2CloseDay(){const date=new Date().toISOString().slice(0,10);if(v2.cashClosings.some(x=>x.date===date)){toast('Today is already closed');return}const cash=Number(document.getElementById('v2CashActual')?.value||0),bank=Number(document.getElementById('v2BankActual')?.value||0),notes=document.getElementById('v2CashNotes')?.value.trim()||'';const feeCash=(vouchers||[]).filter(v=>v.date===date).reduce((a,v)=>a+Number(v.paid||0),0);const expensesToday=(expenses||[]).filter(x=>x.date===date).reduce((a,x)=>a+Number(x.amount||0),0);const expected=feeCash-expensesToday;const rec={id:'CC'+Date.now(),date,expected,cash,bank,notes,createdAt:new Date().toISOString()};v2.cashClosings.unshift(rec);await v2Save('cashClosings',v2.cashClosings);await v2Audit('Daily cash closing',`${date}: expected ${v2Money(expected)}, cash ${v2Money(cash)}, bank ${v2Money(bank)}`);v2RenderCash();toast('Today cash closing saved');}
function v2RenderCash(){const date=new Date().toISOString().slice(0,10),feeCash=(vouchers||[]).filter(v=>v.date===date).reduce((a,v)=>a+Number(v.paid||0),0),exp=(expenses||[]).filter(x=>x.date===date).reduce((a,x)=>a+Number(x.amount||0),0),expected=feeCash-exp;const box=document.getElementById('v2CashSummary');if(box)box.innerHTML=`<div class="v2-mini"><small>Fees recorded</small><b>${v2Money(feeCash)}</b></div><div class="v2-mini"><small>Expenses</small><b>${v2Money(exp)}</b></div><div class="v2-mini"><small>Expected net</small><b>${v2Money(expected)}</b></div>`;const h=document.getElementById('v2CashHistory');if(h)h.innerHTML=v2.cashClosings.slice(0,5).map(x=>`<div class="v2-row"><span><b>${v2Esc(x.date)}</b><br><span class="muted">Expected ${v2Money(x.expected)}</span></span><span>Cash ${v2Money(x.cash)} · Bank ${v2Money(x.bank)}</span></div>`).join('')||'<div class="v2-empty">No daily closing recorded.</div>';}
function v2RunHealth(){const active=(students||[]).filter(s=>!s.status||s.status==='Active'),ids=new Set(),dupes=[],missing=0;active.forEach(s=>{if(ids.has(s.id))dupes.push(s.id);ids.add(s.id);if(!s.name||!s.class)missing++;});const due=(vouchers||[]).reduce((a,v)=>a+Number(v.balance||0),0);const box=document.getElementById('v2Health');if(!box)return;box.innerHTML=`<div class="v2-check ${missing?'warn':'ok'}">${missing?'⚠️':'✓'} Active students missing name/class: <b>${missing}</b></div><div class="v2-check ${dupes.length?'warn':'ok'}">${dupes.length?'⚠️':'✓'} Duplicate student IDs: <b>${dupes.length}</b></div><div class="v2-check ${due?'warn':'ok'}">${due?'💰':'✓'} Outstanding fee balance: <b>${v2Money(due)}</b></div><div class="v2-check ok">✓ Configured classes: <b>${(settings?.classes||[]).length}</b> · Active students: <b>${active.length}</b></div>`;}
function v2RenderKpis(){const active=(students||[]).filter(s=>!s.status||s.status==='Active').length;const due=(vouchers||[]).reduce((a,v)=>a+Number(v.balance||0),0);const staffN=(staff||[]).length;const today=new Date().toISOString().slice(0,10);const abs=(attendance||[]).filter(a=>a.date===today).reduce((a,e)=>a+(e.records||[]).filter(r=>r.status==='Absent').length,0);const income=(v2.accounting.filter(x=>x.type==='income').reduce((a,x)=>a+x.amount,0))+(vouchers||[]).reduce((a,x)=>a+Number(x.paid||0),0);document.getElementById('v2Kpis').innerHTML=[['Students',active],['Staff',staffN],['Fee Due',v2Money(due)],['Today Absent',abs],['Collected',v2Money(income)],['Audit Events',v2.audit.length]].map(x=>`<div class="v2-kpi"><div class="n">${x[1]}</div><div class="l">${x[0]}</div></div>`).join('');v2RenderFinance();}
function v2RenderAll(){v2RenderKpis();v2RenderStudents();v2RenderTimetable();v2RenderAccounting();v2RenderSessions();v2RenderNotifications();v2RenderAudit();v2RenderMessages();v2BuildMessage();v2RenderParent();v2RenderCash();v2RunHealth();}
window.v2RenderStudents=v2RenderStudents;window.v2ShowStudent=v2ShowStudent;window.v2BuildMessage=v2BuildMessage;window.v2OpenWhatsApp=v2OpenWhatsApp;window.v2AddTimetable=v2AddTimetable;window.v2DeleteTT=v2DeleteTT;window.v2AddAccounting=v2AddAccounting;window.v2DeleteAccounting=v2DeleteAccounting;window.v2AddSession=v2AddSession;window.v2PromoteSession=v2PromoteSession;
window.v2CloseDay=v2CloseDay;window.v2RunHealth=v2RunHealth;window.v2ClearAudit=async()=>{if(confirm('Clear the V2 audit log?')){v2.audit=[];await v2Save('audit',[]);v2RenderAudit();}};
window.v2RefreshAll=()=>{v2RenderAll();toast('Management Hub refreshed');};
window.v2ExportData=()=>{if(remoteFeatureLocked('enableDataExport')){toast('Data export has been disabled by the administrator');return;}const blob=new Blob([JSON.stringify({exportedAt:new Date().toISOString(),school:settings?.school||{},timetable:v2.timetable,accounting:v2.accounting,sessions:v2.sessions,audit:v2.audit,messages:v2.messages,cashClosings:v2.cashClosings},null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='Al-Noor-ERP-V2-Data-'+new Date().toISOString().slice(0,10)+'.json';a.click();URL.revokeObjectURL(a.href);};
function v2Activate(){document.querySelectorAll('.v2-tab-ignore').forEach(x=>x.remove());document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));const b=document.querySelector('.tab-btn[data-tab="v2hub"]');b?.classList.add('active');document.getElementById('panel-v2hub')?.classList.add('active');v2RenderAll();}
function v2Init(){const b=document.querySelector('.tab-btn[data-tab="v2hub"]');if(!b)return;b.addEventListener('click',v2Activate);document.getElementById('v2ttClass')?.addEventListener('change',v2RenderTimetable);document.getElementById('v2ttDay')?.addEventListener('change',v2RenderTimetable);document.getElementById('v2MsgStudent')?.addEventListener('change',v2BuildMessage);v2Load();}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',v2Init);else v2Init();
setInterval(()=>{const b=document.querySelector('.tab-btn[data-tab="v2hub"]');if(b&&typeof currentUser!=='undefined'&&currentUser){b.style.display=(currentUser.role==='AnjumWebsDeveloper'||currentUser.role==='Super Admin')?'':'none';}},1000);
})();
</script>
