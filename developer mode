   this is literally "what the Developer activated for them." 'settings'
   is excluded unconditionally: School Settings is Developer-mode only,
   never licensable to a Super Admin, no matter what. */
function licensedTabsForSchool(school){
  return ALL_TABS.filter(t=>t!=='settings').filter(t=>isTabLicensed(t, school));
}
function licensedAssignableTabs(school){
  return STAFF_ASSIGNABLE_TABS.filter(t=>isTabLicensed(t, school));
