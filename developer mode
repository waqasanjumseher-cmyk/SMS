  document.getElementById('rc_saveStatusBtn').addEventListener('click', async ()=>{
    const newStatus = document.getElementById('rc_status').value;
    const newMessage = document.getElementById('rc_message').value.trim();
    try{
      await firebaseDb.collection('clients').doc(schoolId).set({ status: newStatus, message: newMessage, updatedAt: new Date().toISOString() }, {merge:true});
      toast(`Kill-switch: ${school.name} set to ${newStatus}`);
    }catch(e){ console.error(e); toast('Failed to save — check connection'); }
  });

  document.getElementById('rc_saveLocksBtn').addEventListener('click', async ()=>{
    const newLocks = {};
    document.querySelectorAll('.rc-lock').forEach(cb=>{ newLocks[cb.dataset.key] = cb.checked; });
    try{
      await firebaseDb.collection('clients').doc(schoolId).set({ lockedFeatures: newLocks }, {merge:true});
