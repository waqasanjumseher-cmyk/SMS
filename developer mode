        <option value="Suspended" ${status==='Suspended'?'selected':''}>Suspended</option>
        <option value="Blocked" ${status==='Blocked'?'selected':''}>Blocked</option>
      </select>
      <label>Broadcast Message (shown to the school while locked)</label>
      <textarea id="rc_message" rows="2" placeholder="e.g. Subscription Suspended — Contact Support">${escapeHtml(message)}</textarea>
      <button class="btn small gold" id="rc_saveStatusBtn" style="margin-top:8px;">Save Kill-Switch</button>
    </div>

    <div class="card" style="margin-bottom:14px;">
      <h3 style="margin:0 0 8px;font-size:14px;color:var(--navy-2);">🧩 Granular Feature Locks</h3>
      ${Object.keys(LOCK_LABELS).map(key => `
        <label class="checkfee">
          <input type="checkbox" class="rc-lock" data-key="${key}" ${lf[key]===false ? '' : 'checked'}>
          <span>${LOCK_LABELS[key]}</span>
        </label>`).join('')}
      <p class="muted" style="font-size:11.5px;margin-top:6px;">Unchecked = disabled remotely. These only ever narrow what Quick Settings has already licensed — never grant more.</p>
      <button class="btn small gold" id="rc_saveLocksBtn" style="margin-top:4px;">Save Feature Locks</button>
    </div>

    <div class="card" style="margin-bottom:14px;">
      <h3 style="margin:0 0 8px;font-size:14px;color:var(--navy-2);">🏷 Branding &amp; Watermark</h3>
      <label>Voucher Footer Text</label>
      <input type="text" id="rc_footerText" value="${escapeHtml(br.footerText||'')}" placeholder="Appears on every fee voucher, below the school's own note">
      <label>Developer Credit Line</label>
