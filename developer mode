/* ============================== PHASE 6 ==============================
   Offline Queue & Mutation Manager — source: erp_sync_queue.js (unmodified)
   ======================================================================= */
/* =========================================================================
   ERP OFFLINE QUEUE & MUTATION MANAGER — Phase 6
   =========================================================================
   Self-contained. Uses its own dedicated IndexedDB database for the sync
   queue (separate from Phase 5's 'erp_database') so this module never has
   to coordinate a version bump with ERPDatabase's connection — it can be
   dropped in without editing the Phase 5 file at all. The STORE is named
   'sync_queue' as requested; which physical database it lives in is an
   implementation detail the rest of the app never needs to know about.

   THE CORE IDEA, spelled out:
   Two separate concerns that are easy to conflate:
     1. Applying a mutation to LOCAL data (student records, ledger rows,
        attendance, transactions) — this already happens instantly and
        fully offline via Phase 5's ERPDatabase, because IndexedDB is a
        local, on-device database. It was never waiting on the network to
        begin with.
     2. Remembering that this mutation ALSO needs to reach a remote
        server once connectivity returns — that's what sync_queue is for.
   So the pattern this module implements is: apply the mutation to
   ERPDatabase's real store immediately (point 2 in the task — "process
   instantly... without needing cloud confirmation" — is satisfied simply
   by not waiting on anything network-related), and IN PARALLEL, when the
   system is offline, log an entry to sync_queue describing what happened
   so a future sync pass can replay it against a server. The queue is a
   TODO list for eventual cloud sync, not a blocker for local usability.
   ========================================================================= */

const ERPSyncQueue = (function () {
  'use strict';

  if (typeof window === 'undefined' || !window.indexedDB) {
    throw new Error('ERPSyncQueue requires a browser with IndexedDB support.');
  }

  const DB_NAME = 'erp_sync_queue_db';
  const DB_VERSION = 1;
  const STORE_NAME = 'sync_queue';

  /* =======================================================================
     1. DATABASE OPEN / UPGRADE — just the one store
     ======================================================================= */

  let dbPromise = null;

  function openDatabase() {
    if (dbPromise) return dbPromise;

    dbPromise = new Promise((resolve, reject) => {
      const request = indexedDB.open(DB_NAME, DB_VERSION);

      request.onupgradeneeded = (event) => {
        const db = event.target.result;
        if (!db.objectStoreNames.contains(STORE_NAME)) {
          const store = db.createObjectStore(STORE_NAME, { keyPath: 'id', autoIncrement: true });
          store.createIndex('status', 'status', { unique: false });
          store.createIndex('timestamp', 'timestamp', { unique: false });
          store.createIndex('store', 'store', { unique: false });
          store.createIndex('action', 'action', { unique: false });
        }
      };

      request.onsuccess = (event) => {
        const db = event.target.result;
        db.onversionchange = () => { db.close(); dbPromise = null; };
        resolve(db);
      };

      request.onerror = () => {
        dbPromise = null;
        reject(new Error(`ERPSyncQueue: failed to open database — ${request.error && request.error.message}`));
      };
    });

    return dbPromise;
  }

  async function runTransaction(mode, work) {
    const db = await openDatabase();
    return new Promise((resolve, reject) => {
      const tx = db.transaction(STORE_NAME, mode);
      const store = tx.objectStore(STORE_NAME);
      let result;

      tx.oncomplete = () => resolve(result);
      tx.onerror = () => reject(new Error(`ERPSyncQueue: transaction failed — ${tx.error && tx.error.message}`));
      tx.onabort = () => reject(new Error(`ERPSyncQueue: transaction aborted — ${tx.error && tx.error.message}`));

      try {
        const maybeRequest = work(store);
        if (maybeRequest && typeof maybeRequest.onsuccess !== 'undefined') {
          maybeRequest.onsuccess = () => { result = maybeRequest.result; };
        } else {
          result = maybeRequest;
        }
      } catch (e) {
        reject(e);
      }
    });
  }

  /* =======================================================================
     2. MUTATION QUEUE
     ------------------------------------------------------------------------
     Queue record shape:
       {
         id: number (auto),
         action: 'ADD' | 'UPDATE' | 'DELETE',
         store: string,        // target ERPDatabase store, e.g. 'fee_sales_ledger'
         payload: object,      // the record data (for ADD/UPDATE) or { id } (for DELETE)
         timestamp: string (ISO),
         status: 'pending' | 'processed' | 'failed',
         attempts: number,
         lastError: string|null
       }
     ======================================================================= */

  /**
   * queueOfflineAction(action, store, payload)
   * Records a mutation that happened while offline, so it can be replayed
   * against a remote server once connectivity returns. Call this
   * alongside (not instead of) the actual local write — see
   * applyOfflineSafeMutation() below for a wrapper that does both in one
   * call.
   *
   * @param {'ADD'|'UPDATE'|'DELETE'} action
   * @param {string} store       target ERPDatabase store name this mutation belongs to
   * @param {object} payload     the record (ADD/UPDATE) or { id } (DELETE)
   * @returns {Promise<object>} the queued entry, including its id
   */
  async function queueOfflineAction(action, store, payload) {
    if (!['ADD', 'UPDATE', 'DELETE'].includes(action)) {
      throw new Error(`queueOfflineAction: action must be ADD, UPDATE, or DELETE (got "${action}").`);
    }
    if (!store) throw new Error('queueOfflineAction: store name is required.');
    if (!payload) throw new Error('queueOfflineAction: payload is required.');

    const entry = {
      action,
      store,
      payload,
      timestamp: new Date().toISOString(),
      status: 'pending',
      attempts: 0,
      lastError: null
    };

    const newId = await runTransaction('readwrite', (objectStore) => objectStore.add(entry));
    return { ...entry, id: newId };
  }

  /**
   * getPendingQueue()
   * Returns every queued mutation still waiting to be synced, oldest
   * first — the order a sync processor should replay them in, so writes
   * land on the server in the same order they happened locally.
   * @returns {Promise<object[]>}
   */
  async function getPendingQueue() {
    const all = await runTransaction('readonly', (objectStore) => {
      const index = objectStore.index('status');
      return index.getAll('pending');
    }) || [];

    return all.sort((a, b) => new Date(a.timestamp) - new Date(b.timestamp));
  }

  /**
   * markQueueItemProcessed(id)
   * Call this once a queued mutation has been successfully synced to the
   * server, so it stops showing up in getPendingQueue().
   * @param {number} id
   */
  async function markQueueItemProcessed(id) {
    const entry = await runTransaction('readonly', (objectStore) => objectStore.get(id));
    if (!entry) return;
    entry.status = 'processed';
    await runTransaction('readwrite', (objectStore) => objectStore.put(entry));
  }

  /**
   * markQueueItemFailed(id, errorMessage)
   * Call this when a sync attempt for a queued mutation fails (network
   * error, server rejected it, etc). Keeps it in the queue as 'failed'
   * with an incremented attempt count and the error recorded, rather than
   * silently dropping it or leaving it stuck as 'pending' forever with no
   * diagnostic trail.
   * @param {number} id
   * @param {string} errorMessage
   */
  async function markQueueItemFailed(id, errorMessage) {
    const entry = await runTransaction('readonly', (objectStore) => objectStore.get(id));
    if (!entry) return;
    entry.status = 'failed';
    entry.attempts = (entry.attempts || 0) + 1;
    entry.lastError = errorMessage || 'Unknown error';
    await runTransaction('readwrite', (objectStore) => objectStore.put(entry));
  }

  /**
   * requeueFailedItems()
   * Flips every 'failed' entry back to 'pending' so the next sync pass
   * retries them — call this e.g. when connectivity is restored after a
   * spell of failures, rather than requiring a manual per-item retry.
   * @returns {Promise<number>} how many entries were requeued
   */
  async function requeueFailedItems() {
    const failed = await runTransaction('readonly', (objectStore) => {
      const index = objectStore.index('status');
      return index.getAll('failed');
    }) || [];

    for (const entry of failed) {
      entry.status = 'pending';
      await runTransaction('readwrite', (objectStore) => objectStore.put(entry));
    }
    return failed.length;
  }

  /**
   * clearProcessedQueue()
   * Deletes every entry marked 'processed' — cleanup after a successful
   * sync run so the queue doesn't grow forever. Leaves 'pending' and
   * 'failed' entries untouched.
   * @returns {Promise<number>} how many entries were removed
   */
  async function clearProcessedQueue() {
    const processed = await runTransaction('readonly', (objectStore) => {
      const index = objectStore.index('status');
      return index.getAll('processed');
    }) || [];

    await runTransaction('readwrite', (objectStore) => {
      processed.forEach(entry => objectStore.delete(entry.id));
    });

    return processed.length;
  }

  /**
   * getQueueStats()
   * Small convenience summary — handy for a "N changes waiting to sync"
   * badge in the UI.
   * @returns {Promise<{pending:number, processed:number, failed:number}>}
   */
  async function getQueueStats() {
    const all = await runTransaction('readonly', (objectStore) => objectStore.getAll()) || [];
    return {
      pending: all.filter(e => e.status === 'pending').length,
      processed: all.filter(e => e.status === 'processed').length,
      failed: all.filter(e => e.status === 'failed').length
    };
  }

  /* =======================================================================
     3. OFFLINE-SAFE MUTATION WRAPPER
     ------------------------------------------------------------------------
     Ties Phase 5 (ERPDatabase) and the queue together: applies the
     mutation to the real local store right away (instant, offline-capable
     by construction — IndexedDB doesn't touch the network), and only
     queues a sync-queue entry when the browser reports itself offline.
     If ERPDatabase isn't loaded, this piece is skipped gracefully — the
     queue functions above still work standalone against whatever store
     name you pass.
     ======================================================================= */

  function isOffline() {
    return typeof navigator !== 'undefined' && navigator.onLine === false;
  }

  /**
   * applyOfflineSafeMutation(action, store, payload)
   * Convenience wrapper for the common case: perform an ADD/UPDATE/DELETE
   * against a real ERPDatabase store, applying it locally immediately
   * either way, and queueing it for later cloud sync only if currently
   * offline (if online, the caller is expected to sync it directly —
   * this wrapper doesn't assume there's always a server call to make).
   *
   * @param {'ADD'|'UPDATE'|'DELETE'} action
   * @param {string} store    an ERPDatabase (Phase 5) store name
   * @param {object} payload  full record for ADD/UPDATE, or { id } for DELETE
   * @returns {Promise<{ result: object|undefined, queued: boolean, queueEntry: object|null }>}
   */
  async function applyOfflineSafeMutation(action, store, payload) {
    if (typeof ERPDatabase === 'undefined') {
      throw new Error('applyOfflineSafeMutation: the Phase 5 ERPDatabase module must be loaded to apply local mutations.');
    }

    let result;
    if (action === 'ADD') result = await ERPDatabase.dbInsert(store, payload);
    else if (action === 'UPDATE') result = await ERPDatabase.dbUpdate(store, payload);
    else if (action === 'DELETE') { await ERPDatabase.dbDelete(store, payload.id); result = undefined; }
    else throw new Error(`applyOfflineSafeMutation: unknown action "${action}".`);

    if (isOffline()) {
      const queueEntry = await queueOfflineAction(action, store, action === 'DELETE' ? { id: payload.id } : result || payload);
      return { result, queued: true, queueEntry };
    }

    return { result, queued: false, queueEntry: null };
  }

  /* =======================================================================
     4. INSTANT OFFLINE LEDGER CALCULATION
     ------------------------------------------------------------------------
     "Process instantly offline... without needing cloud confirmation" —
     this is naturally true for any read/aggregate against ERPDatabase,
     since it's a local, synchronous-feeling on-device query. This helper
     is provided as a concrete example: computing a student's running fee
     balance and payment status purely from local ledger rows.
     ======================================================================= */

  /**
   * computeLedgerStatus(studentId)
   * Sums charges vs payments for a student from the local
   * 'fee_sales_ledger' store and derives a payment status — entirely
   * offline, no network round-trip, no waiting on a server to "confirm"
   * the number.
   * @param {number|string} studentId
   * @returns {Promise<{
   *   studentId: number|string,
   *   totalCharged: number,
   *   totalPaid: number,
   *   balance: number,
   *   status: 'paid'|'partial'|'unpaid'|'no-records'
   * }>}
   */
  async function computeLedgerStatus(studentId) {
    if (typeof ERPDatabase === 'undefined') {
      throw new Error('computeLedgerStatus: the Phase 5 ERPDatabase module must be loaded.');
    }

    const rows = await ERPDatabase.dbGetByIndex('fee_sales_ledger', 'studentId', studentId);
    if (rows.length === 0) {
      return { studentId, totalCharged: 0, totalPaid: 0, balance: 0, status: 'no-records' };
    }

    const totalCharged = rows.reduce((sum, r) => sum + (Number(r.charged) || 0), 0);
    const totalPaid = rows.reduce((sum, r) => sum + (Number(r.paid) || 0), 0);
    const balance = totalCharged - totalPaid;

    let status;
    if (balance <= 0) status = 'paid';
    else if (totalPaid > 0) status = 'partial';
    else status = 'unpaid';

    return { studentId, totalCharged, totalPaid, balance, status };
  }

  /* =======================================================================
     PUBLIC API
     ======================================================================= */
  return {
    // Requested primary methods
    queueOfflineAction,
    getPendingQueue,
    clearProcessedQueue,

    // Queue lifecycle support
    markQueueItemProcessed,
    markQueueItemFailed,
    requeueFailedItems,
    getQueueStats,

    // Local-first mutation + read helpers
    applyOfflineSafeMutation,
    computeLedgerStatus,

    isOffline
  };
})();

if (typeof module !== 'undefined' && module.exports) {
  module.exports = ERPSyncQueue;
}

