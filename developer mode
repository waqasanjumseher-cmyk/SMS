  /* ---- Universal Hex-Code Theme Customizer (Developer Console + School Settings) ---- */
  .hex-customizer{display:flex;flex-direction:column;gap:10px;margin-top:10px;}
  .hex-row{display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:8px 0;border-bottom:1px dashed var(--line);}
  .dcc-tab-pane .hex-row{border-bottom-color:var(--dcc-border);}
  .hex-row .hex-label{flex:1 1 220px;font-size:12.5px;font-weight:600;color:var(--ink);}
  .dcc-tab-pane .hex-row .hex-label{color:var(--dcc-text-dim);}
  .hex-row input[type="color"]{
    width:38px;height:34px;padding:2px;border:1px solid var(--line);border-radius:6px;cursor:pointer;background:none;
  }
  .hex-row input[type="text"].hex-text{
    width:110px;padding:7px 9px;border:1px solid var(--line);border-radius:6px;font-size:13px;font-family:monospace;
    text-transform:uppercase;
  }
  .hex-customizer-actions{display:flex;gap:10px;margin-top:6px;}

  /* ---- Phase 2: Student Photo Upload ---- */
  .photo-upload-row{display:flex;gap:16px;align-items:flex-start;margin-top:10px;}
  .photo-preview{
    width:96px;height:112px;border-radius:8px;border:2px dashed var(--line);background:#fafaf7;
    display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:11px;
    flex-shrink:0;overflow:hidden;text-align:center;
  }
  .photo-preview img{width:100%;height:100%;object-fit:cover;}
  .photo-upload-controls{flex:1;}
  .photo-upload-controls input[type=file]{
    padding:8px;border:1px dashed var(--teal);background:var(--teal-light);cursor:pointer;
  }

  /* ---- Phase 2: Student Table Thumbnail ---- */
  .student-thumb{width:36px;height:36px;border-radius:6px;object-fit:cover;border:1px solid var(--line);display:block;}
  .student-thumb-empty{
    width:36px;height:36px;border-radius:6px;background:#eef0ef;border:1px solid var(--line);
    display:flex;align-items:center;justify-content:center;font-size:9px;color:var(--muted);text-align:center;
  }

  /* ---- Phase 2: Custom Fee Badge ---- */
  .pill.custom{background:#fbf1de;color:#9a6a14;}

  /* ---- Phase 2: Admission Slip Photo ---- */
  .admission-photo{
    width:92px;height:110px;border:1px solid var(--line);border-radius:6px;overflow:hidden;flex-shrink:0;
    display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:10.5px;background:#f4f4f2;text-align:center;
  }
  .admission-photo img{width:100%;height:100%;object-fit:cover;}
  /* ---- Phase 4: Attendance Absentee Alert ---- */
  .att-alert-col{white-space:nowrap;}
  .absentee-list{margin-top:10px;}
  .absentee-row{
    display:flex;align-items:center;justify-content:space-between;gap:10px;
    padding:7px 0;border-bottom:1px dashed var(--line);font-size:12.5px;
  }
  .absentee-row:last-child{border-bottom:none;}
  .absentee-name{font-weight:600;color:var(--navy-2);}

  /* ---- Phase 4: Premium Result Card ---- */
  .rc-grade-badge{
    position:absolute;top:18px;right:24px;width:56px;height:56px;border-radius:50%;
    display:flex;align-items:center;justify-content:center;font-size:17px;font-weight:800;color:#fff;
    box-shadow:0 5px 14px rgba(0,0,0,.18);border:2px solid #ffffffaa;flex-shrink:0;
  }
  .rc-grade-badge.excellent{background:linear-gradient(135deg,#1f7a6c,#28b79c);}
  .rc-grade-badge.good{background:linear-gradient(135deg,var(--gold),#e0a746);color:#2a1c00;}
  .rc-grade-badge.warn{background:linear-gradient(135deg,#c98a2c,#a85a1f);}
  .rc-grade-badge.fail{background:linear-gradient(135deg,var(--danger),#7d2c25);}
  .rc-grade-pill{padding:3px 13px;border-radius:20px;font-size:14px;font-weight:800;}
  .rc-grade-pill.excellent{background:#e2f3e6;color:#217a3c;}
  .rc-grade-pill.good{background:#fbf1de;color:#9a6a14;}
  .rc-grade-pill.warn{background:#fde8d5;color:#a2570f;}
  .rc-grade-pill.fail{background:#fbe7e5;color:var(--danger);}
  .rc-subjects-table td:nth-child(2), .rc-subjects-table td:nth-child(3), .rc-subjects-table td:nth-child(4),
  .rc-subjects-table th:nth-child(2), .rc-subjects-table th:nth-child(3), .rc-subjects-table th:nth-child(4){text-align:right;}
  .rc-subjects-total{font-weight:800;background:var(--teal-light);color:var(--navy-2);}
  .rc-subjects-total td{border-bottom:none !important;}

  /* ---- Phase 4: Live marks-validation highlight ---- */
  .subjObt.invalid, .subjTot.invalid{
    border-color:var(--danger) !important;background:#fbe7e5 !important;color:var(--danger);
  }
  /* ---- Phase 5: Theme Presets ---- */
  :root[data-theme="teal"]{
    --ink:#132420; --navy:#0f5c52; --navy-2:#0b453d; --sidebar-bg:#0b453d; --teal:#159c86; --teal-light:#e1f5f1;
    --gold:#c98a2c; --paper:#f3f8f6; --card:#ffffff; --line:#d7e4e0; --muted:#5c7d76; --danger:#b5443a;
  }
  :root[data-theme="burgundy"]{
    --ink:#2a1418; --navy:#7a1f2b; --navy-2:#511019; --sidebar-bg:#511019; --teal:#b46b3c; --teal-light:#f7e9e6;
    --gold:#c98a2c; --paper:#f8f1ef; --card:#ffffff; --line:#e6d3d1; --muted:#8a6a6a; --danger:#8f2626;
  }
  :root[data-theme="slate"]{
    --ink:#1e2530; --navy:#3d4a5c; --navy-2:#2b3644; --sidebar-bg:#2b3644; --teal:#5b7a8c; --teal-light:#eaeff2;
    --gold:#b8923f; --paper:#f2f3f5; --card:#ffffff; --line:#dde1e6; --muted:#69737f; --danger:#b5443a;
  }
  :root[data-theme="dark"]{
    --ink:#e6ebf1; --navy:#1c3a5c; --navy-2:#13293f; --sidebar-bg:#13293f; --teal:#2bb3a0; --teal-light:#173630;
    --gold:#e0a746; --paper:#0e141b; --card:#171f29; --line:#2b3542; --muted:#8b97a6; --danger:#e0655a;
  }

  /* ---- Phase 5: Theme Switcher ---- */
  .theme-swatches{display:flex;gap:10px;flex-wrap:wrap;margin-top:8px;}
  .theme-swatch-btn{
    display:flex;align-items:center;gap:8px;background:#fcfcfa;border:2px solid var(--line);
    border-radius:8px;padding:8px 14px;cursor:pointer;font-size:12.5px;font-weight:600;color:var(--ink);
  }
  .theme-swatch-btn .swatch{width:16px;height:16px;border-radius:50%;border:1px solid #ffffff55;flex-shrink:0;}
  .theme-swatch-btn.active{border-color:var(--teal);background:var(--teal-light);color:var(--navy-2);}
  .theme-swatch-btn:hover{border-color:var(--teal);}

  /* ---- Phase 5: Bulk Promotion ---- */
  .promo-toolbar{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-top:6px;}
  .promo-toolbar button{margin-top:0;}
  table td.promo-check-cell{text-align:center;}
  .promoChk{width:auto;}
  .grade-tag{padding:2px 8px;border-radius:12px;font-size:11px;font-weight:700;background:var(--teal-light);color:var(--navy-2);}
  .grade-tag.fail{background:#fbe7e5;color:var(--danger);}

  /* ---- Phase 6: Wide print modal (reports / ledger) ---- */
  .modal-box.wide{max-width:920px;}

  /* ---- Phase 6: Period Report P&L emphasis ---- */
  #rpt_netPL{font-weight:800;}

  /* ---- Phase 6: Ledger student info grid ---- */
  .ledger-info-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px 18px;margin:12px 0 4px;}
  @media(max-width:760px){.ledger-info-grid{grid-template-columns:1fr 1fr;}}
  .ledger-info-grid div{font-size:12.5px;color:var(--ink);}
  .ledger-info-grid span{display:block;font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;margin-bottom:2px;}
  .ledger-info-grid b{color:var(--navy-2);}
  .ledger-academic-header{display:flex;gap:20px;align-items:flex-start;}
  .ledger-academic-header .ledger-info-wrap{flex:1;min-width:0;}
  .ledger-photo{width:90px;height:110px;border-radius:8px;overflow:hidden;background:#eef0ef;border:1px solid var(--line);
    display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:11px;flex-shrink:0;text-align:center;}
  .ledger-photo img{width:100%;height:100%;object-fit:cover;}
  @media(max-width:520px){.ledger-academic-header{flex-direction:column;}}
  .ledger-summary-bar{display:flex;gap:14px;flex-wrap:wrap;margin-top:16px;}
  /* ---- Phase 4B: Ledger screen view modes — button row + section
     visibility. 'combined' (default) lays academic and financial
     sections out side-by-side; 'edu'/'financial' hide the other. ---- */
  .ldg-view-btn.active{background:var(--teal);color:#fff;}
  .ledger-dual-columns{display:block;}
  #ledgerResult.view-combined .ledger-dual-columns{display:grid;grid-template-columns:1fr 1fr;gap:22px;align-items:start;}
  @media(max-width:860px){#ledgerResult.view-combined .ledger-dual-columns{grid-template-columns:1fr;}}
  #ledgerResult.view-edu .ledger-financial-section{display:none;}
  #ledgerResult.view-financial .ledger-academic-section{display:none;}
  .ledger-summary-bar .chip{
    flex:1;min-width:150px;background:var(--teal-light);border-radius:8px;padding:10px 14px;
  }
  .ledger-summary-bar .chip .lbl{font-size:10.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;font-weight:700;}
  .ledger-summary-bar .chip .val{font-size:17px;font-weight:800;color:var(--navy-2);margin-top:4px;}
  .ledger-summary-bar .chip.due .val{color:var(--danger);}
  tr.ledger-charge td{color:var(--ink);}
  tr.ledger-payment td{color:#217a3c;}
  tr.ledger-payment td:nth-child(4){font-weight:700;}
.session-spinner{width:30px;height:30px;margin:16px auto 4px;border-radius:50%;
  border:3px solid rgba(15,42,68,.15);border-top-color:var(--navy-2);animation:sessionSpin .8s linear infinite;}
@keyframes sessionSpin{to{transform:rotate(360deg);}}

/* ---- Bilingual (English / Urdu) support ---- */
.lang-switch{display:flex;border:1px solid #ffffff33;border-radius:20px;overflow:hidden;flex-shrink:0;}
.lang-switch button{
