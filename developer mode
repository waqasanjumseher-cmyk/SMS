/* ============================================================
   2) FEE COLLECTION MODULE
   ============================================================ */
/* Voucher auto-generation engine: fetches each student's own fee profile
   (monthly tuition, other recurring heads) and adds the one-time Admission
   Fee only when this is genuinely the student's first voucher and it
   hasn't already been charged. Used by both the single-voucher form below
   and the Bulk Installment Generator. */
function studentHasAnyVoucher(studentId){
  return vouchers.some(v=>v.studentId===studentId);
}
function admissionFeeAppliesTo(student){
  return !!student && !student.admissionFeeCharged && !studentHasAnyVoucher(student.id);
}
function buildAutoFeeItems(student){
  const items = [];
  const tuitionHead = settings.feeHeads.find(f=>isTuitionHeadName(f.name));
  items.push({
    name: tuitionHead ? tuitionHead.name : 'Monthly Tuition Fee',
    amount: Number(student.tuitionFee != null ? student.tuitionFee : tuitionFeeHeadDefault())
  });
  Object.entries(student.customFees || {}).forEach(([name, amt])=>{
    if(isTuitionHeadName(name) || isAdmissionHeadName(name)) return; // handled separately above/below
    items.push({name, amount:Number(amt||0)});
  });
  const admissionApplies = admissionFeeAppliesTo(student);
  if(admissionApplies){
    const admissionHead = settings.feeHeads.find(f=>isAdmissionHeadName(f.name));
    items.push({
      name: admissionHead ? admissionHead.name : 'Admission Fee',
      amount: Number(student.admissionFee != null ? student.admissionFee : admissionFeeHeadDefault()),
      oneTime: true
    });
  }
  return items;
}

function renderFeeHeads(studentId){
  const box = document.getElementById('feeHeadsList');
  const student = studentId ? students.find(s=>s.id===studentId) : null;

  if(!student){
    // No student picked yet — fall back to the plain school-wide fee head
    // list (minus Tuition/Admission, which only make sense per-student).
    box.innerHTML = otherRecurringFeeHeads().map(f=>`
      <div class="checkfee">
        <input type="checkbox" class="feeChk" data-name="${escapeHtml(f.name)}">
        <span>${escapeHtml(f.name)}</span>
        <input type="number" class="feeAmt" data-name="${escapeHtml(f.name)}" value="${f.amount}">
      </div>`).join('') || `<p class="muted">No fee heads configured. Add some in Settings.</p>`;
    box.querySelectorAll('.feeChk, .feeAmt').forEach(el=>el.addEventListener('input', updateFeeTotal));
    updateFeeTotal();
    return;
  }

  const autoItems = buildAutoFeeItems(student);
  const otherHeads = otherRecurringFeeHeads().filter(f=>!autoItems.some(it=>it.name===f.name));
  const custom = student.customFees || {};

  const autoRows = autoItems.map(it=>{
    const isAdmission = !!it.oneTime;
    const badge = isAdmission
      ? ' <span class="pill custom">One-time · first voucher</span>'
      : ' <span class="pill custom">Auto: this student\'s profile</span>';
    return `
    <div class="checkfee">
      <input type="checkbox" class="feeChk" data-name="${escapeHtml(it.name)}" checked>
      <span>${escapeHtml(it.name)}${badge}</span>
      <input type="number" class="feeAmt" data-name="${escapeHtml(it.name)}" value="${it.amount}">
    </div>`;
  }).join('');

  const otherRows = otherHeads.map(f=>{
    const hasCustom = Object.prototype.hasOwnProperty.call(custom, f.name);
    const amt = hasCustom ? custom[f.name] : f.amount;
    return `
    <div class="checkfee">
      <input type="checkbox" class="feeChk" data-name="${escapeHtml(f.name)}" ${hasCustom ? 'checked' : ''}>
      <span>${escapeHtml(f.name)}${hasCustom ? ' <span class="pill custom">Custom</span>' : ''}</span>
      <input type="number" class="feeAmt" data-name="${escapeHtml(f.name)}" value="${amt}">
    </div>`;
  }).join('');

  box.innerHTML = autoRows + otherRows || `<p class="muted">No fee heads configured. Add some in Settings.</p>`;
  box.querySelectorAll('.feeChk, .feeAmt').forEach(el=>el.addEventListener('input', updateFeeTotal));
  updateFeeTotal();
}

function updateFeeTotal(){
  let total = 0;
  document.querySelectorAll('#feeHeadsList .feeChk').forEach(chk=>{
    if(chk.checked){
      const amt = document.querySelector(`#feeHeadsList .feeAmt[data-name="${CSS.escape(chk.dataset.name)}"]`).value;
      total += Number(amt||0);
    }
  });
  document.getElementById('f_total').textContent = money(total);
  return total;
}

document.getElementById('genVoucherBtn').addEventListener('click', ()=>{
  const studentId = document.getElementById('f_student').value;
  const student = students.find(s=>s.id===studentId);
  if(!student){ toast('Select a student first'); return; }
  const month = document.getElementById('f_month').value;
  if(!month){ toast('Select the voucher month/period'); return; }

  const admissionHeadName = (settings.feeHeads.find(f=>isAdmissionHeadName(f.name)) || {}).name || 'Admission Fee';
  const items = [];
  let admissionIncluded = false;
  document.querySelectorAll('#feeHeadsList .feeChk').forEach(chk=>{
    if(chk.checked){
      const chkName = chk.dataset.name;
      const amt = Number(document.querySelector(`#feeHeadsList .feeAmt[data-name="${CSS.escape(chkName)}"]`).value||0);
      items.push({name: chkName, amount: amt});
      if(chkName === admissionHeadName) admissionIncluded = true;
    }
  });
  if(items.length===0){ toast('Select at least one fee head'); return; }

  const total = items.reduce((a,b)=>a+b.amount,0);
  const paid = Number(document.getElementById('f_paid').value||0);
  const status = document.getElementById('f_status').value;

  const voucher = {
    id: uid('FV'), studentId, month, items, total, paid,
    balance: total-paid, status, date: new Date().toISOString().slice(0,10)
  };
  vouchers.push(voucher);
  saveVouchers();
  if(admissionIncluded && !student.admissionFeeCharged){
    student.admissionFeeCharged = true;
    saveStudents();
  }
  renderVouchers();
  renderDashboard();
  toast('Voucher generated');
  showReceipt(voucher.id);
  resetFeeForm();
});

/* Bug fix: the student search combobox was left holding the selected
   student's full label text after a voucher was generated. Since the
   combobox re-filters its full candidate list against whatever text is
   currently in the input, that leftover text made every subsequent
   open of the dropdown match only that one student — looking like the
   rest of the students had vanished — until a full page refresh reset
   the input. This does NOT touch the `students` array itself (it was
   never mutated); it only resets the fee form's UI state so the combo
   re-reads the untouched, full `students` list on its next render. */
function resetFeeForm(){
  feeCombo.clear();
  document.getElementById('f_studentInfo').textContent = '';
  document.getElementById('f_paid').value = 0;
  document.getElementById('f_status').value = 'Unpaid';
  renderFeeHeads(); // no studentId -> falls back to the plain fee-head list
}

function renderVouchers(filter=''){
  const tbody = document.getElementById('voucherTable');
  const f = filter.toLowerCase();
  const rows = vouchers.filter(v=>{
    const s = students.find(x=>x.id===v.studentId);
    return s && (s.name.toLowerCase().includes(f) || s.roll.toLowerCase().includes(f));
  }).reverse();
  tbody.innerHTML = rows.map(v=>{
    const s = students.find(x=>x.id===v.studentId) || {name:'(deleted student)',roll:''};
    return `<tr>
      <td>${escapeHtml(s.name)}<br><span class="muted">${escapeHtml(s.roll)}</span></td>
      <td>${v.month}</td>
      <td>${money(v.total)}</td>
      <td><span class="pill ${v.status==='Paid'?'paid':'due'}">${v.status}</span></td>
      <td>
        <button class="btn small secondary" onclick="showReceipt('${v.id}')">Receipt</button>
        <button class="btn small danger" onclick="deleteVoucher('${v.id}')">Delete</button>
      </td>
    </tr>`;
  }).join('') || `<tr><td colspan="5" class="muted">No vouchers issued yet.</td></tr>`;
}
document.getElementById('feeSearch').addEventListener('input', e=>renderVouchers(e.target.value));

function deleteVoucher(id){
  if(!confirm('Delete this voucher?')) return;
  const v = vouchers.find(x=>x.id===id);
  vouchers = vouchers.filter(x=>x.id!==id);
  if(v){
    const student = students.find(s=>s.id===v.studentId);
    const hadAdmissionItem = (v.items||[]).some(it=>isAdmissionHeadName(it.name));
    // The one-time Admission Fee logic must mean "once, ever" — not "once,
    // even if that first voucher gets deleted by mistake." If the deleted
    // voucher was the one carrying this student's Admission Fee and they
    // now have no vouchers left, un-mark them so the engine correctly
    // charges it on their real next first voucher instead of skipping it
    // forever.
    if(student && hadAdmissionItem && !studentHasAnyVoucher(student.id)){
      student.admissionFeeCharged = false;
      saveStudents();
    }
  }
  saveVouchers(); renderVouchers(); renderDashboard();
}

