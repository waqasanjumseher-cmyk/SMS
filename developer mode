  settings: ()=>{ settings = settings || defaultSettings(); document.documentElement.setAttribute('data-theme', settings.theme||'navy'); applyBranding(); refreshClassDropdowns(); renderSettingsPanel(); }
};
let liveSyncUnsubs = {};      // key -> unsubscribe function
let liveSyncLastApplied = {}; // key -> last-applied updatedAt (ISO string), guards stale/duplicate/self-echo
let liveSyncSchoolId = null;  // which school the active listeners belong to

async function startLiveSync(schoolId){
  stopLiveSync();
  if(!schoolId || !cloudConfig.firebaseEnabled) return;
  const ready = await ensureFirebaseReady();
  if(!ready || !firebaseDb) return;
  liveSyncSchoolId = schoolId;
  liveSyncLastApplied = {};
  LIVE_SYNC_KEYS.forEach(key=>{
    const fullKey = scopedKeyFor(schoolId, key);
    liveSyncUnsubs[key] = firebaseDb.collection('erp_sync').doc(fullKey).onSnapshot(snap=>{
      if(schoolId !== currentSchoolId) return; // user has since left/switched schools — ignore
      if(!snap.exists) return;
      if(snap.metadata && snap.metadata.hasPendingWrites) return; // this device's own optimistic write, not a remote change
      const data = snap.data();
      if(!data || typeof data.updatedAt !== 'string') return;
      if(liveSyncLastApplied[key] && data.updatedAt <= liveSyncLastApplied[key]) return; // stale or already-applied
      liveSyncLastApplied[key] = data.updatedAt;
      applyLiveSyncUpdate(key, data.value);
    }, err=>{ console.error('[LiveSync] listener error for', key, err); });
  });
}

function stopLiveSync(){
  Object.values(liveSyncUnsubs).forEach(unsub=>{ try{ unsub(); }catch(e){} });
  liveSyncUnsubs = {};
  liveSyncSchoolId = null;
}

function applyLiveSyncUpdate(key, value){
  switch(key){
    case 'students': students = value || []; break;
    case 'vouchers': vouchers = value || []; break;
    case 'examRecords': examRecords = value || []; break;
    case 'staff': staff = value || []; break;
    case 'expenses': expenses = value || []; break;
    case 'payrollRuns': payrollRuns = value || []; break;
    case 'staffAttendance': staffAttendance = value || []; break;
    case 'attendance': attendance = value || []; break;
    case 'settings': settings = value || defaultSettings(); break;
    default: return;
  }
  // Persist the incoming value to this device's own local storage too,
  // WITHOUT re-mirroring to Firebase — it just came FROM Firebase, so
  // writing it back up is redundant and would just echo the listener.
  lsWriteLocalOnly(scopedKey(key), value);
  const render = LIVE_SYNC_RENDER[key];
  if(render){ try{ render(); }catch(e){ console.error('[LiveSync] render failed for', key, e); } }
}

