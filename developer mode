  staffAttendance = await loadKey('staffAttendance', staffAttendance);
  attendance = await loadKey('attendance', attendance);
  settings = (await loadKey('settings', settings)) || defaultSettings();
  // Empty arrays are truthy in JS, so a school whose settings were never
  // explicitly saved (classes: [], feeHeads: []) used to fail this check
  // forever and stay stuck with no classes/fee heads. Checking .length
  // catches that case while still respecting a real, saved value.
  if(!settings.classes || !settings.classes.length) settings.classes = defaultSettings().classes;
  if(!settings.feeHeads || !settings.feeHeads.length) settings.feeHeads = defaultSettings().feeHeads;
