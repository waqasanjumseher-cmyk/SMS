/* ============================================================
   PHASE 5B: SELECTIVE SHARING & EXPORT
   ------------------------------------------------------------
   Lets a user explicitly pick which slice of a student's record to
   generate before sharing it — Educational Only, Financial Only, or
   a Combined Full Profile — and in which format (a printable
   receipt they can Print/Save-as-PDF, a downloadable PNG image, or
   a plain formatted WhatsApp text message with no image attached).
   Reuses the same #modalBg/#printArea/currentWA machinery every
   other document in the app already uses, so Print, Download as
   Image and "Send on WhatsApp" (image+caption) keep working exactly
   as before for whatever gets generated here.
   ============================================================ */
let shareStudentId = null;
function openShareModal(studentId){
  const s = students.find(x=>x.id===studentId);
  if(!s) return;
  shareStudentId = studentId;
  document.getElementById('shareModalStudentLabel').textContent =
    `${escapeHtml(s.name)} — Roll No ${escapeHtml(s.roll)}, ${escapeHtml(s.class)}${s.section ? ' ('+s.section+')' : ''}`;
  document.getElementById('shareModalBg').classList.add('show');
}
function closeShareModal(){ document.getElementById('shareModalBg').classList.remove('show'); }
document.getElementById('shareModalBg').addEventListener('click', e=>{
  if(e.target.id==='shareModalBg') closeShareModal();
});

function studentEducationalRows(s){
  return examRecords.filter(r=>r.studentId===s.id).slice().sort((a,b)=> a.date < b.date ? 1 : -1);
}
function studentFinancialRows(s){
  return vouchers.filter(v=>v.studentId===s.id).slice().sort((a,b)=> a.date < b.date ? 1 : -1);
}

/* Builds both the printable HTML (for the shared #printArea modal) and
   the plain-text WhatsApp version for the chosen section. */
function buildShareDocument(s, section){
  const sch = settings.school || {};
  const schoolName = (sch.name || 'SCHOOL').toUpperCase();
  const eduRows = studentEducationalRows(s);
  const finRows = studentFinancialRows(s);
  const totalDue = finRows.reduce((a,v)=>a+Number(v.balance||0), 0);

  const eduBlockHtml = `
    <h3 style="margin:18px 26px 8px;color:var(--navy-2);">Educational Summary</h3>
    <div style="margin:0 26px;">
      <div class="mv-meta-grid">
        <div><span>Class</span><b>${escapeHtml(s.class)}${s.section ? ' ('+s.section+')' : ''}</b></div>
        <div><span>Session</span><b>${escapeHtml(s.session)}</b></div>
        <div><span>Status</span><b>${s.status || 'Active'}</b></div>
        <div><span>Roll No.</span><b>${escapeHtml(s.roll)}</b></div>
      </div>
      <table class="mv-items-table" style="margin-top:10px;">
        <thead><tr><th>Exam</th><th>Obtained</th><th>Total</th><th>%</th><th>Grade</th><th>Date</th></tr></thead>
        <tbody>${eduRows.map(r=>`<tr><td>${escapeHtml(r.title)}</td><td>${r.obtSum}</td><td>${r.totSum}</td><td>${r.pct}%</td><td>${r.grade}</td><td>${r.date}</td></tr>`).join('')
          || '<tr><td colspan="6" class="muted">No exam records yet.</td></tr>'}</tbody>
      </table>
    </div>`;

  const finBlockHtml = `
    <h3 style="margin:18px 26px 8px;color:var(--navy-2);">Financial Summary</h3>
    <div style="margin:0 26px;">
      <table class="mv-items-table">
        <thead><tr><th>Month</th><th>Total</th><th>Paid</th><th>Balance</th><th>Status</th></tr></thead>
        <tbody>${finRows.map(v=>`<tr><td>${v.month}</td><td>${money(v.total)}</td><td>${money(v.paid)}</td><td>${money(v.balance)}</td><td>${v.status}</td></tr>`).join('')
          || '<tr><td colspan="5" class="muted">No fee vouchers yet.</td></tr>'}</tbody>
      </table>
      <div class="total-line"><span>Total Outstanding</span><span>${money(totalDue)}</span></div>
    </div>`;

  const bodyHtml = section==='edu' ? eduBlockHtml : section==='fin' ? finBlockHtml : (eduBlockHtml + finBlockHtml);
  const label = section==='edu' ? 'EDUCATIONAL RECORD' : section==='fin' ? 'FINANCIAL STATEMENT' : 'FULL STUDENT PROFILE';

  const html = `
    <div class="doc" style="padding:26px;">
      <div class="modern-voucher">
        <div class="mv-topbar"></div>
        <div class="mv-header">
          <div class="mv-brand">
            <div class="crest" style="width:48px;height:48px;">${monogramHTML(48)}</div>
            <div>
              <div class="mv-school-name">${schoolName}</div>
              <div class="mv-school-sub">${sch.address || sch.slogan || ''}</div>
            </div>
          </div>
          <div class="mv-doc-tag">
            <div class="mv-doc-title">${label}</div>
            <div class="mv-doc-date">Generated ${new Date().toISOString().slice(0,10)}</div>
          </div>
        </div>
        <div class="mv-student-block">
          <div class="mv-photo">${s.photo ? `<img src="${s.photo}" alt="${escapeHtml(s.name)}">` : 'No Photo'}</div>
          <div>
            <div class="mv-student-name">${escapeHtml(s.name)}</div>
            <div class="mv-meta-grid">
              <div><span>Father / Guardian</span><b>${escapeHtml(s.father)}</b></div>
              <div><span>Roll No.</span><b>${escapeHtml(s.roll)}</b></div>
              <div><span>Class</span><b>${escapeHtml(s.class)}</b></div>
            </div>
          </div>
        </div>
        ${bodyHtml}
        <div class="mv-disclaimer">This is a computer-generated ${label.toLowerCase()} issued by ${schoolName}${sch.phone ? ` &bull; ${escapeHtml(sch.phone)}` : ''}. Kindly retain for your records.</div>
      </div>
    </div>`;

  /* ------------------------------------------------------------
     Plain-text WhatsApp message. IMPORTANT: this must stay pure
     plain text — escapeHtml() (used above for the HTML/print/image
     version) is deliberately NOT applied here. Running it on this
     branch used to leak raw HTML entities like "&amp;" and "&#39;"
     straight into the chat message; WhatsApp only understands its own
     lightweight markup (*bold*, _italic_), not HTML entities. ---- */
  const emoji = section==='edu' ? '🎓' : section==='fin' ? '💰' : '🏫';
  const sectionTag = section==='edu' ? '📘 EDUCATIONAL RECORD' : section==='fin' ? '💳 FINANCIAL STATEMENT' : '📋 FULL STUDENT PROFILE';
  const textLines = [
    `${emoji} *${schoolName}*`,
    `*${sectionTag}*`,
    '───────────────────',
    `👤 *${s.name}*`,
    `🏷️ Roll No: ${s.roll}   |   Class: ${s.class}${s.section ? ' ('+s.section+')' : ''}`,
    `👨‍👩‍👧 Guardian: ${s.father}`
  ];
  if(section==='edu' || section==='combined'){
    textLines.push('', '📘 *Educational Summary*', '───────────────────');
    if(eduRows.length) eduRows.forEach(r=>textLines.push(`• ${r.title}: ${r.obtSum}/${r.totSum} (${r.pct}%, Grade ${r.grade}) — ${r.date}`));
    else textLines.push('_No exam records yet._');
  }
  if(section==='fin' || section==='combined'){
    textLines.push('', '💳 *Financial Summary*', '───────────────────');
    if(finRows.length){
      finRows.forEach(v=>textLines.push(`• ${v.month}: Total ${money(v.total)} | Paid ${money(v.paid)} | Balance ${money(v.balance)} (${v.status})`));
      textLines.push('───────────────────', `📌 *Total Outstanding: ${money(totalDue)}*`);
    } else textLines.push('_No fee vouchers yet._');
  }
  textLines.push('', `_This is a computer-generated ${label.toLowerCase()} from ${schoolName}${sch.phone ? ' • ' + sch.phone : ''}._`);
  return { html, text: textLines.join('\n') };
}

/* Plain-text WhatsApp share — no image, just the formatted message,
   distinct from the existing image+caption "Send on WhatsApp" button. */
function sendWhatsAppTextOnly(phone, message){
  if(!phone){ toast('No WhatsApp number on file for this student'); return; }
  window.open(`https://wa.me/${phone}?text=${encodeURIComponent(message)}`, '_blank');
}

document.getElementById('shareGenerateBtn').addEventListener('click', ()=>{
  const s = students.find(x=>x.id===shareStudentId);
  if(!s){ toast('Student not found'); return; }
  const section = document.getElementById('share_section').value;
  const format = document.getElementById('share_format').value;
  const { html, text } = buildShareDocument(s, section);

  if(format === 'whatsapp'){
    closeShareModal();
    sendWhatsAppTextOnly(s.phone, text);
    return;
  }

  document.getElementById('printArea').innerHTML = html;
  currentWA = { phone: s.phone, message: text, filename: `${s.name.replace(/\s+/g,'_')}_${section}.png` };
  closeShareModal();
  openModal(true);
  if(format === 'print') window.print();
  else if(format === 'image') document.getElementById('downloadImgBtn').click();
});

