  const balanceDue = grandTotal - Number(voucher.paid||0);
  const status = voucher.status;
  const itemsRows = voucher.items.map(i=>`<tr><td>${escapeHtml(i.name)}</td><td>${money(i.amount)}</td></tr>`).join('')
    + (priorBalance>0 ? `<tr><td>Previous Balance B/F</td><td>${money(priorBalance)}</td></tr>` : '');
  return `
  <div class="bulk-voucher-card">
    <div class="bvc-head">
      <div class="bvc-school">${schoolName}<div class="sub">${escapeHtml(sch.address || sch.slogan || '')}</div></div>
      <div class="bvc-doctitle">FEE VOUCHER<div class="no">#${voucher.id.slice(-6).toUpperCase()} · ${voucher.month}</div></div>
    </div>
    <div class="bvc-meta">
      <div>Student: <b>${escapeHtml(student.name)}</b></div>
      <div>Roll No: <b>${escapeHtml(student.roll)}</b></div>
      <div>Father/Guardian: <b>${escapeHtml(student.father)}</b></div>
      <div>Class: <b>${escapeHtml(student.class)}${student.section ? ' ('+escapeHtml(student.section)+')' : ''}</b></div>
    </div>
    <table class="bvc-items">${itemsRows}</table>
    <div class="bvc-totals">
      <div class="row"><span>Subtotal</span><span>${money(grandTotal)}</span></div>
      <div class="row"><span>Paid</span><span>${money(voucher.paid)}</span></div>
      <div class="row grand"><span>Balance Due</span><span>${money(balanceDue)}</span></div>
      <div class="row" style="margin-top:3px;"><span class="bvc-status">${status}</span><span></span></div>
    </div>
