/* ---- Import: validate structure, then map headers -> object keys ---- */
function sheetToRows(ws){
  // Robust row/column split: SheetJS turns the raw cell grid into an
  // array of {Header: value} objects using row 1 as the header map.
  return ws ? XLSX.utils.sheet_to_json(ws, { defval: '' }) : [];
}
function hasRequiredColumns(rows, requiredCols){
  if(!rows.length) return true; // an empty sheet is structurally valid — just no rows to restore
  const keys = Object.keys(rows[0]);
  return requiredCols.every(c => keys.includes(c));
}
function safeJsonParse(str, fallback){
  if(!str) return fallback;
  try{ const v = JSON.parse(str); return v == null ? fallback : v; }
  catch(e){ return fallback; }
}

/* ---- Import Data Validation: JSON-Schema-style structural check -----
   hasRequiredColumns() above only confirms a column HEADER exists — it
   says nothing about what's actually in the cells. A "Total" column
   full of the text "N/A" would pass that check and then corrupt every
   fee balance calculation on restore. This layer adds real per-row type
   checking for the two record types most likely to break the rest of
   the app if malformed: students and vouchers (fees). It runs BEFORE
   parseBackupWorkbook builds the in-memory objects that get pushed to
   students/vouchers and saved to localStorage — a schema failure aborts
   the whole import with a specific reason, and nothing is mutated or
   persisted. -------------------------------------------------------- */
const IMPORT_SCHEMAS = {
  students: {
    sheet: 'Students',
    required: ['Name','Roll','Class'],
    fields: {
      Name:  { type:'string', required:true },
      Roll:  { type:'string', required:true },
      Class: { type:'string', required:true },
      Phone: { type:'string' },
      DOB:   { type:'string' }
    }
  },
  vouchers: {
    sheet: 'FeesHistory',
    required: ['StudentID','Total'],
    fields: {
      StudentID: { type:'string', required:true },
      Total:     { type:'number', required:true },
      Paid:      { type:'number' },
      Balance:   { type:'number' }
    }
  }
};

/* A cell's raw value from SheetJS is often a string even for numeric
   columns (CSV in particular has no cell types), so "is this a number"
   has to mean "numeric once coerced", not `typeof === 'number'` — that
   would reject every legitimate CSV import. Empty/blank is treated as
   valid-but-absent here; required-ness is checked separately so a
   genuinely missing required number still fails with a clear reason. */
function valueMatchesType(value, type){
  if(value === '' || value === null || value === undefined) return true;
  if(type === 'number') return !isNaN(Number(value));
  if(type === 'string') return true; // anything stringifies; the real risk was already numeric corruption
  return true;
}

function validateRowsAgainstSchema(rows, schemaKey){
  const schema = IMPORT_SCHEMAS[schemaKey];
  const errors = [];
  rows.forEach((row, idx)=>{
    const rowNum = idx + 2; // +1 for 0-index, +1 for the header row — matches what a user sees in Excel
    Object.entries(schema.fields).forEach(([col, rule])=>{
      const val = row[col];
      const isBlank = val === '' || val === null || val === undefined;
      if(rule.required && isBlank){
        errors.push(`Row ${rowNum}: "${col}" is required but blank`);
        return;
      }
      if(!valueMatchesType(val, rule.type)){
        errors.push(`Row ${rowNum}: "${col}" must be a ${rule.type}, got "${val}"`);
      }
    });
  });
  return { valid: errors.length === 0, errors: errors.slice(0, 20) }; // cap at 20 so one bad column doesn't produce a wall of text
}

function parseBackupWorkbook(wb){
  const out = { valid:false, error:'', students:[], vouchers:[], expenses:[], staff:[], payrollRuns:[], appUsers:[], settings:null };

  const studentsSheet = wb.Sheets['Students'];
  if(!studentsSheet){
    out.error = 'Missing a "Students" sheet — this file does not look like a School ERP backup workbook.';
    return out;
  }
  const studentRows = sheetToRows(studentsSheet);
  if(!hasRequiredColumns(studentRows, IMPORT_SCHEMAS.students.required)){
    out.error = 'The Students sheet is missing required columns (Name, Roll, Class).';
    return out;
  }
  const studentSchemaCheck = validateRowsAgainstSchema(studentRows, 'students');
  if(!studentSchemaCheck.valid){
    out.error = 'Students sheet failed validation:\n' + studentSchemaCheck.errors.join('\n');
    return out;
  }
  out.students = studentRows
    .filter(r => String(r.Name||'').trim() && String(r.Roll||'').trim())
    .map(r => ({
      id: String(r.ID || uid('STU')),
      admissionNo: String(r.AdmissionNo || ('ADM-' + Math.floor(1000+Math.random()*9000))),
      roll: String(r.Roll), name: String(r.Name), father: String(r.Father || ''),
      class: String(r.Class), section: String(r.Section || ''), session: String(r.Session || ''), phone: String(r.Phone || ''),
      dob: r.DOB || '', formb: String(r.FormB || ''),
      status: r.Status || 'Active', admissionDate: r.AdmissionDate || new Date().toISOString().slice(0,10),
      leftDate: r.LeftDate || '', photo: '', // photos are intentionally excluded from spreadsheet backups
      tuitionFee: r.TuitionFee !== undefined && r.TuitionFee !== '' ? Number(r.TuitionFee) : undefined,
      admissionFee: r.AdmissionFee !== undefined && r.AdmissionFee !== '' ? Number(r.AdmissionFee) : undefined,
      admissionFeeCharged: String(r.AdmissionFeeCharged||'').toLowerCase() === 'yes',
      customFees: safeJsonParse(r.CustomFeesJSON, {})
    }));

  const feesSheet = wb.Sheets['FeesHistory'];
  if(feesSheet){
    const feeRows = sheetToRows(feesSheet);
    if(!hasRequiredColumns(feeRows, IMPORT_SCHEMAS.vouchers.required)){
      out.error = 'The FeesHistory sheet is missing required columns (StudentID, Total).';
      return out;
    }
    const voucherSchemaCheck = validateRowsAgainstSchema(feeRows, 'vouchers');
    if(!voucherSchemaCheck.valid){
      out.error = 'FeesHistory sheet failed validation:\n' + voucherSchemaCheck.errors.join('\n');
      return out;
    }
    out.vouchers = feeRows
      .filter(r => String(r.StudentID||'').trim())
      .map(r => {
        const total = Number(r.Total || 0);
        const paid = Number(r.Paid || 0);
        return {
          id: String(r.ID || uid('FV')), studentId: String(r.StudentID), month: r.Month || '',
          items: safeJsonParse(r.ItemsJSON, []), total, paid,
          balance: r.Balance !== '' && r.Balance != null ? Number(r.Balance) : (total - paid),
          status: r.Status || (paid>=total ? 'Paid' : 'Due'), date: r.Date || new Date().toISOString().slice(0,10)
        };
      });
  }

  const expensesSheet = wb.Sheets['Expenses'];
  if(expensesSheet){
    const expRows = sheetToRows(expensesSheet);
    out.expenses = expRows
      .filter(r => String(r.Title||'').trim() || Number(r.Amount||0) > 0)
      .map(r => ({
        id: String(r.ID || uid('EXP')), date: r.Date || new Date().toISOString().slice(0,10),
        category: r.Category || 'General', title: r.Title || '', amount: Number(r.Amount || 0)
      }));
  }

  const payrollSheet = wb.Sheets['StaffPayroll'];
  if(payrollSheet){
    const stfRows = sheetToRows(payrollSheet);
    out.staff = stfRows
      .filter(r => String(r.Name||'').trim())
      .map(r => ({
        id: String(r.ID || uid('STF')), name: r.Name, designation: r.Designation || '',
        joining: r.Joining || '', basic: Number(r.Basic || 0),
        allowances: Number(r.Allowances || 0), deductions: Number(r.Deductions || 0), // legacy columns, kept for older backups
        phone: r.Phone || ''
      }));
  }

  const payrollRunsSheet = wb.Sheets['PayrollRuns'];
  if(payrollRunsSheet){
    const runRows = sheetToRows(payrollRunsSheet);
    out.payrollRuns = runRows
      .filter(r => String(r.StaffID||'').trim() && String(r.Month||'').trim())
      .map(r => ({
        id: String(r.ID || uid('PR')), staffId: String(r.StaffID), month: String(r.Month),
        basic: Number(r.Basic || 0), allowances: Number(r.Allowances || 0), deductions: Number(r.Deductions || 0),
        net: Number(r.Net || 0), expenseId: String(r.ExpenseID || ''),
        paidOn: r.PaidOn || new Date().toISOString().slice(0,10)
      }));
  }

  const loginsSheet = wb.Sheets['StaffLogins'];
  if(loginsSheet){
    const loginRows = sheetToRows(loginsSheet);
    out.appUsers = loginRows
      .filter(r => String(r.Username||'').trim() && String(r.Password||'').trim())
      .map(r => ({
        id: String(r.ID || uid('u_')), username: String(r.Username), password: String(r.Password),
        name: r.Name || r.Username, role: r.Role || 'Manager',
        // Data Validation Safeguard: never restore access to a module the
        // Developer no longer licenses for this school — Phase 1's
        // licensing rules win even inside an old backup file.
        permissions: safeJsonParse(r.PermissionsJSON, []).filter(t => licensedAssignableTabs(currentSchool).includes(t))
      }));
  }

  const settingsSheet = wb.Sheets['Settings'];
  if(settingsSheet){
    const [row] = sheetToRows(settingsSheet);
    if(row){
      out.settings = {
        classes: safeJsonParse(row.ClassesJSON, settings.classes),
        feeHeads: safeJsonParse(row.FeeHeadsJSON, settings.feeHeads),
        school: safeJsonParse(row.SchoolJSON, settings.school),
        theme: row.Theme || settings.theme
      };
    }
  }

  out.valid = true;
  return out;
}

