function featureAllowed(featureKey){
  if(currentUser && currentUser.role === 'AnjumWebsDeveloper') return true; // Tier 1 bypasses every gate
  if(featureKey==='whatsappAlerts' && remoteFeatureLocked('enableWhatsApp')) return false;
  return !!(currentSchool && currentSchool.features && currentSchool.features[featureKey]);
