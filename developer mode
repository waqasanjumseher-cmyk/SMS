/* ---- Phase 2: Photo capture (auto-resized & compressed to keep storage small)
   ---- Phase 5A: when Google Drive media archiving is connected, the original
   file is ALSO uploaded straight to the school's own Drive; the compressed
   base64 above is then only kept as an instant local fallback/preview. ---- */
let regPhotoBase64 = '';
let regPhotoDriveId = '';
let regPhotoPreviewBlobUrl = '';
let regPhotoUploadPromise = Promise.resolve();
document.getElementById('s_photo').addEventListener('change', (e)=>{
  const file = e.target.files[0];
  const preview = document.getElementById('s_photoPreview');
  regPhotoDriveId = '';
  if(!file){
    regPhotoBase64=''; regPhotoPreviewBlobUrl=''; regPhotoUploadPromise=Promise.resolve();
    preview.innerHTML='No Photo';
    return;
  }
  if(!file.type.startsWith('image/')){ toast('Please select a valid image file'); e.target.value=''; return; }

  regPhotoPreviewBlobUrl = URL.createObjectURL(file);
  preview.innerHTML = `<img src="${regPhotoPreviewBlobUrl}" alt="Student photo preview">`;

  const reader = new FileReader();
  reader.onload = (ev)=>{
    const img = new Image();
    img.onload = ()=>{
      const maxDim = 320;
      let w = img.width, h = img.height;
      if(w >= h && w > maxDim){ h = Math.round(h * (maxDim / w)); w = maxDim; }
      else if(h > w && h > maxDim){ w = Math.round(w * (maxDim / h)); h = maxDim; }
      const canvas = document.createElement('canvas');
      canvas.width = w; canvas.height = h;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(img, 0, 0, w, h);
      regPhotoBase64 = canvas.toDataURL('image/jpeg', 0.82);
    };
    img.onerror = ()=>{ toast('Could not read this image file'); regPhotoBase64=''; };
    img.src = ev.target.result;
  };
  reader.onerror = ()=>{ toast('Could not read this image file'); regPhotoBase64=''; };
  reader.readAsDataURL(file);

  // Phase 5A: direct archive to the school's own Drive when connected
  if(driveMediaReady()){
    regPhotoUploadPromise = uploadFileToDrive(file, settings.drive.photosFolderId)
      .then(fileId=>{ regPhotoDriveId = fileId; })
      .catch(err=>{
        console.error('Drive photo upload failed:', err);
        toast('⚠ Could not upload photo to Drive — kept locally instead');
      });
  } else {
    regPhotoUploadPromise = Promise.resolve();
  }
});

/* ---- Phase 5A: Scanned Document upload — archived directly to the
   school's Drive "Scanned Documents" subfolder. Requires Drive to be
   connected first (no local/base64 fallback for documents). ---- */
let regDocDriveId = '';
let regDocUploadPromise = Promise.resolve();
document.getElementById('s_document').addEventListener('change', (e)=>{
  const file = e.target.files[0];
  const preview = document.getElementById('s_docPreview');
  regDocDriveId = '';
  if(!file){ preview.innerHTML = 'No Document'; regDocUploadPromise = Promise.resolve(); return; }
  if(!driveMediaReady()){
    toast('Connect Google Drive first (Settings → Cloud Media Archive) to archive scanned documents');
    e.target.value = '';
    preview.innerHTML = 'No Document';
    regDocUploadPromise = Promise.resolve();
    return;
  }
  preview.innerHTML = `📄 Uploading "${escapeHtml(file.name)}"…`;
  regDocUploadPromise = uploadFileToDrive(file, settings.drive.documentsFolderId)
    .then(fileId=>{
      regDocDriveId = fileId;
      preview.innerHTML = `📄 ${escapeHtml(file.name)} <span class="muted">— archived to Drive</span>`;
    })
    .catch(err=>{
      console.error('Drive document upload failed:', err);
      preview.innerHTML = 'No Document';
      toast('⚠ Could not upload document to Drive');
    });
});

/* ---- Dynamic per-student fee structure: Tuition (monthly, editable) +
   Admission Fee (one-time, charged only on the first voucher) + any other
   recurring monthly fee heads picked here (Transport, Exam Fee, etc). ---- */
function isTuitionHeadName(name){ return String(name||'').toLowerCase().includes('tuition'); }
function isAdmissionHeadName(name){ return String(name||'').toLowerCase().includes('admission'); }
function tuitionFeeHeadDefault(){
  const h = settings.feeHeads.find(f=>isTuitionHeadName(f.name));
  return h ? Number(h.amount||0) : 0;
}
function admissionFeeHeadDefault(){
  const h = settings.feeHeads.find(f=>isAdmissionHeadName(f.name));
  return h ? Number(h.amount||0) : 0;
}
function otherRecurringFeeHeads(){
  // every configured fee head except the two that get dedicated fields above
  return settings.feeHeads
    .map((f,i)=>({...f, idx:i}))
    .filter(f=>!isTuitionHeadName(f.name) && !isAdmissionHeadName(f.name));
}

function renderRegFeeHeads(){
  const box = document.getElementById('regFeeHeadsList');
  if(!box) return;
  const others = otherRecurringFeeHeads();
  box.innerHTML = others.map(f=>`
    <div class="checkfee">
      <input type="checkbox" class="regFeeChk" data-idx="${f.idx}">
      <span>${escapeHtml(f.name)} <span class="muted">(default: ${money(f.amount)})</span></span>
      <input type="number" class="regFeeAmt" data-idx="${f.idx}" value="${f.amount}" disabled>
    </div>`).join('') || `<p class="muted">No other fee heads configured. Add some in Settings first.</p>`;
  box.querySelectorAll('.regFeeChk').forEach(chk=>{
    chk.addEventListener('change', ()=>{
      const amt = box.querySelector(`.regFeeAmt[data-idx="${chk.dataset.idx}"]`);
      amt.disabled = !chk.checked;
      if(chk.checked) amt.focus();
    });
  });
}

function prefillRegFeeDefaults(){
  const tEl = document.getElementById('s_tuitionFee');
  const aEl = document.getElementById('s_admissionFee');
  if(tEl && !tEl.value) tEl.value = tuitionFeeHeadDefault();
  if(aEl && !aEl.value) aEl.value = admissionFeeHeadDefault();
  updateAdmissionFeeNote(null);
}

function updateAdmissionFeeNote(student){
  const note = document.getElementById('s_admissionFeeNote');
  if(!note) return;
  if(student && student.admissionFeeCharged){
    note.style.display = 'block';
    note.textContent = 'This student\'s one-time Admission Fee has already been charged on a previous voucher — it will not be billed again automatically.';
  } else {
    note.style.display = 'block';
    note.textContent = 'Billed automatically, once only, the first time a fee voucher is generated for this student.';
  }
}

let editingStudentId = null;

document.getElementById('regForm').addEventListener('submit', async e=>{
  e.preventDefault();
  // Phase 5A: make sure any in-flight Drive uploads have finished before we save
  await regPhotoUploadPromise;
  await regDocUploadPromise;

  const customFees = {};
  document.querySelectorAll('#regFeeHeadsList .regFeeChk').forEach(chk=>{
    if(chk.checked){
      const idx = chk.dataset.idx;
      const amt = Number(document.querySelector(`#regFeeHeadsList .regFeeAmt[data-idx="${idx}"]`).value || 0);
      const head = settings.feeHeads[idx];
      if(head) customFees[head.name] = amt;
    }
  });

  const tuitionFee = Number(document.getElementById('s_tuitionFee').value || 0);
  const admissionFee = Number(document.getElementById('s_admissionFee').value || 0);

  const name = document.getElementById('s_name').value.trim();
  const father = document.getElementById('s_father').value.trim();
  const roll = document.getElementById('s_roll').value.trim();
  const formb = document.getElementById('s_formb').value.trim();
  const cls = document.getElementById('s_class').value;
  const section = document.getElementById('s_section').value;
  const session = document.getElementById('s_session').value.trim();
  const status = document.getElementById('s_status').value || 'Active';
  const phone = document.getElementById('s_phone').value.trim().replace(/[^0-9]/g,'');
  const dob = document.getElementById('s_dob').value;

  if(!cls){ toast('Please select a class'); return; }
  if(!roll){ toast('Please enter a roll number'); return; }

  const dup = students.some(s =>
    s.id !== editingStudentId && s.class === cls && s.roll.trim().toLowerCase() === roll.toLowerCase()
  );
  if(dup){
    toast(`A student with Roll No "${roll}" already exists in ${cls}`);
    return;
  }

  if(editingStudentId){
    const s = students.find(x=>x.id===editingStudentId);
    if(!s){ toast('Student record not found'); resetRegForm(); return; }
    Object.assign(s, { name, father, roll, formb, class: cls, section, session, status, phone, dob, customFees, tuitionFee, admissionFee });
    if(status === 'Left' && !s.leftDate) s.leftDate = new Date().toISOString().slice(0,10);
    if(status !== 'Left') s.leftDate = '';
    // Phase 5A: only overwrite if a new photo/document was actually picked
    if(regPhotoDriveId){
      s.photoDriveId = regPhotoDriveId;
      s.photo = regPhotoPreviewBlobUrl || s.photo;
      driveImageCache.set(regPhotoDriveId, regPhotoPreviewBlobUrl);
    } else if(regPhotoBase64){
      s.photo = regPhotoBase64; // Drive not connected — local fallback, as before
    }
    if(regDocDriveId) s.documentDriveId = regDocDriveId;
    saveStudents();
    toast(`${escapeHtml(s.name)}'s profile updated`);
  } else {
    const student = {
      id: uid('STU'),
      name, father, roll, formb, class: cls, section, session,
      phone, dob,
      admissionDate: new Date().toISOString().slice(0,10),
      admissionNo: 'ADM-' + Math.floor(1000+Math.random()*9000),
      // Phase 5A: Drive-archived photo keeps only the file id at rest;
      // "photo" holds the instant local blob preview (or the base64
      // fallback when Drive isn't connected) for on-screen rendering.
      photo: regPhotoDriveId ? (regPhotoPreviewBlobUrl || '') : (regPhotoBase64 || ''),
      photoDriveId: regPhotoDriveId || '',
      documentDriveId: regDocDriveId || '',
      customFees: customFees,
      tuitionFee: tuitionFee,
      admissionFee: admissionFee,
      admissionFeeCharged: false,
      status: status,
      leftDate: status === 'Left' ? new Date().toISOString().slice(0,10) : ''
    };
    if(regPhotoDriveId) driveImageCache.set(regPhotoDriveId, regPhotoPreviewBlobUrl);
    students.push(student);
    saveStudents();
    document.getElementById('sessionBadge').textContent = student.session;
    toast('Student registered successfully');
  }

  resetRegForm();
  renderStudents();
  renderDashboard();
});

function resetRegForm(){
  editingStudentId = null;
  document.getElementById('regForm').reset();
  document.getElementById('s_status').value = 'Active';
  fillSectionSelect(document.getElementById('s_section'), '', false);
  regPhotoBase64 = '';
  regPhotoDriveId = '';
  regPhotoPreviewBlobUrl = '';
  regPhotoUploadPromise = Promise.resolve();
  document.getElementById('s_photoPreview').innerHTML = 'No Photo';
  regDocDriveId = '';
  regDocUploadPromise = Promise.resolve();
  document.getElementById('s_document').value = '';
  document.getElementById('s_docPreview').innerHTML = 'No Document';
  document.getElementById('regSubmitBtn').textContent = 'Register Student';
  document.getElementById('cancelEditRegBtn').style.display = 'none';
  renderRegFeeHeads();
  prefillRegFeeDefaults();
}
document.getElementById('cancelEditRegBtn').addEventListener('click', resetRegForm);

function editStudent(id){
  const s = students.find(x=>x.id===id);
  if(!s) return;
  editingStudentId = id;
  document.getElementById('s_name').value = s.name;
  document.getElementById('s_father').value = s.father;
  document.getElementById('s_roll').value = s.roll;
  document.getElementById('s_formb').value = s.formb || '';
  document.getElementById('s_class').value = s.class;
  fillSectionSelect(document.getElementById('s_section'), s.class, false);
  document.getElementById('s_section').value = s.section || '';
  document.getElementById('s_session').value = s.session;
  document.getElementById('s_status').value = s.status || 'Active';
  document.getElementById('s_phone').value = s.phone || '';
  document.getElementById('s_dob').value = s.dob || '';
  regPhotoBase64 = ''; // keep existing photo unless a new file is chosen
  regPhotoDriveId = '';
  regPhotoPreviewBlobUrl = '';
  document.getElementById('s_photoPreview').innerHTML = s.photo ? `<img src="${s.photo}" alt="${escapeHtml(s.name)}">` : 'No Photo';
  regDocDriveId = '';
  document.getElementById('s_document').value = '';
  document.getElementById('s_docPreview').innerHTML = s.documentDriveId ? '📄 Document on file — archived to Drive' : 'No Document';

  document.getElementById('s_tuitionFee').value = s.tuitionFee != null ? s.tuitionFee : tuitionFeeHeadDefault();
  document.getElementById('s_admissionFee').value = s.admissionFee != null ? s.admissionFee : admissionFeeHeadDefault();
  updateAdmissionFeeNote(s);

  renderRegFeeHeads();
  Object.entries(s.customFees || {}).forEach(([headName, amt])=>{
    if(isTuitionHeadName(headName) || isAdmissionHeadName(headName)) return; // now dedicated fields, not checklist entries
    const idx = settings.feeHeads.findIndex(f=>f.name===headName);
    if(idx>=0){
      const chk = document.querySelector(`#regFeeHeadsList .regFeeChk[data-idx="${idx}"]`);
      const amtInput = document.querySelector(`#regFeeHeadsList .regFeeAmt[data-idx="${idx}"]`);
      if(chk){ chk.checked = true; amtInput.disabled = false; amtInput.value = amt; }
    }
  });

  document.getElementById('regSubmitBtn').textContent = 'Save Changes';
  document.getElementById('cancelEditRegBtn').style.display = 'inline-flex';
  document.querySelector('#panel-reg .card').scrollIntoView({behavior:'smooth', block:'start'});
  toast(`Editing ${escapeHtml(s.name)}`);
}

function renderStudents(filter=''){
  const tbody = document.getElementById('studentTable');
  const f = filter.toLowerCase();
  const rows = students.filter(s =>
    s.name.toLowerCase().includes(f) || s.roll.toLowerCase().includes(f) || s.class.toLowerCase().includes(f)
  );
  tbody.innerHTML = rows.map(s=>`
    <tr>
      <td>${s.photo ? `<img class="student-thumb" src="${s.photo}" alt="${escapeHtml(s.name)}">` : `<div class="student-thumb-empty">No Photo</div>`}</td>
      <td>${escapeHtml(s.roll)}</td>
      <td>${escapeHtml(s.name)}</td>
      <td>${escapeHtml(s.class)}${s.section ? ` <span class="muted">(${escapeHtml(s.section)})</span>` : ''}</td>
      <td>${escapeHtml(s.session)}</td>
      <td><span class="pill ${isActiveStudent(s) ? 'paid' : 'due'}">${s.status || 'Active'}</span></td>
      <td>
        <button class="btn small ghost" onclick="editStudent('${s.id}')">Edit</button>
        <button class="btn small secondary" onclick="showIdCard('${s.id}')">ID Card</button>
        <button class="btn small ghost" onclick="showAdmissionSlip('${s.id}')">Slip</button>
        <button class="btn small ghost" onclick="openShareModal('${s.id}')">📤 Share</button>
        ${s.status==='Left'
          ? `<button class="btn small gold" onclick="reactivateStudent('${s.id}')">Reactivate</button>`
          : `<button class="btn small gold" onclick="markStudentLeft('${s.id}')">Mark Left</button>`}
        <button class="btn small danger" onclick="deleteStudent('${s.id}')">Delete</button>
      </td>
    </tr>`).join('') || `<tr><td colspan="7" class="muted">No students registered yet.</td></tr>`;

  hydrateDrivePhotos(); // Phase 5A: fire-and-forget background fetch of any Drive-only photos
}
document.getElementById('regSearch').addEventListener('input', e=>renderStudents(e.target.value));

function markStudentLeft(id){
  const s = students.find(x=>x.id===id);
  if(!s) return;
  if(!confirm(`Mark ${escapeHtml(s.name)} as Left / Struck-Off? Their record will be kept for historical reports and ledgers.`)) return;
  s.status = 'Left';
  s.leftDate = new Date().toISOString().slice(0,10);
  saveStudents(); renderStudents(); renderDashboard();
  toast(`${escapeHtml(s.name)} marked as Left`);
}
function reactivateStudent(id){
  const s = students.find(x=>x.id===id);
  if(!s) return;
  s.status = 'Active';
  s.leftDate = '';
  saveStudents(); renderStudents(); renderDashboard();
  toast(`${escapeHtml(s.name)} reactivated`);
}

function deleteStudent(id){
  if(!confirm('Delete this student record?')) return;
  students = students.filter(s=>s.id!==id);
  saveStudents(); renderStudents(); renderDashboard();
}

