     - It CAN change on its own: a browser update, a GPU driver update, an
       OS font update, or the user switching monitors can all shift the
       canvas fingerprint or screen metrics without the user doing
       anything wrong. A byte-for-byte exact-match check WILL eventually
       lock out a legitimate paying customer.
     - It CAN be spoofed by a motivated user (privacy extensions already
       randomize canvas output; anti-fingerprinting is a whole industry).
     - Private/incognito windows and different browsers on the SAME
       physical machine will legitimately produce different fingerprints.
   Treat this as a friction layer that catches casual key-sharing, not as
   a cryptographic guarantee. matchDevice() below returns a SIMILARITY
   SCORE, not a boolean, so you can decide your own tolerance threshold
   (e.g. "allow if 80%+ of attributes match, otherwise ask for
   re-verification") instead of hard-locking on any drift.
   Any license decision that truly matters should still be confirmed
   server-side — a client-side fingerprint check can always be patched
   around by someone with dev tools open, same caveat as Phase 1.
   ========================================================================= */

const ERPDeviceFingerprint = (function () {
  'use strict';

  /* ---------------------------------------------------------------------
     Internal: SHA-256 fallback (used only if ERPCrypto isn't on the page)
     --------------------------------------------------------------------- */
  async function sha256HexFallback(text) {
    if (typeof window === 'undefined' || !window.crypto || !window.crypto.subtle) {
      throw new Error('ERPDeviceFingerprint requires Web Crypto API (window.crypto.subtle) support.');
    }
    const buf = await window.crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
    return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2, '0')).join('');
  }

  async function hashText(text) {
    // Prefer the Phase 1 module if it's loaded, so there's one hashing
    // code path across the whole ERP rather than two implementations.
    if (typeof ERPCrypto !== 'undefined' && typeof ERPCrypto.generateHash === 'function') {
      return ERPCrypto.generateHash(text, { mode: 'sha256' });
    }
    return sha256HexFallback(text);
  }

  /* =======================================================================
     1. ATTRIBUTE COLLECTORS
     ------------------------------------------------------------------------
     Each collector is defensive: any attribute that's unavailable, blocked
     by a privacy setting, or throws is recorded as 'unavailable' rather
     than crashing fingerprint generation.
     ======================================================================= */

  function safeGet(fn, fallback = 'unavailable') {
    try {
      const v = fn();
      return (v === undefined || v === null || v === '') ? fallback : v;
    } catch (e) {
      return fallback;
    }
  }

  function getUserAgent() {
    return safeGet(() => navigator.userAgent);
  }

  function getPlatform() {
    // navigator.platform is deprecated but still widely populated; fall
    // back to userAgentData when present (Chromium).
    return safeGet(() => navigator.userAgentData && navigator.userAgentData.platform
      ? navigator.userAgentData.platform
      : navigator.platform);
  }

  function getLanguage() {
    return safeGet(() => (navigator.languages && navigator.languages.join(',')) || navigator.language);
  }

  function getHardwareConcurrency() {
    return safeGet(() => navigator.hardwareConcurrency, 0);
  }

  function getDeviceMemory() {
    // Not available in every browser (notably Safari) — that's fine,
    // safeGet records 'unavailable' and the attribute is simply excluded
    // from the similarity comparison for that browser.
    return safeGet(() => navigator.deviceMemory, 'unavailable');
  }

  function getScreenResolution() {
    return safeGet(() => `${screen.width}x${screen.height}x${screen.colorDepth}`);
  }

  function getTimezone() {
    return safeGet(() => Intl.DateTimeFormat().resolvedOptions().timeZone);
  }

  function getTimezoneOffset() {
    return safeGet(() => new Date().getTimezoneOffset());
  }

  function getTouchSupport() {
    return safeGet(() => ('ontouchstart' in window) || navigator.maxTouchPoints > 0);
  }

  /**
   * Canvas fingerprint: renders known text/shapes to an off-screen canvas
   * and hashes the resulting pixel data. Font rendering, anti-aliasing,
   * and GPU/driver differences make this vary meaningfully across real
   * devices while staying stable across page loads on the SAME device.
   */
  function getCanvasFingerprint() {
    return safeGet(() => {
      const canvas = document.createElement('canvas');
      canvas.width = 220;
      canvas.height = 40;
      const ctx = canvas.getContext('2d');
      if (!ctx) return 'unavailable';

      ctx.textBaseline = 'top';
      ctx.font = "14px 'Arial'";
      ctx.fillStyle = '#f60';
      ctx.fillRect(0, 0, 100, 20);
      ctx.fillStyle = '#069';
      ctx.fillText('ERP-Device-Fingerprint-Ø1Ω', 2, 2);
      ctx.fillStyle = 'rgba(102, 200, 0, 0.6)';
      ctx.fillText('ERP-Device-Fingerprint-Ø1Ω', 4, 8);

      return canvas.toDataURL();
    });
  }

  /**
   * WebGL fingerprint: GPU vendor/renderer strings. Another axis of
   * hardware-level variation independent of the canvas 2D fingerprint.
   */
  function getWebglFingerprint() {
    return safeGet(() => {
      const canvas = document.createElement('canvas');
      const gl = canvas.getContext('webgl') || canvas.getContext('experimental-webgl');
      if (!gl) return 'unavailable';
      const debugInfo = gl.getExtension('WEBGL_debug_renderer_info');
      if (!debugInfo) return 'unavailable';
      const vendor = gl.getParameter(debugInfo.UNMASKED_VENDOR_WEBGL);
      const renderer = gl.getParameter(debugInfo.UNMASKED_RENDERER_WEBGL);
      return `${vendor}::${renderer}`;
    });
  }

  /**
   * Collects every attribute into one plain object. This is the raw
   * material both generateFingerprint() (hashes it) and matchDevice()
   * (diffs it attribute-by-attribute) work from.
   */
  function collectAttributes() {
    return {
      userAgent: getUserAgent(),
      platform: getPlatform(),
      language: getLanguage(),
      hardwareConcurrency: getHardwareConcurrency(),
      deviceMemory: getDeviceMemory(),
      screenResolution: getScreenResolution(),
      timezone: getTimezone(),
      timezoneOffset: getTimezoneOffset(),
      touchSupport: getTouchSupport(),
      canvasFingerprint: getCanvasFingerprint(),
      webglFingerprint: getWebglFingerprint()
    };
  }

  /* =======================================================================
     2. FINGERPRINT GENERATION
     ======================================================================= */

  /**
   * generateFingerprint()
   * Collects device attributes and produces a deterministic device hash.
   * "Deterministic" here means: same device, same browser, same session
   * conditions -> same hash on repeated calls. It is NOT guaranteed to be
   * stable forever (see module header) — that's why matchDevice() below
   * does tolerant comparison rather than expecting eternal exact equality.
   *
   * @returns {Promise<{ deviceId: string, attributes: object, generatedAt: string }>}
   *   deviceId    - SHA-256 hex hash of the normalized attribute set
   *   attributes  - the raw attribute object (store this alongside the
   *                 hash — matchDevice() needs it for tolerant re-comparison,
   *                 not just the final hash, since a hash alone can't tell
   *                 you WHICH attribute drifted)
   *   generatedAt - ISO timestamp for auditing/debugging
   */
  async function generateFingerprint() {
    const attributes = collectAttributes();

    // Sort keys before serializing so the hash is stable regardless of
    // property insertion order (defensive — object literals above are
    // already fixed order, but this protects future edits).
    const normalized = Object.keys(attributes).sort().reduce((acc, key) => {
      acc[key] = attributes[key];
      return acc;
    }, {});

    const deviceId = await hashText(JSON.stringify(normalized));

    return {
      deviceId,
      attributes,
      generatedAt: new Date().toISOString()
    };
  }

  /* =======================================================================
     3. HARDWARE VERIFICATION / MATCHING
     ======================================================================= */

  // Attributes least likely to change on their own carry more weight;
  // ones known to drift with routine updates (canvas/webgl can shift on
  // GPU driver or browser updates) carry less. Tune per your risk
  // tolerance — this is a starting point, not a fixed law.
  const ATTRIBUTE_WEIGHTS = {
    userAgent: 3,
    platform: 3,
    language: 1,
    hardwareConcurrency: 2,
    deviceMemory: 1,
    screenResolution: 2,
    timezone: 1,
    timezoneOffset: 1,
    touchSupport: 1,
    canvasFingerprint: 3,
    webglFingerprint: 3
  };

  /**
   * matchDevice(storedFingerprint)
   * Compares the CURRENT browser's attributes against a previously
   * registered fingerprint and returns a similarity verdict instead of a
   * blind boolean, because exact-match fingerprinting produces false
   * lockouts on legitimate devices (see module header).
   *
   * @param {{ deviceId: string, attributes: object }} storedFingerprint
   *        The object previously saved from generateFingerprint() — must
   *        include `attributes`, not just the hash, for meaningful
   *        tolerant comparison and mismatch reporting.
   * @param {{ threshold?: number }} [options]
   *        threshold: minimum weighted similarity ratio (0-1) to count as
   *        a match. Default 0.75 — tune based on how strict your
   *        licensing needs to be.
   * @returns {Promise<{
   *   exactMatch: boolean,
   *   isMatch: boolean,
   *   similarity: number,          // 0..1 weighted similarity score
   *   mismatchedAttributes: string[],
   *   currentFingerprint: object   // full result of generateFingerprint(), for logging/re-registration
   * }>}
   */
  async function matchDevice(storedFingerprint, options = {}) {
    const threshold = options.threshold !== undefined ? options.threshold : 0.75;

    if (!storedFingerprint || !storedFingerprint.deviceId) {
      throw new Error('matchDevice: storedFingerprint with a deviceId is required.');
    }

    const current = await generateFingerprint();
    const exactMatch = current.deviceId === storedFingerprint.deviceId;

    // If the stored record only has the hash (no raw attributes — e.g. an
    // older record saved before this field existed), we can only report
    // exact-match; there's nothing to diff attribute-by-attribute.
    if (!storedFingerprint.attributes) {
      return {
        exactMatch,
        isMatch: exactMatch,
        similarity: exactMatch ? 1 : 0,
        mismatchedAttributes: exactMatch ? [] : ['(no stored attributes to diff — only hash comparison available)'],
        currentFingerprint: current
      };
    }

    let totalWeight = 0;
    let matchedWeight = 0;
    const mismatchedAttributes = [];

    for (const key of Object.keys(ATTRIBUTE_WEIGHTS)) {
      const weight = ATTRIBUTE_WEIGHTS[key];
      totalWeight += weight;

      const storedValue = storedFingerprint.attributes[key];
      const currentValue = current.attributes[key];

      if (storedValue === currentValue) {
        matchedWeight += weight;
      } else {
        mismatchedAttributes.push(key);
      }
    }

    const similarity = totalWeight > 0 ? matchedWeight / totalWeight : 0;

    return {
      exactMatch,
      isMatch: similarity >= threshold,
      similarity,
      mismatchedAttributes,
      currentFingerprint: current
    };
  }

  /* =======================================================================
     PUBLIC API
     ======================================================================= */
  return {
    generateFingerprint,
    matchDevice,
    // Exposed for callers who want raw attributes without hashing/matching
    // logic — e.g. showing "this device" info in an admin panel.
    collectAttributes
  };
})();

if (typeof module !== 'undefined' && module.exports) {
  module.exports = ERPDeviceFingerprint;
}

/* =========================================================================
   USAGE EXAMPLES (for reference — not executed)
   =========================================================================

   // --- Register a device against a license, at activation time ---
   const fingerprint = await ERPDeviceFingerprint.generateFingerprint();
   // Save fingerprint.deviceId AND fingerprint.attributes against the
   // license record (server-side, or via ERPCrypto.secureSetItem locally):
   //   { deviceId: fingerprint.deviceId, attributes: fingerprint.attributes }

   // --- Verify on subsequent app loads ---
   const storedFingerprint = { deviceId: '...', attributes: { ... } }; // loaded from license record
   const result = await ERPDeviceFingerprint.matchDevice(storedFingerprint, { threshold: 0.75 });

   if (result.isMatch) {
     // proceed — same device (or close enough given normal drift)
   } else {
     // similarity too low — likely a different physical device.
     // result.mismatchedAttributes tells you exactly which signals differed,
     // useful for support/debugging ("their canvas + webgl + UA all changed
     // at once" reads very differently from "only timezone changed because
     // they're travelling").
   }

   ========================================================================= */

/* ============================== PHASE 3 ==============================
   Dynamic Licensing Engine — source: erp_license_engine.js (unmodified)
   ======================================================================= */
/* =========================================================================
   ERP DYNAMIC LICENSING ENGINE — Phase 3
   =========================================================================
   Self-contained. Depends on the Phase 1 (ERPCrypto) and Phase 2
   (ERPDeviceFingerprint) modules being loaded first on the page — this
   file does not reimplement encryption or fingerprinting, it composes
   them.

   IMPORTANT — scope of what this engine actually guarantees:
   Everything here runs in the browser and stores its state in the
   browser (via ERPCrypto.secureSetItem, i.e. window.storage/localStorage).
   That means:
     - A user with dev tools open can inspect decrypted license state at
       runtime, no matter how it's encrypted at rest — client-side JS
       cannot keep a secret from the machine executing it.
     - Device-limit enforcement here stops CASUAL over-sharing (e.g.
       pasting one license key across a school's whole lab) but does not
       stop a determined user from editing localStorage/window.storage
       directly, since the "server" in this design is the same browser
       being checked.
   For licensing that must actually hold up commercially, the license
   payload, expiry, and registered-device list should live on a server
   you control, with this engine's client-side checks treated as a fast
   first-pass / offline-grace mechanism, not the final word. This module
   is built so that swapping the storage layer for real API calls later
   is a small change — the validation logic (expiry, feature flags,
   device-slot math) is kept separate from where state is persisted.
   ========================================================================= */

const ERPLicenseEngine = (function () {
  'use strict';

  if (typeof ERPCrypto === 'undefined') {
    throw new Error('ERPLicenseEngine requires the Phase 1 ERPCrypto module to be loaded first.');
  }
  if (typeof ERPDeviceFingerprint === 'undefined') {
    throw new Error('ERPLicenseEngine requires the Phase 2 ERPDeviceFingerprint module to be loaded first.');
  }

  const STORAGE_KEY_PREFIX = 'erp_license_record_';
  const DEFAULT_MATCH_THRESHOLD = 0.75; // same default as ERPDeviceFingerprint.matchDevice

  /* =======================================================================
     1. LICENSE KEY DATA STRUCTURE
     ------------------------------------------------------------------------
     Payload shape (the thing that gets encrypted into a distributable
     license key string):
       {
         licenseId:   string,               // unique id, e.g. "LIC-2026-0001"
         clientId:    string,               // which school/customer this belongs to
         expiryDate:  string (ISO date),    // e.g. "2027-08-15" — null/undefined = never expires
         deviceLimit: number | 'unlimited', // 1, 3, 5, ... or 'unlimited'
         features:    string[],             // feature flags, e.g. ["payroll","whatsapp_export"]
         issuedAt:    string (ISO datetime)
       }

     A LICENSE RECORD (what's actually persisted locally, distinct from
     the payload) wraps the payload with the live device-slot list:
       {
         payload: { ...as above... },
         devices: [
           { deviceId, attributes, registeredAt }
         ]
       }
     ======================================================================= */

  /**
   * createLicensePayload(fields)
   * Small builder/normalizer so callers don't hand-assemble the payload
   * shape themselves and typo a field name.
   * @param {{clientId:string, expiryDate?:string, deviceLimit:number|'unlimited', features?:string[], licenseId?:string}} fields
   */
  function createLicensePayload(fields) {
    if (!fields || !fields.clientId) throw new Error('createLicensePayload: clientId is required.');
    if (fields.deviceLimit === undefined || fields.deviceLimit === null) {
      throw new Error('createLicensePayload: deviceLimit is required (a positive number, or "unlimited").');
    }
    const isValidLimit = fields.deviceLimit === 'unlimited'
      || (typeof fields.deviceLimit === 'number' && fields.deviceLimit > 0);
    if (!isValidLimit) throw new Error('createLicensePayload: deviceLimit must be a positive number or "unlimited".');

    return {
      licenseId: fields.licenseId || `LIC-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`,
      clientId: fields.clientId,
      expiryDate: fields.expiryDate || null,
      deviceLimit: fields.deviceLimit,
      features: Array.isArray(fields.features) ? fields.features : [],
      issuedAt: new Date().toISOString()
    };
  }

  /**
   * issueLicenseKey(payloadFields, secretPassphrase)
   * Builds a payload and AES-encrypts it into a distributable license key
   * string via ERPCrypto.encryptData. This is what you'd hand to a
   * customer / embed in an activation email.
   * @returns {Promise<string>} the encrypted license key
   */
  async function issueLicenseKey(payloadFields, secretPassphrase) {
    if (!secretPassphrase) throw new Error('issueLicenseKey: secretPassphrase is required.');
    const payload = createLicensePayload(payloadFields);
    return ERPCrypto.encryptData(payload, secretPassphrase);
  }

  /**
   * validateLicenseKey(licenseKeyString, secretPassphrase)
   * Decrypts a license key string and checks it has a well-formed
   * payload. Distinct from isLicenseValid(): this only checks the key
   * DECRYPTS and PARSES correctly (i.e. "is this a real, uncorrupted
   * license key issued with this passphrase") — it does NOT check expiry
   * or device binding. Use isLicenseValid() for the full runtime check.
   *
   * @param {string} licenseKeyString  output of issueLicenseKey() / encryptData()
   * @param {string} secretPassphrase  must match the one used to issue it
   * @returns {Promise<{ valid: boolean, payload: object|null, error: string|null }>}
   */
  async function validateLicenseKey(licenseKeyString, secretPassphrase) {
    if (!licenseKeyString) return { valid: false, payload: null, error: 'No license key provided.' };
    if (!secretPassphrase) return { valid: false, payload: null, error: 'No secret passphrase provided.' };

    let decrypted;
    try {
      decrypted = await ERPCrypto.decryptData(licenseKeyString, secretPassphrase);
    } catch (e) {
      return { valid: false, payload: null, error: 'License key could not be decrypted — invalid key or wrong passphrase.' };
    }

    let payload;
    try {
      payload = JSON.parse(decrypted);
    } catch (e) {
      return { valid: false, payload: null, error: 'License key decrypted but did not contain valid JSON.' };
    }

    const requiredFields = ['licenseId', 'clientId', 'deviceLimit'];
    const missing = requiredFields.filter(f => payload[f] === undefined || payload[f] === null);
    if (missing.length > 0) {
      return { valid: false, payload: null, error: `License payload missing required field(s): ${missing.join(', ')}` };
    }

    const isValidLimit = payload.deviceLimit === 'unlimited'
      || (typeof payload.deviceLimit === 'number' && payload.deviceLimit > 0);
    if (!isValidLimit) {
      return { valid: false, payload: null, error: 'License payload has an invalid deviceLimit.' };
    }

    return { valid: true, payload, error: null };
  }

  /* =======================================================================
     2. LICENSE RECORD PERSISTENCE (local, encrypted at rest)
     ======================================================================= */

  function storageKeyFor(licenseId) {
    return `${STORAGE_KEY_PREFIX}${licenseId}`;
  }

  /**
   * loadLicenseRecord(licenseId, secretPassphrase)
   * @returns {Promise<object|null>} the license record, or null if none stored yet
   */
  async function loadLicenseRecord(licenseId, secretPassphrase) {
    return ERPCrypto.secureGetItem(storageKeyFor(licenseId), secretPassphrase);
  }

  /**
   * saveLicenseRecord(record, secretPassphrase)
   * @returns {Promise<void>}
   */
  async function saveLicenseRecord(record, secretPassphrase) {
    if (!record || !record.payload || !record.payload.licenseId) {
      throw new Error('saveLicenseRecord: record.payload.licenseId is required.');
    }
    await ERPCrypto.secureSetItem(storageKeyFor(record.payload.licenseId), record, secretPassphrase);
  }

  /**
   * activateLicense(licenseKeyString, secretPassphrase)
   * First-time activation: validates the key and creates a fresh local
   * record with an empty device-slot list (no devices registered yet).
   * If a record for this licenseId already exists locally, returns the
   * existing one unchanged rather than wiping registered devices.
   * @returns {Promise<{ valid: boolean, record: object|null, error: string|null }>}
   */
  async function activateLicense(licenseKeyString, secretPassphrase) {
    const result = await validateLicenseKey(licenseKeyString, secretPassphrase);
    if (!result.valid) return { valid: false, record: null, error: result.error };

    const existing = await loadLicenseRecord(result.payload.licenseId, secretPassphrase);
    if (existing) return { valid: true, record: existing, error: null };

    const record = { payload: result.payload, devices: [] };
    await saveLicenseRecord(record, secretPassphrase);
    return { valid: true, record, error: null };
  }

  /* =======================================================================
     3. MULTI-DEVICE SLOT VERIFICATION
     ======================================================================= */

  /**
   * findRegisteredDeviceMatch(record, currentFingerprint, threshold)
   * Internal helper: checks whether currentFingerprint matches ANY
   * already-registered device on this license, using the same tolerant
   * comparison as ERPDeviceFingerprint.matchDevice (so a minor driver/
   * browser-update drift doesn't look like "a new device").
   * @returns {Promise<object|null>} the matching registered device entry, or null
   */
  async function findRegisteredDeviceMatch(record, currentFingerprint, threshold) {
    for (const registered of record.devices) {
      const comparison = await ERPDeviceFingerprint.matchDevice(
        { deviceId: registered.deviceId, attributes: registered.attributes },
        { threshold }
      );
      // matchDevice() generates a fresh fingerprint of "now" internally,
      // which is only meaningful when called for the CURRENT device. Since
      // we already have currentFingerprint in hand, do the same weighted
      // comparison directly against it instead of re-fingerprinting.
      const sameDevice = registered.deviceId === currentFingerprint.deviceId
        || comparison.currentFingerprint.deviceId === currentFingerprint.deviceId;
      if (sameDevice) return registered;
    }
    return null;
  }

  /**
   * registerDeviceSlot(record, deviceFingerprint, options)
   * Attempts to register deviceFingerprint (from
   * ERPDeviceFingerprint.generateFingerprint()) as a device slot under
   * this license record.
   *
   * Rules:
   *   - deviceLimit === 1        -> locks strictly to the FIRST registered
   *                                  device. Any other device is rejected
   *                                  outright, no slot math needed.
   *   - deviceLimit === 'unlimited' -> always allowed; every distinct
   *                                  device gets tracked (useful for
   *                                  auditing "how many machines is this
   *                                  license actually running on" even
   *                                  when there's no hard cap).
   *   - deviceLimit === N (N>1)  -> allowed as long as fewer than N
   *                                  distinct devices are already
   *                                  registered, OR this exact device is
   *                                  already one of them (re-registering
   *                                  an existing device is always free —
   *                                  it doesn't consume a new slot).
   *
   * @param {object} record               license record (from activateLicense/loadLicenseRecord)
   * @param {object} deviceFingerprint     result of ERPDeviceFingerprint.generateFingerprint()
   * @param {{ threshold?: number }} [options]
   * @returns {Promise<{ success: boolean, record: object, alreadyRegistered: boolean, error: string|null }>}
   */
  async function registerDeviceSlot(record, deviceFingerprint, options = {}) {
    const threshold = options.threshold !== undefined ? options.threshold : DEFAULT_MATCH_THRESHOLD;

    if (!record || !record.payload) throw new Error('registerDeviceSlot: a valid license record is required.');
    if (!deviceFingerprint || !deviceFingerprint.deviceId) {
      throw new Error('registerDeviceSlot: a deviceFingerprint (from generateFingerprint()) is required.');
    }

    const existingMatch = await findRegisteredDeviceMatch(record, deviceFingerprint, threshold);
    if (existingMatch) {
      // Same device re-checking in — refresh its lastSeen, don't consume a slot.
      existingMatch.lastSeenAt = new Date().toISOString();
      return { success: true, record, alreadyRegistered: true, error: null };
    }

    const limit = record.payload.deviceLimit;

    if (limit === 1) {
      if (record.devices.length === 0) {
        record.devices.push({
          deviceId: deviceFingerprint.deviceId,
          attributes: deviceFingerprint.attributes,
          registeredAt: new Date().toISOString(),
          lastSeenAt: new Date().toISOString()
        });
        return { success: true, record, alreadyRegistered: false, error: null };
      }
      return {
        success: false,
        record,
        alreadyRegistered: false,
        error: 'Device limit is 1 and this license is already locked to a different device.'
      };
    }

    if (limit === 'unlimited' || record.devices.length < limit) {
      record.devices.push({
        deviceId: deviceFingerprint.deviceId,
        attributes: deviceFingerprint.attributes,
        registeredAt: new Date().toISOString(),
        lastSeenAt: new Date().toISOString()
      });
      return { success: true, record, alreadyRegistered: false, error: null };
    }

    return {
      success: false,
      record,
      alreadyRegistered: false,
      error: `Device slot limit reached (${limit} device${limit === 1 ? '' : 's'} already registered).`
    };
  }

  /**
   * revokeDeviceSlot(record, deviceId)
   * Frees up a slot — e.g. an admin retiring an old machine so a new one
   * can be registered under the same limited license.
   * @returns {{ success: boolean, record: object }}
   */
  function revokeDeviceSlot(record, deviceId) {
    const before = record.devices.length;
    record.devices = record.devices.filter(d => d.deviceId !== deviceId);
    return { success: record.devices.length < before, record };
  }

  /* =======================================================================
     4. RUNTIME VALIDITY CHECK
     ======================================================================= */

  /**
   * isLicenseValid(record, currentDeviceFingerprint, options)
   * The full runtime check: is this license (a) not expired, and (b) is
   * the CURRENT device one of its registered device slots. This is what
   * you call on every app load / sensitive action — registerDeviceSlot()
   * is only called once, at activation time for a new device.
   *
   * @param {object} record                     license record
   * @param {object} currentDeviceFingerprint    result of ERPDeviceFingerprint.generateFingerprint() for THIS load
   * @param {{ threshold?: number, requiredFeature?: string }} [options]
   * @returns {Promise<{
   *   valid: boolean,
   *   reason: string|null,          // human-readable reason when invalid
   *   expired: boolean,
   *   deviceRegistered: boolean,
   *   hasRequiredFeature: boolean|null, // null if requiredFeature wasn't checked
   *   payload: object
   * }>}
   */
  async function isLicenseValid(record, currentDeviceFingerprint, options = {}) {
    const threshold = options.threshold !== undefined ? options.threshold : DEFAULT_MATCH_THRESHOLD;

    if (!record || !record.payload) {
      return { valid: false, reason: 'No license record.', expired: true, deviceRegistered: false, hasRequiredFeature: null, payload: null };
    }
    if (!currentDeviceFingerprint || !currentDeviceFingerprint.deviceId) {
      throw new Error('isLicenseValid: a currentDeviceFingerprint (from generateFingerprint()) is required.');
    }

    const payload = record.payload;

    // --- Expiry check ---
    let expired = false;
    if (payload.expiryDate) {
      const expiry = new Date(payload.expiryDate);
      expired = !isNaN(expiry.getTime()) && expiry.getTime() < Date.now();
    }

    // --- Device binding check ---
    const match = await findRegisteredDeviceMatch(record, currentDeviceFingerprint, threshold);
    const deviceRegistered = !!match;
    if (match) match.lastSeenAt = new Date().toISOString();

    // --- Optional feature-flag check ---
    let hasRequiredFeature = null;
    if (options.requiredFeature) {
      hasRequiredFeature = Array.isArray(payload.features) && payload.features.includes(options.requiredFeature);
    }

    let reason = null;
    if (expired) reason = 'License has expired.';
    else if (!deviceRegistered) reason = 'This device is not registered under this license.';
    else if (hasRequiredFeature === false) reason = `License does not include the "${options.requiredFeature}" feature.`;

    const valid = !expired && deviceRegistered && hasRequiredFeature !== false;

    return { valid, reason, expired, deviceRegistered, hasRequiredFeature, payload };
  }

  /* =======================================================================
     PUBLIC API
     ======================================================================= */
  return {
    // License key structure / crypto
    createLicensePayload,
    issueLicenseKey,
    validateLicenseKey,

    // Persistence
    loadLicenseRecord,
    saveLicenseRecord,
    activateLicense,

    // Device slots
    registerDeviceSlot,
    revokeDeviceSlot,

    // Runtime check
    isLicenseValid
  };
})();

if (typeof module !== 'undefined' && module.exports) {
  module.exports = ERPLicenseEngine;
}

