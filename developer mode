    if(btn.dataset.tab==='settings') { renderSettingsPanel(); applyBranding(); renderManageUsers(); }
    if(btn.dataset.tab==='payroll') { renderStaffDirectory(); renderPayrollProcessing(); renderExpenses(); renderPL(); }
    if(btn.dataset.tab==='devcontrol') { renderDevControl(); }
    if(btn.dataset.tab==='exam') { switchExamSubTab('individual'); }
    if(btn.dataset.tab==='reports') { /* filters persist; user clicks Generate to (re)build each log */ }
    if(btn.dataset.tab==='ledger') { /* ledger renders on student selection */ }
