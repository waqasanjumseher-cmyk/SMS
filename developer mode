/* ---- Staff Password Reset Engine -----------------------------------
   Inline modal (reuses the existing .modal-bg/.modal-box chrome) so
   resetting a forgotten staff password doesn't require deleting and
   re-creating the whole account. Writes straight back into the same
   scoped erpUsers array/localStorage key everything else here uses —
   no other array or student data is touched. ---------------------- */
let pwResetTargetId = null;

function openPwResetModal(id){
  const u = appUsers.find(u=>u.id===id);
  if(!u) return;
  pwResetTargetId = id;
  document.getElementById('pwResetUserLabel').textContent = `Set a new password for ${escapeHtml(u.name)} (${u.username})`;
  document.getElementById('pwResetNewPassword').value = '';
  document.getElementById('pwResetModalBg').classList.add('show');
  setTimeout(()=>document.getElementById('pwResetNewPassword').focus(), 50);
}
function closePwResetModal(){
  document.getElementById('pwResetModalBg').classList.remove('show');
  pwResetTargetId = null;
}
document.getElementById('pwResetModalBg').addEventListener('click', e=>{
  if(e.target.id==='pwResetModalBg') closePwResetModal();
});
document.getElementById('pwResetConfirmBtn').addEventListener('click', async ()=>{
  const newPass = document.getElementById('pwResetNewPassword').value;
  if(!newPass || newPass.length < 4){ toast('Enter a password (min 4 characters)'); return; }
  const u = appUsers.find(u=>u.id===pwResetTargetId);
  if(!u){ closePwResetModal(); return; }
  u.password = await hashStaffPassword(newPass); // PBKDF2, same as addUserBtn — never store the reset password in plain text
  const ok = await saveKey('erpUsers', appUsers); // same scoped key as create/edit/remove — students/vouchers/etc untouched
  closePwResetModal();
  if(ok){
    toast(`Password updated for ${escapeHtml(u.name)}`);
    alert(`Password successfully reset for ${escapeHtml(u.name)} (${u.username}).`);
  }
  renderManageUsers();
});

function editUser(id){
  const u = appUsers.find(u=>u.id===id);
  if(!u) return;
  editingStaffId = id;
  document.getElementById('nu_name').value = u.name;
  document.getElementById('nu_username').value = u.username;
  document.getElementById('nu_email').value = u.email || '';
  document.getElementById('nu_password').value = '';
  document.getElementById('nu_password').placeholder = 'Leave blank to keep current password';
  document.getElementById('nu_role').value = u.role;
  document.getElementById('addUserBtn').textContent = 'Save Changes';
  document.getElementById('cancelEditUserBtn').style.display = 'inline-flex';
