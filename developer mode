document.getElementById('addUserBtn').addEventListener('click', async ()=>{
  const name = document.getElementById('nu_name').value.trim();
  const username = document.getElementById('nu_username').value.trim();
  const email = document.getElementById('nu_email').value.trim().toLowerCase();
  const password = document.getElementById('nu_password').value;
  const role = document.getElementById('nu_role').value;
  const permissions = Array.from(document.querySelectorAll('.nu-perm:checked')).map(c=>c.value);

  if(!name || !username || (!editingStaffId && !password)){ toast('Fill in all fields to save this user'); return; }
  const usernameTaken = username.toLowerCase()===MASTER_USERNAME.toLowerCase()
    || (currentSchool && username.toLowerCase()===currentSchool.ownerUsername.toLowerCase())
    || appUsers.some(u=>u.username.toLowerCase()===username.toLowerCase() && u.id!==editingStaffId);
  if(usernameTaken){ toast('That username is already taken'); return; }
  if(email){
    const emailTaken = (currentSchool && email===(currentSchool.ownerEmail||'').toLowerCase())
      || appUsers.some(u=>(u.email||'').toLowerCase()===email && u.id!==editingStaffId);
    if(emailTaken){ toast('That Google account email is already linked to another account'); return; }
  }

  /* ---- Security Upgrade: staff passwords are salted + iterated
     (PBKDF2, see hashStaffPassword above) before they ever reach the
     appUsers array / localStorage. Only hash when a password was
     actually typed (edit mode allows leaving it blank to keep the
     current hash unchanged). ----------------------------------------- */
  if(editingStaffId){
    const u = appUsers.find(u=>u.id===editingStaffId);
    if(u){
      u.name = name; u.username = username; u.email = email; u.role = role; u.permissions = permissions;
      if(password) u.password = await hashStaffPassword(password);
    }
    toast('Staff account updated');
  } else {
    appUsers.push({ id: uid('u_'), username, email, password: await hashStaffPassword(password), name, role, permissions });
    toast('Staff account created');
  }
  await saveKey('erpUsers', appUsers);
  resetStaffForm();
  renderManageUsers();
});

