/* Finds this student's voucher for the target month if one already
   exists (reused as-is, never duplicated — mirrors the "skip if
   already generated" rule the Bulk Installments generator above
   uses), otherwise builds and persists a fresh Unpaid one from the
   student's own fee profile, exactly the way the single-voucher and
   bulk-installment generators already do. */
function bv_getOrCreateMonthVoucher(student, month){
  let v = vouchers.find(x=>x.studentId===student.id && x.month===month);
  if(v) return { voucher:v, created:false };
  const items = buildAutoFeeItems(student);
  const total = items.reduce((a,b)=>a+Number(b.amount||0),0);
  v = {
    id: uid('FV'), studentId: student.id, month, items, total, paid:0,
    balance: total, status:'Unpaid', date: new Date().toISOString().slice(0,10)
  };
  vouchers.push(v);
  if(items.some(it=>it.oneTime) && !student.admissionFeeCharged) student.admissionFeeCharged = true;
  return { voucher:v, created:true };
}
/* Sum of every OTHER outstanding voucher this student has, i.e. dues
   carried over from prior periods — never the period being printed
   right now, so it's never counted twice on the same sheet. */
function bv_priorBalance(student, excludeVoucherId){
  return vouchers
    .filter(x=>x.studentId===student.id && x.id!==excludeVoucherId && Number(x.balance||0)>0)
    .reduce((a,x)=>a+Number(x.balance||0), 0);
}

function bv_cardHtml(student, voucher, priorBalance){
