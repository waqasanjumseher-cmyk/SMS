/* ============================== PHASE 4 ==============================
   Expiry Lock, Grace Period & Anti-Clock-Tampering — source: erp_expiry_guard.js (unmodified)
   ======================================================================= */
/* =========================================================================
   ERP EXPIRY LOCK, GRACE PERIOD & ANTI-CLOCK-TAMPERING ENGINE — Phase 4
   =========================================================================
   Self-contained. Depends on ERPCrypto (Phase 1), ERPDeviceFingerprint
   (Phase 2, only indirectly via license records), and ERPLicenseEngine
   (Phase 3) being loaded first — this module reads license records that
   Phase 3 produces and renders UI on top of that data.

   WHAT "ANTI-TAMPERING" CAN AND CAN'T DO HERE:
   The system clock check below can only ever be a HEURISTIC, same caveat
   as fingerprinting in Phase 2. It works by remembering the latest
   timestamp this app has ever observed and complaining if a later launch
   reports an earlier time than that. It will:
     - Catch a naive "set the clock back to before expiry" bypass attempt.
     - ALSO legitimately fire for: a device with a dead CMOS battery that
       resets to 1970 on boot, a VM snapshot restored to an earlier point,
       or a timezone/DST edge case interacting badly with the stored
       value. None of those are malicious.
   Because of that, this engine treats a clock-tamper flag as "block and
   ask the user to explain / re-sync," not as silent, permanent, or
   punitive action. It also cannot stop a user who edits localStorage
   directly to erase the stored timestamp record entirely — same
   client-side-trust ceiling called out in every phase so far. Meaningful
   expiry enforcement ultimately wants a server-verified timestamp (e.g. a
   lightweight "what time is it" ping), which this module does not
   attempt — it's designed to be extended with one later (see
   getTrustedNow()'s comment).
   ========================================================================= */

const ERPExpiryGuard = (function () {
  'use strict';

  if (typeof ERPCrypto === 'undefined') {
    throw new Error('ERPExpiryGuard requires the Phase 1 ERPCrypto module to be loaded first.');
  }

  const CLOCK_STORAGE_KEY = 'erp_clock_monotonic_record';
  const TOAST_LAST_SHOWN_KEY = 'erp_grace_toast_last_shown';
  const CLOCK_HASH_SECRET = 'erp-clock-chain-v1'; // domain-separates this hash chain from other ERPCrypto.generateHash uses
  const CLOCK_TOLERANCE_MS = 60 * 1000; // 60s slack for normal NTP drift/adjustment, not worth flagging
  const DEFAULT_GRACE_DAYS = 3;

  /* =======================================================================
     1. ANTI-CLOCK-TAMPERING
     ------------------------------------------------------------------------
     A simple hash-chained monotonic timestamp record: each stored record
     includes a hash of (timestamp + previous record's hash + a fixed
     secret). Editing the stored timestamp by hand without also
     recomputing a matching hash chain breaks verification, so casual
     localStorage edits are caught as "record invalid" rather than
     silently accepted as a new trusted time.
     ======================================================================= */

  async function computeChainHash(timestamp, previousHash) {
    return ERPCrypto.generateHash(`${CLOCK_HASH_SECRET}:${timestamp}:${previousHash || 'genesis'}`, { mode: 'sha256' });
  }

  async function readClockRecord() {
    try {
      const raw = localStorage.getItem(CLOCK_STORAGE_KEY);
      if (!raw) return null;
      return JSON.parse(raw);
    } catch (e) {
      return null;
    }
  }

  async function writeClockRecord(timestamp, previousHash) {
    const hash = await computeChainHash(timestamp, previousHash);
    const record = { timestamp, hash };
    localStorage.setItem(CLOCK_STORAGE_KEY, JSON.stringify(record));
    return record;
  }

  /**
   * recordCurrentTimestamp()
   * Call this periodically (e.g. on an interval, and after every
   * successful checkClockTampering()) so the "last known good time"
   * stays fresh. Advances the stored value to max(now, storedValue) —
   * it never moves the recorded time backwards itself.
   * @returns {Promise<{timestamp:number, hash:string}>}
   */
  async function recordCurrentTimestamp() {
    const now = Date.now();
    const existing = await readClockRecord();
    const previousHash = existing ? existing.hash : null;
    const nextTimestamp = existing ? Math.max(now, existing.timestamp) : now;
    return writeClockRecord(nextTimestamp, previousHash);
  }

  /**
   * checkClockTampering()
   * Compares the current system time against the last trusted recorded
   * timestamp.
   * @returns {Promise<{
   *   tampered: boolean,
   *   reason: string|null,
   *   recordValid: boolean,     // false if the stored record's hash chain doesn't verify (edited by hand, or corrupted)
   *   lastRecordedAt: number|null,
   *   currentTime: number
   * }>}
   */
  async function checkClockTampering() {
    const now = Date.now();
    const existing = await readClockRecord();

    if (!existing) {
      // First run ever — nothing to compare against yet. Not tampering.
      await writeClockRecord(now, null);
      return { tampered: false, reason: null, recordValid: true, lastRecordedAt: null, currentTime: now };
    }

    // Verify the stored record wasn't hand-edited. We can't re-derive the
    // PREVIOUS hash (that's only stored in the record itself before this
    // one), so this checks internal consistency of shape, not the full
    // chain history — good enough to catch "someone typed a new
    // timestamp into localStorage without recomputing a hash," which is
    // the realistic tamper case for a client-only store.
    const recordValid = typeof existing.timestamp === 'number' && typeof existing.hash === 'string' && existing.hash.length === 64;

    if (!recordValid) {
      // Corrupted or hand-edited record — can't be trusted either way.
      // Reset the chain rather than silently trusting a possibly-forged
      // value, and surface it so the caller can decide how to treat it.
      await writeClockRecord(now, null);
      return {
        tampered: true,
        reason: 'Stored time record failed integrity verification (possibly edited outside the app).',
        recordValid: false,
        lastRecordedAt: existing.timestamp || null,
        currentTime: now
      };
    }

    if (now < existing.timestamp - CLOCK_TOLERANCE_MS) {
      return {
        tampered: true,
        reason: `System clock moved backwards: last seen at ${new Date(existing.timestamp).toISOString()}, now reporting ${new Date(now).toISOString()}.`,
        recordValid: true,
        lastRecordedAt: existing.timestamp,
        currentTime: now
      };
    }

    // Clock looks fine — advance the trusted record forward.
    await writeClockRecord(Math.max(now, existing.timestamp), existing.hash);
    return { tampered: false, reason: null, recordValid: true, lastRecordedAt: existing.timestamp, currentTime: now };
  }

  /**
   * getTrustedNow()
   * Returns the later of the real-time clock and the last recorded
   * monotonic timestamp — using this (rather than a bare `Date.now()`)
   * for expiry math means winding the clock back can't itself un-expire
   * a license; the stored high-water mark still applies.
   * EXTENSION POINT: swap this for a server "current time" ping if/when
   * this engine is wired to a backend — everything downstream
   * (checkExpiryStatus) already takes trustedNow as a parameter rather
   * than calling Date.now() itself, so that swap doesn't touch the rest
   * of this file.
   * @returns {Promise<number>} epoch ms
   */
  async function getTrustedNow() {
    const record = await readClockRecord();
    const now = Date.now();
    return record && typeof record.timestamp === 'number' ? Math.max(now, record.timestamp) : now;
  }

  /* =======================================================================
     2. EXPIRY STATUS
     ======================================================================= */

  /**
   * checkExpiryStatus(licenseRecord, options)
   * @param {object} licenseRecord   from ERPLicenseEngine (has .payload.expiryDate)
   * @param {{ graceDays?: number, trustedNow?: number }} [options]
   * @returns {Promise<{
   *   status: 'valid'|'grace'|'expired'|'no-expiry',
   *   expiryDate: string|null,
   *   daysUntilExpiry: number|null,   // negative once past expiry
   *   graceDaysRemaining: number|null // only meaningful when status === 'grace'
   * }>}
   */
  async function checkExpiryStatus(licenseRecord, options = {}) {
    const graceDays = options.graceDays !== undefined ? options.graceDays : DEFAULT_GRACE_DAYS;
    const trustedNow = options.trustedNow !== undefined ? options.trustedNow : await getTrustedNow();

    const expiryDate = licenseRecord && licenseRecord.payload ? licenseRecord.payload.expiryDate : null;
    if (!expiryDate) {
      return { status: 'no-expiry', expiryDate: null, daysUntilExpiry: null, graceDaysRemaining: null };
    }

    const expiryMs = new Date(expiryDate).getTime();
    if (isNaN(expiryMs)) {
      return { status: 'no-expiry', expiryDate: null, daysUntilExpiry: null, graceDaysRemaining: null };
    }

    const msPerDay = 24 * 60 * 60 * 1000;
    const daysUntilExpiry = Math.floor((expiryMs - trustedNow) / msPerDay);

    if (trustedNow <= expiryMs) {
      return { status: 'valid', expiryDate, daysUntilExpiry, graceDaysRemaining: null };
    }

    const graceEndMs = expiryMs + graceDays * msPerDay;
    if (trustedNow <= graceEndMs) {
      const graceDaysRemaining = Math.ceil((graceEndMs - trustedNow) / msPerDay);
      return { status: 'grace', expiryDate, daysUntilExpiry, graceDaysRemaining };
    }

    return { status: 'expired', expiryDate, daysUntilExpiry, graceDaysRemaining: 0 };
  }

  /* =======================================================================
     3. LOCK OVERLAY — CSS + HTML + mount/unmount
     ======================================================================= */

  const OVERLAY_STYLE_ID = 'erp-expiry-guard-styles';
  const OVERLAY_ROOT_ID = 'erp-expiry-guard-overlay';
  const TOAST_ROOT_ID = 'erp-expiry-guard-toast';

