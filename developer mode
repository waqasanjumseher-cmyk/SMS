/* ============================================================
   Universal Hex-Code Customizer & Light Theme Engine
   One reusable builder powers both the School Settings palette
   and the Master Developer Console palette. Each instance binds
   a fixed set of CSS custom properties on <html>, persists the
   chosen hex values to their own LocalStorage key, and applies
   them live via style.setProperty (inline style always wins over
   the stylesheet, so this layers cleanly on top of the preset
   theme swatches above without fighting them).
   ============================================================ */
const HEX_RE = /^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/;

function normalizeHex3(hex){
  // expand shorthand #abc -> #aabbcc so <input type="color"> accepts it
  if(/^#([0-9a-fA-F]{3})$/.test(hex)){
    return '#' + hex.slice(1).split('').map(c=>c+c).join('');
  }
  return hex;
}

function buildHexCustomizer(containerId, storageKey, fields){
  const container = document.getElementById(containerId);
  if(!container) return;
  let saved = {};
  try{ saved = JSON.parse(localStorage.getItem(storageKey) || '{}'); }catch(e){ saved = {}; }

  container.innerHTML = fields.map(f=>{
    const val = saved[f.varName] || f.defaultHex;
    return `
      <div class="hex-row">
        <span class="hex-label">${f.label}</span>
        <input type="color" data-var="${f.varName}" value="${normalizeHex3(val)}">
        <input type="text" class="hex-text" data-var="${f.varName}" value="${val}" maxlength="7" placeholder="#RRGGBB">
      </div>`;
  }).join('');

  function applyValue(varName, hex){
    document.documentElement.style.setProperty(varName, hex);
  }
  function persist(varName, hex){
    let store = {};
    try{ store = JSON.parse(localStorage.getItem(storageKey) || '{}'); }catch(e){ store = {}; }
    store[varName] = hex;
    localStorage.setItem(storageKey, JSON.stringify(store));
  }

  // apply whatever was saved (or the defaults) immediately
  fields.forEach(f=>{
    applyValue(f.varName, saved[f.varName] || f.defaultHex);
  });

  container.querySelectorAll('input[type="color"]').forEach(picker=>{
    picker.addEventListener('input', ()=>{
      const varName = picker.dataset.var;
      const hex = picker.value;
      applyValue(varName, hex);
      persist(varName, hex);
      const twin = container.querySelector(`.hex-text[data-var="${varName}"]`);
      if(twin) twin.value = hex;
    });
  });

  container.querySelectorAll('input.hex-text').forEach(textInput=>{
    textInput.addEventListener('input', ()=>{
      const varName = textInput.dataset.var;
      let hex = textInput.value.trim();
      if(!hex.startsWith('#')) hex = '#' + hex;
      if(!HEX_RE.test(hex)) return; // wait for a valid hex before applying
      applyValue(varName, hex);
      persist(varName, hex);
      const twin = container.querySelector(`input[type="color"][data-var="${varName}"]`);
      if(twin) twin.value = normalizeHex3(hex);
    });
  });
}

function resetHexCustomizer(containerId, storageKey, fields){
  localStorage.removeItem(storageKey);
  fields.forEach(f=> document.documentElement.style.removeProperty(f.varName));
  buildHexCustomizer(containerId, storageKey, fields);
}

