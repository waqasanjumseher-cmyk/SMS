async function renderDevControl(){
  const tbody = document.getElementById('devSchoolsTable');
  if(!tbody) return;
  renderCloudConfigPanel();
  renderGlobalFeatureFlags();

  // Active-student counts per school, fetched directly from each
  // school's own scoped storage — powers both the KPI bar total and
  // the per-card/per-row figure below.
  const activeCounts = {};
  let totalActive = 0;
  for(const s of schools){
    const n = await countActiveStudents(s.id);
    activeCounts[s.id] = n;
    totalActive += n;
  }
  renderDevOverviewGrid(schools.length, totalActive);
  renderDevSchoolCards(activeCounts);

  tbody.innerHTML = schools.map(s => {
    ensureSchoolModuleConfig(s); // Phase 1 — backfills package/moduleFlags for older records
    const pendingReqs = (s.upgradeRequests||[]).filter(r=>r.status==='pending');
    return `
    <tr>
      <td>
        <b>${escapeHtml(s.name)}</b><br>
        <span class="muted">Owner: ${escapeHtml(s.ownerUsername)}</span><br>
        <span class="muted">Created: ${new Date(s.createdAt).toLocaleDateString()}</span><br>
        <span class="muted">🧑‍🎓 Active Students: <b>${activeCounts[s.id] ?? 0}</b></span>
      </td>
      <td>
        ${FEATURE_DEFS.map(f => `
          <label class="checkfee" style="border-bottom:none;">
            <input type="checkbox" class="dev-feature" data-school="${s.id}" data-feature="${f.key}" ${s.features[f.key] ? 'checked' : ''}>
            <span>${escapeHtml(f.label)}</span>
          </label>`).join('')}
      </td>
      <td>
        <select class="dev-edit-package" data-school="${s.id}" style="margin-bottom:6px;">
          ${Object.keys(PACKAGES).map(p => `<option value="${p}" ${s.package===p?'selected':''}>${p}</option>`).join('')}
        </select>
        ${MODULE_DEFS.map(m => `
          <label class="checkfee" style="border-bottom:none;">
            <input type="checkbox" class="dev-edit-module" data-school="${s.id}" data-module="${m.key}" ${s.moduleFlags[m.key] ? 'checked' : ''}>
            <span>${escapeHtml(m.label)}</span>
          </label>`).join('')}
        ${pendingReqs.length ? `
          <div style="margin-top:8px;padding:6px 8px;background:#fff8e1;border:1px solid var(--gold);border-radius:6px;font-size:11.5px;">
            <b>📩 ${pendingReqs.length} pending request(s):</b><br>
            ${pendingReqs.map(r => `
              ${escapeHtml(r.label)} — <button class="btn small gold" style="padding:1px 6px;font-size:10px;" onclick="approveUpgradeRequest('${s.id}','${r.module}')">Approve</button>
              <button class="btn small ghost" style="padding:1px 6px;font-size:10px;" onclick="dismissUpgradeRequest('${s.id}','${r.module}')">Dismiss</button><br>`).join('')}
          </div>` : ''}
      </td>
      <td style="vertical-align:top;">
        <button class="btn small secondary" onclick="openSchoolSettingsAsDev('${s.id}')">🔍 Quick Inspect / Manage</button>
        <button class="btn small danger" onclick="deleteSchool('${s.id}')">Delete School</button>
      </td>
    </tr>`;
  }).join('') || `<tr><td colspan="4" class="muted">No client schools provisioned yet — create one above.</td></tr>`;

  document.querySelectorAll('.dev-feature').forEach(cb=>{
    cb.addEventListener('change', async ()=>{
      const school = schools.find(s=>s.id===cb.dataset.school);
      if(!school) return;
      school.features[cb.dataset.feature] = cb.checked;
      await saveGlobal('erp_schools', schools);
      toast(`${escapeHtml(school.name)}: ${FEATURE_DEFS.find(f=>f.key===cb.dataset.feature).label} ${cb.checked ? 'enabled' : 'disabled'}`);
    });
  });

  // Phase 1: package preset + individual module editing for existing schools
  document.querySelectorAll('.dev-edit-package').forEach(sel => {
    sel.addEventListener('change', async () => {
      const school = schools.find(s => s.id === sel.dataset.school);
      if(!school) return;
      school.package = sel.value;
      const preset = PACKAGES[sel.value];
      if(preset) school.moduleFlags = Object.assign({}, preset); // Custom leaves existing flags alone
      await saveGlobal('erp_schools', schools);
      await saveSchoolModuleConfigToFirestore(school);
      renderDevControl();
      toast(`${escapeHtml(school.name)}: package set to ${sel.value}`);
    });
  });
  document.querySelectorAll('.dev-edit-module').forEach(cb => {
    cb.addEventListener('change', async () => {
      const school = schools.find(s => s.id === cb.dataset.school);
      if(!school) return;
      school.moduleFlags[cb.dataset.module] = cb.checked;
      await saveGlobal('erp_schools', schools);
      await saveSchoolModuleConfigToFirestore(school);
      toast(`${escapeHtml(school.name)}: ${MODULE_DEFS.find(m=>m.key===cb.dataset.module).label} ${cb.checked ? 'enabled' : 'disabled'}`);
    });
  });
}

/* Phase 3: Approve/Dismiss handlers for upgrade requests raised from the
   client app (see requestModuleUpgrade() in the client file). */
async function approveUpgradeRequest(schoolId, moduleKey){
  const school = schools.find(s=>s.id===schoolId);
  if(!school) return;
  ensureSchoolModuleConfig(school);
  school.moduleFlags[moduleKey] = true;
  school.package = 'Custom'; // a manual grant no longer matches a clean preset
  (school.upgradeRequests||[]).forEach(r => { if(r.module===moduleKey && r.status==='pending') r.status='approved'; });
  await saveGlobal('erp_schools', schools);
  await saveSchoolModuleConfigToFirestore(school);
  renderDevControl();
  toast(`${escapeHtml(school.name)}: ${MODULE_DEFS.find(m=>m.key===moduleKey).label} enabled`);
}
async function dismissUpgradeRequest(schoolId, moduleKey){
  const school = schools.find(s=>s.id===schoolId);
  if(!school) return;
  const now = new Date().toISOString();
  (school.upgradeRequests||[]).forEach(r => {
    if(r.module===moduleKey && r.status==='pending'){ r.status='dismissed'; r.dismissedAt = now; } // stamps the 7-day cooldown the client enforces
  });
  await saveGlobal('erp_schools', schools);
  await saveSchoolModuleConfigToFirestore(school);
  renderDevControl();
}

/* ---- TIER 1 — Developer: enter a client school with FULL, unrestricted
   access (every tab, every button — see computeAllowedTabs()), not just
   Settings. This is the "master authority" side of the hierarchy: the
   Developer can do anything the Super Admin can do here, and more,
   completely independent of what's been licensed for that Super Admin. ---- */
let devEditingSchoolId = null;

async function openSchoolSettingsAsDev(schoolId){
  const school = schools.find(s=>s.id===schoolId);
  if(!school){ toast('School not found'); return; }
  ensureSchoolFeatures(school);

  devEditingSchoolId = schoolId;
  currentSchoolId = school.id;
  currentSchool = school;
  // Persist which school the Developer is managing so a refresh can
  // restore this exact context instead of dropping back to the bare
  // Developer Panel with empty in-memory arrays (see initAuth()).
  await saveGlobal('erp_session', { mode:'developer', editingSchoolId: schoolId });

  appUsers = await loadKey('erpUsers', []);
  students = []; vouchers = []; examRecords = []; staff = []; expenses = []; attendance = [];
  await loadAll(); // pulls this school's full scoped data — students, fees, everything

  // Leaving the bare Command Center: restore the normal, per-school
  // sidebar and module shell now that a school context is loaded.
  setDevHomeMode(false);

  document.getElementById('devSettingsBanner').style.display = '';
  document.getElementById('devSettingsSchoolName').textContent = school.name;
  // Prominent, sticky banner visible from EVERY tab (not just Settings)
  // while the Developer is Quick-Inspecting this school — one click
  // gets them straight back to the Dev Dashboard from anywhere.
  document.getElementById('devFloatSchoolName').textContent = school.name;
  document.getElementById('devFloatBanner').classList.add('show');
  // Full access means full access — Backup/Restore and Staff Management
  // stay visible for the Developer, unlike a capped Super Admin view.
  document.getElementById('backupCard').style.display = '';
  document.getElementById('manageUsersCard').style.display = '';

  applyRBAC(); // Tier 1 → every tab in ALL_TABS lights up, ignoring this school's own license
  activateSidebarTab('dashboard');

  renderSettingsPanel();
  if(typeof renderManageUsers==='function') renderManageUsers();
  applyBranding();
  document.getElementById('sessionBadge').textContent = `Managing: ${escapeHtml(school.name)} (Developer Mode)`;
  toast(`Full access granted — now managing ${escapeHtml(school.name)}`);
}

function closeDevSchoolSettings(){
  stopLiveSync();
  devEditingSchoolId = null;
  currentSchoolId = null;
  currentSchool = null;
  settings = defaultSettings();
  students = []; vouchers = []; examRecords = []; staff = []; expenses = []; attendance = []; appUsers = [];
  // Drop the remembered school context so a refresh lands back on the
  // plain Developer Panel instead of re-entering the school we just left.
  saveGlobal('erp_session', { mode:'developer' });

  document.getElementById('devSettingsBanner').style.display = 'none';
  document.getElementById('devFloatBanner').classList.remove('show');
  document.getElementById('backupCard').style.display = '';
  document.getElementById('manageUsersCard').style.display = '';

  setDevHomeMode(true);
  activateSidebarTab('devcontrol');
  document.getElementById('sessionBadge').textContent = 'Anjum Webs POS Engine';

  renderDevControl();
  toast('Returned to Developer Panel');
}
document.getElementById('devSettingsReturnBtn').addEventListener('click', closeDevSchoolSettings);
document.getElementById('devFloatReturnBtn').addEventListener('click', closeDevSchoolSettings);

/* Phase 1: renders the module checkbox block in the "Provision New
   School" form. Called with a package preset (auto-fill) or with no
   argument to reset to all-off. */
function renderNewSchoolModuleBox(presetFlags){
  const box = document.getElementById('dev_newSchoolModuleBox');
  if(!box) return;
