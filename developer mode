/* ============================================================
   MODAL / EXPORT / WHATSAPP HELPERS
   ============================================================ */
let currentWA = null;

/* ============================================================
   PRINT FORMAT SWITCHING — A4 / A5 / 80mm Thermal
   ------------------------------------------------------------
   Every document opened in the shared #printArea modal defaults back
   to A4 (the safest, most universally correct choice for "Save as
   PDF" from a browser). The user can flip to A5 or Thermal from the
   dropdown at any time before hitting Print; applyPrintFormat keeps
   the on-screen preview, the #printArea[data-fmt] CSS rules, and the
   live @page size all in sync so what's previewed is what prints —
   no clipped tables or receipts spilling past the page edge.
   ============================================================ */
const PRINT_PAGE_RULES = {
  a4:      '@page{size:A4;margin:12mm;}',
  a5:      '@page{size:A5;margin:8mm;}',
  thermal: '@page{size:80mm auto;margin:2mm;}',
  // Bulk Fee Voucher sheets are always full A4 pages (2-3 vouchers
  // laid out per page by CSS) — a5/thermal don't apply here, so the
  // format switcher itself is hidden for this one, see applyPrintFormat().
  bulk:    '@page{size:A4;margin:8mm;}'
};
function applyPrintFormat(fmt){
  if(fmt==='thermal' && remoteFeatureLocked('enableThermalPrint')) fmt = 'a4';
  if(!PRINT_PAGE_RULES[fmt]) fmt = 'a4';
  document.getElementById('printArea').dataset.fmt = fmt;
  document.getElementById('dynamicPrintStyle').textContent = PRINT_PAGE_RULES[fmt];
  const sel = document.getElementById('printFormatSelect');
  if(sel && sel.value !== fmt && fmt!=='bulk') sel.value = fmt;
  // The A4/A5/Thermal switcher and single-image download don't make
  // sense against a multi-page, potentially 500-voucher bulk sheet —
  // hide them for that one case only; every other document keeps
  // showing both exactly as before.
  const sizeRow = document.getElementById('printSizeRow');
  if(sizeRow) sizeRow.style.display = fmt==='bulk' ? 'none' : '';
  const dl = document.getElementById('downloadImgBtn');
  if(dl) dl.style.display = fmt==='bulk' ? 'none' : '';
}
function openModal(showWA, wide, fmt){
  document.getElementById('modalBg').classList.add('show');
  document.getElementById('waSendBtn').style.display = showWA ? 'inline-flex' : 'none';
  document.querySelector('#modalBg .modal-box').classList.toggle('wide', !!wide);
  applyPrintFormat(fmt || 'a4'); // every newly opened document starts on the safe A4 default unless told otherwise
}
function closeModal(){ document.getElementById('modalBg').classList.remove('show'); }
document.getElementById('modalBg').addEventListener('click', e=>{
  if(e.target.id==='modalBg') closeModal();
});

document.getElementById('downloadImgBtn').addEventListener('click', ()=>{
  const target = document.getElementById('printArea');
  html2canvas(target, {scale:2, backgroundColor:'#ffffff'}).then(canvas=>{
    const link = document.createElement('a');
