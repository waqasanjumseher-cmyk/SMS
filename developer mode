   ERPCrypto namespace so the file stays a single self-contained module.
   ========================================================================= */

const ERPCrypto = (function () {
  'use strict';

  if (typeof window === 'undefined' || !window.crypto || !window.crypto.subtle) {
    throw new Error('ERPCrypto requires a browser with Web Crypto API (window.crypto.subtle) support.');
  }
  const subtle = window.crypto.subtle;

  /* ---------------------------------------------------------------------
     Internal helpers: encoding
     --------------------------------------------------------------------- */
  const enc = new TextEncoder();
  const dec = new TextDecoder();

  function bytesToBase64(bytes) {
    let binary = '';
    for (let i = 0; i < bytes.length; i++) binary += String.fromCharCode(bytes[i]);
    return btoa(binary);
  }
  function base64ToBytes(b64) {
    const binary = atob(b64);
    const bytes = new Uint8Array(binary.length);
    for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
    return bytes;
  }
  function bytesToHex(bytes) {
    return Array.from(bytes).map(b => b.toString(16).padStart(2, '0')).join('');
  }
  function concatBytes(...arrs) {
    const total = arrs.reduce((n, a) => n + a.length, 0);
    const out = new Uint8Array(total);
    let offset = 0;
    for (const a of arrs) { out.set(a, offset); offset += a.length; }
    return out;
  }

  /* =======================================================================
     1. HASHING — checksums for license keys, auth payloads, integrity
     ======================================================================= */

  const HASH_SALT_BYTES = 16;
  const HASH_PBKDF2_ITERATIONS = 150000; // matches the staff-password standard elsewhere in this ERP

  /**
   * generateHash(data, options)
   * Produces a checksum/hash for sensitive data such as license keys or
   * auth payloads.
   *
   * Default mode ('sha256') is a fast, unsalted SHA-256 hex digest — the
   * right tool for INTEGRITY CHECKS (e.g. "has this license payload been
   * tampered with?"), where you need the same input to always produce the
   * same output so it can be compared/verified quickly.
   *
   * mode: 'pbkdf2' salts + iterates (150,000 rounds), which is the right
   * tool for VERIFYING SECRETS (e.g. a license key or token you don't want
   * brute-forced from a leaked hash). Slower on purpose. Returns a
   * self-describing string: pbkdf2$<iterations>$<saltHex>$<hashHex>
   *
   * @param {string} data
   * @param {{mode?: 'sha256'|'pbkdf2'}} [options]
   * @returns {Promise<string>}
   */
  async function generateHash(data, options = {}) {
    if (typeof data !== 'string') data = JSON.stringify(data);
    const mode = options.mode || 'sha256';

    if (mode === 'sha256') {
      const digest = await subtle.digest('SHA-256', enc.encode(data));
      return bytesToHex(new Uint8Array(digest));
    }

    if (mode === 'pbkdf2') {
      const salt = window.crypto.getRandomValues(new Uint8Array(HASH_SALT_BYTES));
      const saltHex = bytesToHex(salt);
      const hashHex = await pbkdf2Hex(data, salt, HASH_PBKDF2_ITERATIONS);
      return `pbkdf2$${HASH_PBKDF2_ITERATIONS}$${saltHex}$${hashHex}`;
    }

    throw new Error(`generateHash: unknown mode "${mode}"`);
  }

  /**
   * verifyHash(data, storedHash)
   * Counterpart to generateHash. Works for either mode: if storedHash
   * looks like a plain 64-char hex string it's treated as SHA-256; if it
   * matches the pbkdf2$... format it re-derives with the embedded salt/
   * iteration count and does a constant-time-ish compare.
   * @returns {Promise<boolean>}
   */
  async function verifyHash(data, storedHash) {
    if (typeof data !== 'string') data = JSON.stringify(data);
    if (!storedHash) return false;

    if (storedHash.startsWith('pbkdf2$')) {
      const parts = storedHash.split('$');
      if (parts.length !== 4) return false;
      const iterations = parseInt(parts[1], 10);
      const salt = hexToBytes(parts[2]);
      const expectedHex = parts[3];
      const candidateHex = await pbkdf2Hex(data, salt, iterations);
      return timingSafeEqual(candidateHex, expectedHex);
    }

    // Plain SHA-256 hex
    const candidate = await generateHash(data, { mode: 'sha256' });
    return timingSafeEqual(candidate, storedHash);
  }

  async function pbkdf2Hex(text, saltBytes, iterations) {
    const keyMaterial = await subtle.importKey('raw', enc.encode(text), 'PBKDF2', false, ['deriveBits']);
    const bits = await subtle.deriveBits(
      { name: 'PBKDF2', salt: saltBytes, iterations, hash: 'SHA-256' },
      keyMaterial,
      256
    );
    return bytesToHex(new Uint8Array(bits));
  }

  function hexToBytes(hex) {
    const out = new Uint8Array(hex.length / 2);
    for (let i = 0; i < out.length; i++) out[i] = parseInt(hex.substr(i * 2, 2), 16);
    return out;
  }

  function timingSafeEqual(a, b) {
    if (a.length !== b.length) return false;
    let diff = 0;
    for (let i = 0; i < a.length; i++) diff |= a.charCodeAt(i) ^ b.charCodeAt(i);
    return diff === 0;
  }

  /* =======================================================================
     2. AES-256-GCM — symmetric encrypt/decrypt (passphrase-based)
     ======================================================================= */

  const AES_SALT_BYTES = 16;
  const AES_IV_BYTES = 12; // recommended IV length for GCM
  const AES_PBKDF2_ITERATIONS = 150000;

  /**
   * Derives an AES-GCM CryptoKey from a human passphrase using PBKDF2.
   * A fresh random salt is generated per-call by encryptData and shipped
   * alongside the ciphertext so decryptData can re-derive the same key.
   */
  async function deriveAesKey(passphrase, saltBytes) {
    const keyMaterial = await subtle.importKey('raw', enc.encode(passphrase), 'PBKDF2', false, ['deriveKey']);
    return subtle.deriveKey(
      { name: 'PBKDF2', salt: saltBytes, iterations: AES_PBKDF2_ITERATIONS, hash: 'SHA-256' },
      keyMaterial,
      { name: 'AES-GCM', length: 256 },
      false,
      ['encrypt', 'decrypt']
    );
  }

  /**
   * encryptData(plaintext, passphrase)
   * AES-256-GCM encrypts a string (or any JSON-serializable value) with a
   * passphrase. Every call uses a fresh random salt + IV, so encrypting
   * the same data twice produces different output (this is expected and
   * correct — it's what prevents pattern analysis of stored data).
   *
   * Output is a single portable base64 string laying out:
   *   [ salt (16 bytes) | iv (12 bytes) | ciphertext+authTag ]
   *
   * @param {string|object} plaintext
   * @param {string} passphrase
   * @returns {Promise<string>} base64-encoded encrypted payload
   */
  async function encryptData(plaintext, passphrase) {
    if (!passphrase) throw new Error('encryptData: passphrase is required.');
    const data = typeof plaintext === 'string' ? plaintext : JSON.stringify(plaintext);

    const salt = window.crypto.getRandomValues(new Uint8Array(AES_SALT_BYTES));
    const iv = window.crypto.getRandomValues(new Uint8Array(AES_IV_BYTES));
    const key = await deriveAesKey(passphrase, salt);

    const ciphertextBuf = await subtle.encrypt({ name: 'AES-GCM', iv }, key, enc.encode(data));
    const combined = concatBytes(salt, iv, new Uint8Array(ciphertextBuf));
    return bytesToBase64(combined);
  }

  /**
   * decryptData(encryptedString, passphrase)
   * Reverses encryptData(). Throws if the passphrase is wrong or the data
   * was tampered with (GCM's built-in auth tag makes tampering detectable
   * rather than silently returning garbage).
   *
   * @param {string} encryptedString base64 payload from encryptData()
   * @param {string} passphrase
   * @returns {Promise<string>} the original plaintext string
   */
  async function decryptData(encryptedString, passphrase) {
    if (!passphrase) throw new Error('decryptData: passphrase is required.');
    let combined;
    try {
      combined = base64ToBytes(encryptedString);
    } catch (e) {
      throw new Error('decryptData: input is not valid base64 — was this produced by encryptData()?');
    }

    if (combined.length < AES_SALT_BYTES + AES_IV_BYTES + 1) {
      throw new Error('decryptData: payload too short to be valid ciphertext.');
    }

    const salt = combined.slice(0, AES_SALT_BYTES);
    const iv = combined.slice(AES_SALT_BYTES, AES_SALT_BYTES + AES_IV_BYTES);
    const ciphertext = combined.slice(AES_SALT_BYTES + AES_IV_BYTES);

    const key = await deriveAesKey(passphrase, salt);

    try {
      const plainBuf = await subtle.decrypt({ name: 'AES-GCM', iv }, key, ciphertext);
      return dec.decode(plainBuf);
    } catch (e) {
      // GCM auth-tag mismatch: wrong passphrase, or data was corrupted/tampered with.
      throw new Error('decryptData: decryption failed — wrong passphrase or corrupted/tampered data.');
    }
  }

  /* =======================================================================
     3. RSA-OAEP — asymmetric encrypt/decrypt (keypair-based)
     ------------------------------------------------------------------------
     Useful when the encrypting side (e.g. a browser generating a license
     request) should NOT hold the key that can decrypt it — only a server
     or admin holding the private key can. RSA-OAEP has a payload-size
     ceiling (a few hundred bytes depending on key size), so it's meant
     for small payloads: license tokens, symmetric keys, short auth blobs
     — not arbitrary large data (use AES for that).
     ======================================================================= */

  /**
   * generateRsaKeyPair(modulusLength)
   * @param {number} [modulusLength=2048]
   * @returns {Promise<CryptoKeyPair>}
   */
  async function generateRsaKeyPair(modulusLength = 2048) {
    return subtle.generateKey(
      {
        name: 'RSA-OAEP',
        modulusLength,
        publicExponent: new Uint8Array([1, 0, 1]),
        hash: 'SHA-256'
      },
      true, // extractable, so exportRsaKey() can serialize it for storage/transmission
      ['encrypt', 'decrypt']
    );
  }

  /** Exports a CryptoKey to a portable base64 string (SPKI for public, PKCS8 for private). */
  async function exportRsaKey(key) {
    const format = key.type === 'private' ? 'pkcs8' : 'spki';
    const raw = await subtle.exportKey(format, key);
    return bytesToBase64(new Uint8Array(raw));
  }

  /** Imports a base64 key string back into a CryptoKey. type: 'public' | 'private' */
  async function importRsaKey(base64Key, type) {
    const format = type === 'private' ? 'pkcs8' : 'spki';
    const raw = base64ToBytes(base64Key);
    return subtle.importKey(
      format,
      raw,
      { name: 'RSA-OAEP', hash: 'SHA-256' },
      true,
      [type === 'private' ? 'decrypt' : 'encrypt']
    );
  }

  /**
   * rsaEncrypt(publicKey, plaintext) — CryptoKey or base64 SPKI string accepted.
   * @returns {Promise<string>} base64 ciphertext
   */
  async function rsaEncrypt(publicKey, plaintext) {
    const key = typeof publicKey === 'string' ? await importRsaKey(publicKey, 'public') : publicKey;
    const data = typeof plaintext === 'string' ? plaintext : JSON.stringify(plaintext);
    const buf = await subtle.encrypt({ name: 'RSA-OAEP' }, key, enc.encode(data));
    return bytesToBase64(new Uint8Array(buf));
  }

  /**
   * rsaDecrypt(privateKey, ciphertextBase64) — CryptoKey or base64 PKCS8 string accepted.
   * @returns {Promise<string>}
   */
  async function rsaDecrypt(privateKey, ciphertextBase64) {
    const key = typeof privateKey === 'string' ? await importRsaKey(privateKey, 'private') : privateKey;
    const buf = await subtle.decrypt({ name: 'RSA-OAEP' }, key, base64ToBytes(ciphertextBase64));
    return dec.decode(buf);
  }

  /* =======================================================================
     4. SAFE STORAGE WRAPPER — encrypt on write, decrypt on read
     ------------------------------------------------------------------------
     Works with either window.storage (async, used when this ERP runs
     inside the artifact/sandbox host) or localStorage (sync, used for a
     standalone/self-hosted load) — mirroring the existing detection
     pattern already used elsewhere in this file (detectArtifactStorage /
     hasArtifactStorage), so it drops in without fighting that logic.
     Every value is AES-GCM encrypted before it touches either backend and
     transparently decrypted on the way back out.
     ======================================================================= */

  function backendAvailable() {
    return typeof window !== 'undefined' && window.storage
      && typeof window.storage.get === 'function' && typeof window.storage.set === 'function';
  }

  /**
   * secureSetItem(key, value, passphrase, options)
   * Encrypts `value` with `passphrase` and writes it under `key`.
   * @param {string} key
   * @param {*} value        any JSON-serializable value
   * @param {string} passphrase
   * @param {{shared?: boolean}} [options] passed through to window.storage when present
   */
  async function secureSetItem(key, value, passphrase, options = {}) {
    const encrypted = await encryptData(value, passphrase);
    if (backendAvailable()) {
      await window.storage.set(key, encrypted, !!options.shared);
    } else {
      localStorage.setItem(key, encrypted);
    }
  }

  /**
   * secureGetItem(key, passphrase, options)
   * Reads and decrypts the value stored under `key`. Returns null if the
   * key doesn't exist. Throws if the passphrase is wrong.
   * @returns {Promise<*>} the parsed value if it was JSON, otherwise the raw string
   */
  async function secureGetItem(key, passphrase, options = {}) {
    let encrypted = null;
    if (backendAvailable()) {
      try {
        const result = await window.storage.get(key, !!options.shared);
        encrypted = result ? result.value : null;
      } catch (e) {
        encrypted = null; // key not found
      }
    } else {
      encrypted = localStorage.getItem(key);
    }

    if (encrypted === null || encrypted === undefined) return null;

    const decrypted = await decryptData(encrypted, passphrase);
    try {
      return JSON.parse(decrypted);
    } catch (e) {
      return decrypted; // wasn't JSON — return as plain string
    }
  }

  /**
   * secureRemoveItem(key, options)
   */
  async function secureRemoveItem(key, options = {}) {
    if (backendAvailable()) {
      await window.storage.delete(key, !!options.shared);
    } else {
      localStorage.removeItem(key);
    }
  }

  /* =======================================================================
     PUBLIC API
     ======================================================================= */
  return {
    // Requested primary methods
    encryptData,
    decryptData,
    generateHash,

    // Hash verification (companion to generateHash)
    verifyHash,

    // RSA-OAEP asymmetric helpers
    generateRsaKeyPair,
    exportRsaKey,
    importRsaKey,
    rsaEncrypt,
    rsaDecrypt,

    // Safe storage wrapper
    secureSetItem,
    secureGetItem,
    secureRemoveItem
  };
})();

