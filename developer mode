/* ---- Sign in with Google (Developer Console) -----------------------
   Deliberately narrower than the Client file's version: this console
   only ever has ONE legitimate account, so instead of resolving the
   signed-in email against a list of records, it's checked against a
   single allow-listed constant (MASTER_DEVELOPER_EMAIL, above). Any
   other Google account — even a valid school owner/staff email — is
   refused here; that access still only exists on the Client file. --- */
async function signInWithGoogle(){
  const errBox = document.getElementById('loginError');
  errBox.textContent = '';
  const ready = await ensureFirebaseAuthReady();
  if(!ready){ errBox.textContent = 'Google Sign-In isn\'t available — cloud connection isn\'t configured.'; return; }
  try{
    const provider = new firebase.auth.GoogleAuthProvider();
    const result = await firebaseAuth.signInWithPopup(provider);
    const email = ((result.user && result.user.email) || '').toLowerCase();
    if(!email){ errBox.textContent = 'Could not read an email from that Google account.'; await firebaseAuth.signOut(); return; }
    if(MASTER_DEVELOPER_EMAIL && email === MASTER_DEVELOPER_EMAIL.toLowerCase()){
      await startSession(MASTER_USER, null);
      return;
    }
    await firebaseAuth.signOut();
    errBox.textContent = MASTER_DEVELOPER_EMAIL
      ? 'This Google account is not authorized for the Developer Console.'
      : 'Google Sign-In is not configured yet — set MASTER_DEVELOPER_EMAIL in the source.';
  }catch(e){
    if(e && (e.code === 'auth/popup-closed-by-user' || e.code === 'auth/cancelled-popup-request')) return;
    console.error('Google sign-in failed:', e);
    errBox.textContent = 'Google sign-in failed. Please try again.';
  }
}
document.getElementById('googleSignInBtn')?.addEventListener('click', signInWithGoogle);

/* ---- Staff Account Provisioning Engine (School Owner only) --------------
